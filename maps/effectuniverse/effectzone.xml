<?xml version="1.0"?>
<macros xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <macro name="effectzone_macro" class="zone">
    <component ref="standardzone" />
    <properties>
      <boundaries>
        <boundary class="box">
          <position x="-4500000" y="-4500000" z="-4500000" />
          <size x="9000000" y="9000000" z="9000000" />
        </boundary>
      </boundaries>
      <controls>
        <linear>
          <velocity max="1000" />
        </linear>
      </controls>
    </properties>
  </macro>
</macros>