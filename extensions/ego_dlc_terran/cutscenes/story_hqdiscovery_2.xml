<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- Split gate cutscene -->
  <director key="Story_hqdiscovery_2">
    <params>
      <!--Moving capship-->
      <param name="capship" object="true" />

      <!--Camera position-->
      <param name="x" number="true"/>
      <param name="y" number="true"/>
      <param name="z" number="true"/>
    </params>
  </director>

  <!-- Environment in which the scene will take place. -->
  <environments>
    <environment_implicit name="capshipscene" zone="@auto:capship" />
  </environments>

  <presentation>
    <actions>

      <sequence name="FlyToHQ" start="0">
        <shot name="FlyToHQShot" environment="capshipscene" duration="16000">
          <camera>
            <position>
              <value var="x" comment="Capship zone X coordinate" />
              <value var="y" comment="Capship zone Y coordinate" />
              <value var="z" comment="Capship zone Z coordinate" />
            </position>
            <lookdirection>
              <reference x="30" y="30" z="50" object="capship"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

    </actions>
  </presentation>

</cutscene>
