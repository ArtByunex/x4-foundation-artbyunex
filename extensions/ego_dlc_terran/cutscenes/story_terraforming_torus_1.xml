          <camera_orbit reference="target4">
            <begin angle="170" distance="3000" elevation="1000" />
            <end angle="260" distance="35000" elevation="4000" />
          </camera_orbit>
        </shot>

        <shot name="Shot5b" environment="scenezone" duration="4000">
          <camera_orbit reference="target4" interpolation="smooth">
            <begin angle="260" distance="35000" elevation="4000" />
