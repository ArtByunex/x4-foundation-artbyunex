            <end angle="100" distance="500" elevation="-10" />
          </camera_orbit>
        </shot-->

        <shot name="Shot3" environment="scenezone" duration="5000">
          <camera_orbit reference="target2" >
            <begin angle="25" distance="4000" elevation="700" />
            <end angle="160" distance="3000" elevation="0" />
          </camera_orbit>
        </shot>
        <shot name="Shot3b" environment="scenezone" duration="1000">
          <camera_orbit reference="target2" >
            <begin angle="160" distance="3000" elevation="0" />
            <end angle="170" distance="2500" elevation="-100" />
