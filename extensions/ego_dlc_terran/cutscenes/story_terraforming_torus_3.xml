<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

    <!-- This is the key name used to load and reference the scene. -->
    <director key="Story_Terraforming_Torus_3">
      <params>
        <param name="SphereRoom" object="true"/>
      </params>
    </director>

    <!-- The environment is automatically deduced from the reference object. -->
  <environments>
    <environment_implicit name="scene" zone="@auto:SphereRoom" />
  </environments>

  <!-- The scene consists of a single sequence of a single shot. -->
  <presentation>
    <actions>
      <!--first sequence starts at 0 - ends on event-->
      <sequence name="Sequence1" start="0">
        <shot name="Shot1" environment="scene" duration="15000">
          <camera_orbit reference="SphereRoom" x="0.5" y="-1.0" z="0" orient_to="object" cycle="repeat" startangle="0" stopangle="360">
            <begin angle="340" distance="330" elevation="-0.2">
            </begin>
            <end angle="160" distance="350" elevation="-15" time="20000"/>
          </camera_orbit>
        </shot>
      </sequence>

    </actions>
  </presentation>


  
</cutscene>
