  <!-- STORY CHARACTERS -->

  <!-- Brend Sobert -->
  <macro name="character_story_mini_02_courier_macro" class="npc">
    <component ref="character_argon_male_01" />
    <properties>
      <identification name="{30255,101}" race="argon" female="false" />
      <eyepositions lefteye="eye_position_dummy_l" righteye="eye_position_dummy_r">
        <eyeposition type="x" exact="0.0"/>
        <!--vertical "+" is up-->
        <eyeposition type="y" exact="-0.08"/>
        <!--horizontal "+" is wide-->
        <eyeposition type="z" exact="0.0"/>
      </eyepositions>
      <facemods>
        <facemod type="race_cau"                                    exact="1.0" >
          <targets>
            <target name="Ter_m_cau.mt_race_cau"/>
            <target name="Ter_m_beard_cau.mt_race_cau"/>
            <target name="Ter_m_hair_cau.mt_cau"/>
          </targets>
        </facemod>
        <facemod type="age"                                         exact="1.0" >
          <targets>
            <target name="Ter_m_cau.mt_age"/>
            <target name="Ter_m_beard_cau.mt_age"/>
            <target name="Ter_m_hair_cau.mt_age"/>
          </targets>
        </facemod>
        <facemod type="kylo"                                        exact="0.0" >
          <targets>
            <target name="Ter_m_cau.mt_kylo"/>
            <target name="Ter_m_beard_cau.mt_kylo"/>
            <target name="Ter_m_hair_cau.mt_kylo"/>
          </targets>
        </facemod>
        <facemod type="cena"                                        exact="0.0" >
          <targets>
            <target name="Ter_m_cau.mt_cena"/>
            <target name="Ter_m_beard_cau.mt_cena"/>
            <target name="Ter_m_hair_cau.mt_cena"/>
          </targets>
        </facemod>
        <facemod type="cheek_width"                                 exact="-1.0" >
          <targets>
            <target name="Ter_m_cau.mt_cheek_width"/>
            <target name="Ter_m_beard_cau.mt_cheek_width"/>
          </targets>
        </facemod>
        <facemod type="face_depth"                                  exact="0.0" >
          <targets>
            <target name="Ter_m_cau.mt_face_depth"/>
            <target name="Ter_m_beard_cau.mt_face_depth"/>
          </targets>
        </facemod>
        <facemod type="chin_length"                                 exact="0.5" >
          <targets>
            <target name="Ter_m_cau.mt_chin_length"/>
            <target name="Ter_m_beard_cau.mt_chin_length"/>
          </targets>
        </facemod>
        <facemod type="brow_height"                                 exact="0.01" >
          <targets>
            <target name="Ter_m_cau.mt_brow_height"/>
            <target name="Ter_m_beard_cau.mt_brow_height"/>
          </targets>
        </facemod> 
        <facemod type="chin_square"                                 exact="0.5" >
          <targets>
            <target name="Ter_m_cau.mt_chin_square"/>
            <target name="Ter_m_beard_cau.mt_chin_square"/>
          </targets>
        </facemod>
        <facemod type="mouth_pos_vert"                              exact="1.0" >
          <targets>
            <target name="Ter_m_cau.mt_mouth_pos_vert"/>
            <target name="Ter_m_beard_cau.mt_mouth_pos_vert"/>
          </targets>
        </facemod>
        <facemod type="brow_curve"        name="Ter_m_cau.mt_brow_curve"          exact="-1.0"/>
        <facemod type="brow_thickness"    name="Ter_m_cau.mt_brow_thickness"      exact="1.0"/>
        <facemod type="brow_width"        name="Ter_m_cau.mt_brow_width"          exact="-1.0"/>
        <facemod type="brow_height"       name="Ter_m_cau.mt_brow_height"         exact="1.0"/>
        <facemod type="eye_rotation"      name="Ter_m_cau.mt_eye_rotation"        exact="0.0"/>
        <facemod type="eye_squint"        name="Ter_m_cau.mt_eye_squint"          exact="1.0"/>
        <facemod type="lid_angle"         name="Ter_m_cau.mt_lid_angle"           exact="1.0"/>
        <facemod type="eyesocket_squint"  name="Ter_m_cau.mt_eyesocket_squint"    exact="1.0"/>
        <facemod type="eyebags"           name="Ter_m_cau.mt_eyebags"             exact="1.0"/>
        <facemod type="eyesocket_roll"    name="Ter_m_cau.mt_eyesocket_roll"      exact="1.0"/>
        <facemod type="nose_width"        name="Ter_m_cau.mt_nose_width"          exact="-1.0"/>
        <facemod type="nose_size"         name="Ter_m_cau.mt_nose_size"           exact="-0.2"/>
        <facemod type="lip_lower_thick"                                           exact="-1.0">
          <targets>
            <target name="Ter_m_cau.mt_lip_lower_thick"/>
            <target name="Ter_m_beard_cau.mt_lip_lower_thick"/>
          </targets>
        </facemod>
        <facemod type="lip_upper_thick"                                           exact="-1.0">
          <targets>
            <target name="Ter_m_cau.mt_lip_upper_thick"/>
            <target name="Ter_m_beard_cau.mt_lip_upper_thick"/>
          </targets>
        </facemod>
      </facemods>
      <bonemods>
        <bonemod type="Legs" exact="1.0">
          <bones>
            <bone name="Bip01 Pelvis"/>
          </bones>
        </bonemod>
      </bonemods>
      <models>
        <model type="head" ref="assets/characters/argon/heads/char_arg_m_dyn_blend_head" />
        <model type="torso" ref="assets/characters/argon/bodies/char_arg_m_uniform_crew_02" />
        <model type="props" ref="assets/characters/argon/props/Ter_m_hair_cau_white_01" />
      </models>
    </properties>
  </macro>

