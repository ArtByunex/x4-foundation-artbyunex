  <!-- LOANSHARK (Vigor)
        Ice Union (North) - Barbarossa, Kyd
        Scrapyard (West) - Shih, Kyd
        Aurora (South) - Lux, Kyd
        anything not sector-bound such as expansion/compression groups exclusively use Kyd -->
  <!-- Plunderer -->
  <job id="loanshark_plunderer_iceunion" name="{20204,11301}">
    <modifiers commandeerable="true"/>
    <orders>
      <order order="Plunder" default="true">
        <param name="range_internal" value="'sector'"/>
        <param name="plundermode" value="0"/>
      </order>
    </orders>
    <category faction="loanshark" tags="[plunderer, iceunion]" size="ship_l"/>
    <quota galaxy="11"/>
    <location class="sector" macro="Cluster_501_Sector001_macro" faction="loanshark" relation="self" comparison="exact"/>
    <environment buildatshipyard="true"/>
    <basket basket="pirate_container"/>
    <ship>
      <select faction="loanshark" tags="[plunderer]" size="ship_l"/>
      <loadout>
        <quantity exact="1.0"/>
        <quality exact="0.7">
          <variation exact="0.6"/>
        </quality>
      </loadout>
      <owner exact="loanshark" overridenpc="true"/>
    </ship>
  </job>
