<?xml version="1.0" encoding="utf-8"?>
<modules xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../libraries/libraries.xsd">

  <!-- Pirate Welfare Modules -->
  <module id="welfare_pir" group="welfare_pir">
    <category tags="[welfare, module]" faction="[scavenger, loanshark]" />
  </module>

  <!-- Pirate Habitation Modules -->
  <module id="hab_pir" group="hab_pir">
    <category tags="[habitation, module]" faction="[scavenger, loanshark]" />
  </module>

  <module id="stor_condensate" group="stor_condensate">
    <category tags="[storage, module, condensate]" faction="[scavenger]" />
  </module>

  <module id="processing_pir_scrap_with_condensate" group="processing_gen" base="['pir_factory_base_with_condensate_1', 'pir_factory_base_with_condensate_1', 'pir_factory_base_with_condensate_2', 'pir_factory_base_with_condensate_2', 'pir_factory_base_with_condensate_3', 'pir_factory_base_with_condensate_4']">
    <category ware="scrapmetal" tags="[processing, module, condensate]" faction="scavenger" />
    <compatibilities>
      <production ref="recycling_gen" chance="100" respectquota="false"/>
      <production ware="energycells" chance="100" respectquota="false"/>
    </compatibilities>
  </module>

  <module id="processing_pir_scrap_without_condensate" group="processing_gen">
    <category ware="scrapmetal" tags="[processing, module, nocondensate]" faction="scavenger" />
    <compatibilities>
      <production ref="recycling_gen" chance="100" respectquota="false"/>
      <production ware="energycells" chance="100"/>
    </compatibilities>
  </module>

  <module id="prod_pir_energycells_with_condensate" group="prod_gen_energycells" base="['pir_factory_base_with_condensate_1', 'pir_factory_base_with_condensate_1', 'pir_factory_base_with_condensate_2', 'pir_factory_base_with_condensate_2', 'pir_factory_base_with_condensate_3', 'pir_factory_base_with_condensate_4']">
    <category ware="energycells" tags="[production, module, condensate]" faction="scavenger" />
    <compatibilities>
      <production ware="energycells" chance="45" />
    </compatibilities>
  </module>

  <module id="prod_pir_energycells_without_condensate" group="prod_gen_energycells">
    <category ware="energycells" tags="[production, module, nocondensate]" faction="scavenger" />
    <compatibilities>
      <production ware="energycells" chance="45" />
    </compatibilities>
  </module>

  <!--Add new production definitions for the pirates instead of patching their factions to the existing definitions so we have control over compatibilities-->
  <module id="prod_pir_foodrations" group="prod_arg_foodrations">
    <category ware="foodrations" tags="[production, module]" faction="loanshark" />
    <compatibilities>
      <production ware="foodrations" chance="65" />
    </compatibilities>
  </module>

  <module id="prod_pir_meat" group="prod_arg_meat">
    <category ware="meat" tags="[production, module]" faction="loanshark" />
    <compatibilities>
      <production ware="meat" chance="65" />
    </compatibilities>
  </module>

  <module id="prod_pir_medicalsupplies" group="prod_arg_medicalsupplies">
    <!-- need Argon version due to different build method using Wheat -->
    <category ware="medicalsupplies" tags="[production, module]" faction="loanshark" />
    <compatibilities>
      <production ware="medicalsupplies" chance="65" />
    </compatibilities>
  </module>

  <module id="prod_pir_spices" group="prod_gen_spices">
    <category ware="spices" tags="[production, module]" faction="loanshark" />
    <compatibilities>
      <production ware="spices" chance="65" />
    </compatibilities>
  </module>

  <module id="prod_pir_water" group="prod_gen_water">
    <category ware="water" tags="[production, module]" faction="loanshark" />
    <compatibilities>
      <limits production="2"/>
      <maxlimits production="6"/>
      <production ware="water" chance="65" />
    </compatibilities>
  </module>

  <module id="prod_pir_wheat" group="prod_arg_wheat">
    <category ware="wheat" tags="[production, module]" faction="loanshark" />
    <compatibilities>
      <production ware="wheat" chance="65" />
    </compatibilities>
  </module>

  <module id="def_pir" group="def_arg">
    <category tags="[defence, module]" faction="[scavenger, loanshark]" />
  </module>

  <module id="stor_pir" group="stor_arg">
    <category tags="[storage, module]" faction="[scavenger, loanshark]" />
  </module>

  <module id="dockarea_pir" group="dockarea_arg">
    <category tags="[dockarea, module, standard]" faction="[scavenger, loanshark]" />
  </module>

  <module id="pier_base_pir" group="pier_base_arg">
    <category tags="[pier, base, module]" faction="[scavenger, loanshark]" />
  </module>

  <module id="conn_pir" group="conn_arg">
    <category tags="[connection, module]" faction="[scavenger, loanshark]" />
  </module>

</modules>
