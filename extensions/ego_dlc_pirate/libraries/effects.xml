<?xml version="1.0" encoding="utf-8"?>
<effects xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../libraries/effects.xsd">

  <!-- Wave effects, in avarice sector. -->
  <effect name="wave_shield_01_mk1" alignment="object">
    <elements>
      <element id="3" ref="fx_special_waveshield_01_mk1_macro" duration="50.0" minscale="1.0" maxscale="1.0"/>
      <element id="4" ref="impact_light_blue_macro" duration="50.0" minscale="200.0" maxscale="200.0" fadeout="10.0"/>
    </elements>
  </effect>
  <!-- Gets triggered in 7.0s intervals. -->
  <effect name="dmgfx_wave_vis" alignment="object" emitterspace="zone">
    <propagation number="12" duration="7.0" timevariance="0" timefunction="0" directional="true">
      <start x="0" y="0" z="0"></start>
    </propagation>
    <elements>
      <element id="1" ref="dummyemitter_up_macro" forkeffect="dmgfx_electrostatic_sparkles01" duration="7.0" forklod="none" minscale="0.5" maxscale="0.75" basesize="40.0"/>
    </elements>
  </effect>
  <effect name="dmgfx_wave" alignment="object" emitterspace="zone">
    <references>
      <reference effect="dmgfx_wave_vis"/>
    </references>
    <elements>
      <!-- Persistent soft rumble. Sync with the duration of the entire effect, because we don't want it to overlap with the low rumble of the previous/next loop. -->
      <element id="2" ref="effect_dummy_macro" duration="7.0" >
        <force range="1200" falloff="0.50">
          <rumble>
            <camera>
              <component frequency="7" attackduration="0" sustainduration="7.0" releaseduration="0">
                <amplitude randomize="false">
                  <position x="0.002" y="0.002" z="0"/>
                  <rotation yaw="0.065" pitch="0.065" roll="0.065"/>
                </amplitude>
              </component>
            </camera>
          </rumble>
        </force>
      </element>
      <!-- Sound and heavy rumble -->
      <element id="10" ref="effect_dummy_macro" duration="9.0" >
        <sound ref="region_wave_active"></sound>
        <force range="1200" falloff="0.50">
          <rumble>
            <camera>
              <!-- Rumble synced to volume of Tide sound effect. Wind is howling towards the end. File is 7.59s long, effect loop is 7s. Let the rumble release overlap a bit more with the next loop. -->
              <component frequency="8" attackduration="5.0" sustainduration="2.25" releaseduration="1.75">
                <amplitude randomize="false">
                  <position x="0.0030" y="0.0030" z="0"/>
                  <rotation yaw="0.12" pitch="0.12" roll="0.12"/>
                </amplitude>
              </component>
            </camera>
          </rumble>
        </force>
      </element>
    </elements>
  </effect>

