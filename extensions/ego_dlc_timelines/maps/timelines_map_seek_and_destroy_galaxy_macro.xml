  <!-- SECTORS -->
  <!-- SECTORS C11 -->
  <macro name="timelines_map_seek_and_destroy_c11_sector_01_macro" class="sector">
    <component ref="standardsector" connection="cluster"/>
    <properties>
      <identification name="{20004,7730011}" description="{20004,7730012}"/>
    </properties>
    <properties>
      <identification name="{20004,110011}"/>
    </properties>
    <connections>
      <connection name="zones_1" ref="zones">
        <macro ref="timelines_map_seek_and_destroy_c11_s01_zone_01_macro" connection="sector" />
      </connection>
    </connections>
  </macro>
  
  <!-- CLUSTERS -->
  <!-- CLUSTERS C11 Pontifex's Claim -->
  <macro name="timelines_map_seek_and_destroy_cluster_11_macro" class="cluster">
    <component ref="standardcluster" connection="galaxy"/>
    <properties>
      <identification name="{20003,7730001}" description="{20003,7730002}"/>
    </properties>
    <connections>
      <connection name="sectors_1" ref="sectors">
        <macro ref="timelines_map_seek_and_destroy_c11_sector_01_macro" connection="cluster" />
      </connection>
      <connection ref="content">
        <macro>
          <!-- Skybox -->
          <component connection="space" ref="Cluster_11" />
        </macro>
      </connection>
      <connection name="regions_1" ref="regions">
        <macro ref="timelines_map_seek_and_destroy_region_c11_01" connection="cluster"/>
      </connection>
      <connection name="regions_2" ref="regions">
        <macro ref="timelines_map_seek_and_destroy_minefield" connection="cluster"/>
        <offset>
          <!-- -20km from active gate towards inactive gate -->
          <position x="25000.0" y="500" z="5500.0" />
        </offset>
      </connection>
      <connection name="regions_3" ref="regions">
        <macro ref="timelines_map_seek_and_destroy_wreckfield_large" connection="cluster"/>
        <offset>
          <!-- -20km from active gate towards inactive gate -->
          <position x="25000.0" y="500" z="5500.0" />
        </offset>
      </connection>
      <connection name="regions_4" ref="regions">
        <macro ref="timelines_map_seek_and_destroy_wreckfield_small" connection="cluster"/>
        <offset>
          <!-- -35km from active gate towards inactive gate -->
          <position x="10000.0" y="500" z="5500.0" />
        </offset>
      </connection>
      <connection name="audioregions_1" ref="regions">
        <macro ref="timelines_map_seek_and_destroy_audioregion_c11_01" connection="cluster"/>
      </connection>
    </connections>
  </macro>
    
  <!-- GALAXY -->
  <macro name="timelines_map_seek_and_destroy_galaxy_macro" class="galaxy">
    <component ref="standardgalaxy" />
    <connections>
      <connection name="clusters_1" ref="clusters">
        <macro ref="timelines_map_seek_and_destroy_cluster_11_macro" connection="galaxy" />
      </connection>
    </connections>
  </macro>
