      <sequence name="Sequence20" start="onevent:TriggerSequence20Start">
        <shot name="PanOutCameraShot20" environment="scenezone" duration="onevent:TriggerSequence20Done">
          <camera_orbit reference="target_Sae_Actor" orient_to="ecliptic" y="0.65" >
            <begin angle="92">
              <distance>
                <value exact="0.8"/>
              </distance>
            </begin>
            <end angle="92" time="18800">
              <distance>
