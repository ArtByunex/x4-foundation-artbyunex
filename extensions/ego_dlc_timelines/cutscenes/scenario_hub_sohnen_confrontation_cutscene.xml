      </sequence>

      <!-- Shot 18: Medium of Player Character steps forward, addresses Sohnen, both Player and Sohnen in frame (Side Profile) -->
      <sequence name="Sequence18" start="onevent:TriggerSequence18Start">
        <shot name="PanOutCameraShot18" environment="scenezone" duration="onevent:TriggerSequence18Done">
          <camera>
            <position>
              <keyframes>
                <keyframe timestamp="0" interpolation="linear">
                  <reference x="-3.354134" y="3.997711" z="10.606762" object="sohnenroom"/>
