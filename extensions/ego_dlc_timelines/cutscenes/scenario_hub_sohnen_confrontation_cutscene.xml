      <!-- Shot 10: Back to Sohnen closeup, quickly -->
      <sequence name="Sequence10" start="onevent:TriggerSequence10Start">
        <shot name="PanOutCameraShot10" environment="scenezone" duration="onevent:TriggerSequence10Done">
          <camera_orbit reference="target_SohDummy_Actor" orient_to="ecliptic" y="0">
