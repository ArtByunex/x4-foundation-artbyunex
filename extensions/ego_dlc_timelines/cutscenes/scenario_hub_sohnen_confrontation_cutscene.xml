<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- Story Criminal Briefing Cutscene -->
  <director key="scenario_hub_sohnen_confrontation_cutscene">
    <params>
      <param name="target_MD_Actor" object="true" />
      <param name="target_Mitsuno_Actor" object="true" />
      <param name="target_Pa_Actor" object="true" />
      <param name="target_Sae_Actor" object="true" />
      <param name="target_SohDummy_Actor" object="true" />
      <param name="target_Player" object="true" />
      <param name="cloneroom" object="true" />
      <param name="sohnenroom" object="true" />
    </params>
  </director>

  <!-- Environment in which the scene will take place. -->
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_MD_Actor" />
    <object_group name="target_group">
      <reference object="target_MD_Actor" />
      <reference object="target_Mitsuno_Actor" />
      <reference object="target_Pa_Actor" />
      <reference object="target_Sae_Actor" />
      <reference object="target_SohDummy_Actor" />
      <reference object="target_Player" />
    </object_group>
  </environments>

  <presentation>
    <actions>

      <!-- Shot 1: Establishing Shot of the room -->
      <sequence name="Sequence1" start="0">
        <shot name="StaticCameraShot1" environment="scenezone" duration="onevent:TriggerSequence1Done">
          <camera_orbit reference="target_SohDummy_Actor" orient_to="ecliptic" cycle="none" z="0" y="0">
            <begin angle="80">
              <distance>
                <value exact="15"/>
              </distance>
              <elevation>
                <value exact="-4.5"/>
              </elevation>
            </begin>
            <end angle="100" time="8000">
              <distance>
                <value exact="15"/>
              </distance>
              <elevation>
                <value exact="-4.5"/>
              </elevation>
            </end>
          </camera_orbit>

        </shot>
      </sequence>

      <!-- Shot 2: Wide from Domo looking at the Group arriving -->
      <sequence name="Sequence2" start="onevent:TriggerSequence2Start">
        <shot name="PanAwayShot2" environment="scenezone" duration="onevent:TriggerSequence2Done">
          <camera>
            <position>
              <reference object="target_MD_Actor" x="1.2" y="1.6" z="-1"/>
            </position>
            <lookdirection>
              <reference object="target_MD_Actor" x="-0.7" y="1.93" z="2.2" />
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <!-- Shot 3: Looking at the Sohnen as it talks -->
      <sequence name="Sequence3" start="onevent:TriggerSequence3Start">
        <shot name="StaticCameraShot3" environment="scenezone" duration="onevent:TriggerSequence3Done">
          <camera_orbit reference="target_SohDummy_Actor" orient_to="ecliptic" y="0">
            <begin angle="90">
              <distance>
                <value exact="6.4"/>
              </distance>
            </begin>
            <end angle="90" time="8200">
              <distance>
                <value exact="6.1"/>
              </distance>
            </end>
          </camera_orbit>
        </shot>
      </sequence>

      <!-- Shot 4: Medium Wide, Looking at Mitsuno as she approaches, holding gun -->
      <sequence name="Sequence4" start="onevent:TriggerSequence4Start">
        <shot name="PanTowardsShot4" environment="scenezone" duration="onevent:TriggerSequence4Done">
          <camera>
            <position>
              <reference object="target_Mitsuno_Actor" x="0" y="1.9" z="2"/>
            </position>
            <lookdirection>
              <reference object="target_Mitsuno_Actor" x="0" y="1.2" z="0"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <!-- Shot 5: Wide, Looking at group as they ask questions to Sohnen -->
      <sequence name="Sequence5" start="onevent:TriggerSequence5Start">
        <shot name="PanTowardsShot5" environment="scenezone" duration="onevent:TriggerSequence5Done">
          <camera_orbit reference="target_Mitsuno_Actor" orient_to="ecliptic" y="-0.1" z="-2.1" x="-0.3">
            <begin angle="210">
              <distance>
                <value exact="2.8"/>
              </distance>
              <elevation>
                <value exact="-0.9"/>
              </elevation>
            </begin>
            <end angle="230" time="42800">
              <distance>
                <value exact="2.8"/>
              </distance>
              <elevation>
                <value exact="-0.9"/>
