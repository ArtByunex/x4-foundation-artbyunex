<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <director key="Scenario_Timelines_Epilogue_Kaori_Boso_Meeting_Cutscene">
    <params>
      <param name="target_Boso" object="true"/>
      <param name="target_Station" object="true"/>
      <param name="target_Room" object="true"/>
      <param name="target_Kaori" object="true"/>
      <param name="target_Player" object="true"/>
    </params>
  </director>

  <!-- Environment in which the scene will take place. -->
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_Kaori" />
    <object_group name="target_group">
      <reference object="target_Boso" />
      <reference object="target_Station" />
      <reference object="target_Room" />
      <reference object="target_Kaori" />
      <reference object="target_Player" />
    </object_group>
  </environments>

  <presentation>
    <actions>

      <!-- Show Boso 
      Show Kaori and Boso
      Show Kaori walk to window
      Show Asteroid from inside Window
      Show Boso (Kaori gets her PDA out)
      Kaori tapping on PDA at window
      Asteroid (again inside window? Effect playing?)
      Kaori moving back to player and Boso
      Kaori in close up -->
      <sequence name="Sequence1" start="0" endevent="onevent:TriggerSequence02Start">
        <shot name="OvershoulderShot01" environment="scenezone" duration="onevent:TriggerSequence01Done">
          <camera>
            <position>
              <reference object="target_Boso" x="0" y="0.6" z="5.1"/>
            </position>
            <lookdirection>
              <reference object="target_Boso" x="0" y="1.4" z="0"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <sequence name="Sequence2" start="onevent:TriggerSequence02Start" endevent="onevent:TriggerSequence03Start">
        <shot name="WideShot02" environment="scenezone" duration="18000">
          <camera>
            <position>
              <reference object="target_Room" x="-2.4" y="2.42" z="-7.05"/>
            </position>
            <lookdirection>
              <reference object="target_Kaori" x="-0.5" y="1.4" z="0.5"/>
            </lookdirection>
          </camera>
        </shot>
        <shot name="WideShot03" environment="scenezone" duration="onevent:TriggerSequence02Done">
          <camera>
            <position>
              <reference object="target_Room" x="3.28" y="2.26" z="-10.48"/>
            </position>
            <lookdirection>
              <reference object="target_Room" x="1.12" y="1.19" z="-5.59"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <sequence name="Sequence3" start="onevent:TriggerSequence03Start" endevent="onevent:TriggerSequence04Start">
        <shot name="ShowingAsteroirShot04" environment="scenezone" duration="onevent:TriggerSequence03Done">
          <camera>
            <position>
              <reference object="target_Room" x="0.96" y="1.16" z="-8.9"/>
            </position>
            <lookdirection>
              <reference object="target_Room" x="1.67" y="2.84" z="-17.96"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <sequence name="Sequence4" start="onevent:TriggerSequence04Start" endevent="onevent:TriggerSequence05Start">
        <shot name="ShowBosoShot5" environment="scenezone" duration="onevent:TriggerSequence04Done">
          <camera>
            <position>
              <reference object="target_Boso" x="-0.3" y="1.1" z="3.1"/>
            </position>
            <lookdirection>
              <reference object="target_Boso" x="0" y="1.3" z="0"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <sequence name="Sequence5" start="onevent:TriggerSequence05Start" endevent="onevent:TriggerSequence06Start">
        <shot name="WideShot06" environment="scenezone" duration="6000">
          <camera>
            <position>
              <reference object="target_Room" x="-0.03" y="1.61" z="-12.28"/>
            </position>
            <lookdirection>
              <reference object="target_Room" x="1.76" y="1.54" z="-8.15"/>
            </lookdirection>
          </camera>
        </shot>
        <shot name="ShowingAsteroirShot07" environment="scenezone" duration="onevent:TriggerSequence05Done">
          <camera>
            <position>
              <reference object="target_Room" x="0.96" y="1.16" z="-8.9"/>
            </position>
            <lookdirection>
              <reference object="target_Room" x="1.67" y="2.84" z="-17.96"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <sequence name="Sequence6" start="onevent:TriggerSequence06Start" endevent="onevent:TriggerSequence07Start">
        <shot name="TrackingKaoriShot08" environment="scenezone" duration="onevent:TriggerSequence06Done">
          <camera>
            <position>
              <reference object="target_Room" x="-2.32" y="2.38" z="-6.8"/>
            </position>
            <lookdirection>
              <reference object="target_Kaori" x="0" y="1.4" z="0"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <sequence name="Sequence7" start="onevent:TriggerSequence07Start" endevent="onevent:TriggerSequence08Start">
        <shot name="CloseUpKaoriShot09" environment="scenezone" duration="6000">
          <camera>
            <position>
              <reference object="target_Kaori" x="0" y="1.5" z="1.2"/>
            </position>
            <lookdirection>
              <reference object="target_Kaori" x="0" y="1.6" z="-1"/>
            </lookdirection>
          </camera>
        </shot>
        <shot name="TrackingKaoriShot09" environment="scenezone" duration="onevent:TriggerSequence07Done">
          <camera>
            <position>
              <reference object="target_Room" x="-2.32" y="2.38" z="-6.8"/>
            </position>
            <lookdirection>
              <reference object="target_Room" x="1.16" y="1.4" z="-3.47"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>
    </actions>
  </presentation>

</cutscene>