<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- Story Criminal Briefing Cutscene -->
  <director key="scenario_hub_mitsunoplanning_cutscene">
    <params>
      <param name="target_Mitsuno_Actor" object="true" />
      <param name="target_Sae_Actor" object="true" />
      <param name="target_Pa_Actor" object="true" />
      <param name="target_Player" object="true" />
      <param name="hideoutroom" object="true" />
    </params>
  </director>

  <!-- Environment in which the scene will take place. -->
  <environments>
    <environment_implicit name="scenezone" zone="@auto:hideoutroom" />
    <object_group name="target_group">
      <reference object="target_Mitsuno_Actor" />
      <reference object="target_Sae_Actor" />
      <reference object="target_Pa_Actor" />
      <reference object="target_Player" />
      <reference object="hideoutroom" />
    </object_group>
  </environments>

  <presentation>
    <actions>

      <sequence name="Sequence1" start="0">
        <shot name="StaticCameraShot1" environment="scenezone" duration="onevent:TriggerSequence1Done">
          <camera>
            <position>
              <reference object="hideoutroom" x="-0.8" y="1.7" z="0.4"/>
            </position>
            <lookdirection>
              <reference object="target_Mitsuno_Actor" y="1.6"/>
            </lookdirection>
            <panloop time="10" pitch="0.01" />
          </camera>
        </shot>
      </sequence>

      <sequence name="Sequence2" start="onevent:TriggerSequence2Start">
        <shot name="StaticCameraShot2" environment="scenezone" duration="onevent:TriggerSequence2Done">
          <camera>
            <position>
              <reference object="hideoutroom" x="0.11" y="1.7" z="2.86"/>
            </position>
            <lookdirection>
              <reference object="target_Player" head="true" y="0"/>
            </lookdirection>
            <panloop time="10" pitch="0.01" />
          </camera>
          <light name="cutscene_light_macro">
            <position>
              <reference object="target_Player" head="1" x="0.0" y="0" z="0.0" comment="copied from player camera"/>
            </position>
          </light>
        </shot>
      </sequence>

      <sequence name="Sequence3" start="onevent:TriggerSequence3Start">
        <shot name="StaticCameraShot3" environment="scenezone" duration="onevent:TriggerSequence3Done">
          <camera>
            <position>
              <reference object="hideoutroom" x="0.3" y="1.7" z="-1.2"/>
            </position>
            <lookdirection>
              <reference object="target_Pa_Actor" y="1.6"/>
            </lookdirection>
          </camera>
          <light name="cutscene_light_macro">
            <position>
              <reference object="target_Pa_Actor" head="1" x="0.2" y="-0.1" z="0.2" comment="copied from player camera"/>
            </position>
          </light>
        </shot>
      </sequence>

      <sequence name="Sequence4" start="onevent:TriggerSequence4Start">
        <shot name="StaticCameraShot4" environment="scenezone" duration="onevent:TriggerSequence4Done">
          <camera>
            <position>
              <reference object="hideoutroom" x="0.3" y="1.7" z="-2.2"/>
            </position>
            <lookdirection>
              <reference object="target_Mitsuno_Actor" y="1.6"/>
            </lookdirection>
            <panloop time="10" pitch="0.01" />
          </camera>
        </shot>
      </sequence>

      <sequence name="Sequence5" start="onevent:TriggerSequence5Start">
        <shot name="StaticCameraShot5" environment="scenezone" duration="onevent:TriggerSequence5Done">
          <camera>
            <position>
              <reference object="hideoutroom" x="0.19" y="1.7" z="3.02"/>
            </position>
            <lookdirection>
              <reference object="target_Player" head="true" y="0"/>
            </lookdirection>
          </camera>
          <light name="cutscene_light_macro">
            <position>
              <reference object="target_Player" head="1" x="0.0" y="0" z="0.0" comment="copied from player camera"/>
            </position>
          </light>
        </shot>
      </sequence>

    </actions>
  </presentation>

</cutscene>
