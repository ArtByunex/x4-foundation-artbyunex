<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <director key="scenario_assassinate_intro_cutscene" />
  <!--
  Shot 1:
  -->

  <!-- Environment in which the scene will take place. -->
  <environments>
    <environment_implicit name="scenezone_NPC_ship" zone="@auto:target_NPC_ship" />
    <object_group name="target_group">
      <reference object="target_NPC" />
      <reference object="target_NPC_ship" />
      <reference object="target_police" />
      <reference object="target_player" />
      <reference object="target_playership" />
    </object_group>
  </environments>

  <presentation>
    <actions>
      <sequence name="Sequence01" start="0">
        <shot name="OrbitPlayerShip" environment="scenezone_NPC_ship" duration="10000">
          <camera_orbit reference="target_playership" orient_to="object" cycle="none">
            <begin distance="180" angle="100" elevation="60"/>
            <end distance="180" angle="190" time="11500" elevation="68"/>
          </camera_orbit>
        </shot>
        <shot name="ShowNPC" environment="scenezone_NPC_ship" duration="4500">
          <camera>
            <position>
              <reference object="target_NPC" x="0" y="1.8" z="1.3"/>
            </position>
            <lookdirection>
              <reference object="target_NPC" x="-0" y="1.75" z="0" />
            </lookdirection>
          </camera>
        </shot>
        <shot name="OrbitTargetShip" environment="scenezone_NPC_ship" duration="4500">
          <camera_orbit reference="target_NPC_ship" orient_to="object" cycle="none" >
            <begin distance="150" angle="80" elevation="30"/>
            <end distance="150" angle="100" time="3500" elevation="30"/>
          </camera_orbit>
        </shot>
        <shot name="ShowGuns" environment="scenezone_NPC_ship" duration="3000">
          <camera>
            <position>
              <reference object="target_playership" x="-6.77" y="-0.97" z="16.63"/>
            </position>
            <lookdirection>
              <reference object="target_playership" x="-2.87" y="-0.911" z="9.07" />
            </lookdirection>
          </camera>
        </shot>
        <shot name="ShowCockpit" environment="scenezone_NPC_ship" duration="3000">
          <camera>
            <position>
              <reference object="target_player" x="0" y="0.2" z="1.35"/>
            </position>
            <lookdirection>
              <reference object="target_player" x="0" z="0" y="0.5" head="true" />
            </lookdirection>
          </camera>
        </shot>
        <shot name="FlyFrom_Ship_To_Police" environment="scenezone_NPC_ship" duration="13000">
          <!--duration="onevent:stopscene" evaluates to -1 so does not work with a non-static camera / a camera using keyframes, we *need* to know the duration beforehand-->
          <!--Don't use 'delay' with camera_flyfromto, because that is added to the duration, which then accepts invalid timestamps (beyond the keyframe maxtime), it can't find the keyframe out of the range (null) and then it crashes.-->
          <camera_flyfromto reference="target_playership" distance="200" flyto_reference="target_police" flyto_distance="220" interpolation="smooth" time_firstobject="2500" time_fly="5500" cycle="none"
                            orbit1_yaw_start="-99" orbit1_yaw_end="-80" orbit1_elevation="0"
                            orbit2_yaw_start="-99" orbit2_yaw_end="-80" orbit2_pitch="10"/>

        </shot>
        <shot name="OrbitPlayerShipAgain" environment="scenezone_NPC_ship" duration="6000">
          <camera_orbit reference="target_NPC_ship" orient_to="object" cycle="none" >
            <begin distance="200" angle="100" elevation="30"/>
            <end distance="200" angle="190" time="4500" elevation="38"/>
          </camera_orbit>
        </shot>
        
      </sequence>

    </actions>
  </presentation>

</cutscene>
