<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- Story Criminal Briefing Cutscene -->
  <director key="scenario_hub_kaori_introduction_cutscene">
    <params>
      <param name="target_MD_Actor" object="true" />
      <param name="target_Kaori_Actor" object="true" />
      <param name="target_Lissa_Actor" object="true" />
      <param name="target_Tammancktall_Actor" object="true" />
      <param name="target_Player" object="true" />
      <param name="missioncenter" object="true" />
    </params>
  </director>

  <!-- Environment in which the scene will take place. -->
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_MD_Actor" />
    <object_group name="target_group">
      <reference object="target_MD_Actor" />
      <reference object="target_Kaori_Actor" />
      <reference object="target_Lissa_Actor" />
      <reference object="target_Tammancktall_Actor" />
      <reference object="target_Player" />
      <reference object="missioncenter" />
    </object_group>
  </environments>

  <presentation>
    <actions>

      <!-- Shot 1: Establish Kaori on the stretcher -->
      <sequence name="Sequence1" start="0">
        <shot name="StaticCameraShot1" environment="scenezone" duration="onevent:TriggerSequence1Done">
          <camera>
            <position>
              <reference object="missioncenter" x="19.82" y="4.65" z="13.3"/>
            </position>
            <lookdirection>
              <reference object="missioncenter" x="19.81" y="2.42" z="13.2"/>
            </lookdirection>
            <roll>
              <value exact="100"/>
            </roll>
          </camera>
        </shot>
      </sequence>

      <!-- Shot 2: Wide of the group surrounding Kaori -->
      <sequence name="Sequence2" start="onevent:TriggerSequence2Start">
        <shot name="StaticCameraShot2" environment="scenezone" duration="onevent:TriggerSequence2Done">
          <camera>
            <position>
              <reference object="missioncenter" x="23.29" y="3.74" z="16.67"/>
            </position>
            <lookdirection>
              <reference object="missioncenter" x="20.08" y="2.91" z="14.65"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <!-- Shot 3: Looking at MD and Tamm -->
      <sequence name="Sequence3" start="onevent:TriggerSequence3Start">
        <shot name="StaticCameraShot3" environment="scenezone" duration="onevent:TriggerSequence3Done">
          <camera_orbit reference="target_Tammancktall_Actor" orient_to="ecliptic" cycle="none" x="0.2" y="0.7">
            <begin distance="1.2" angle="90"/>
            <end distance="1.5" angle="90" time="9000"/>
          </camera_orbit>
        </shot>
      </sequence>
      
      <sequence name="Sequence4" start="onevent:TriggerSequence4Start">
        <shot name="StaticCameraShot4" environment="scenezone" duration="onevent:TriggerSequence4Done">
          <camera>
            <position>
              <reference object="target_Kaori_Actor" x="0" y="1.6" z="1.3"/>
            </position>
            <lookdirection>
              <reference object="target_Kaori_Actor" x="0" y="1.6" z="0"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>
      
      <sequence name="Sequence5" start="onevent:TriggerSequence5Start">
        <shot name="StaticCameraShot5" environment="scenezone" duration="onevent:TriggerSequence5Done">
          <camera>
            <position>
              <reference object="missioncenter" x="20.99" y="2.77" z="17.09"/>
            </position>
            <lookdirection>
              <reference object="missioncenter" x="19.99" y="3.18" z="14.80"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>
      
      <sequence name="Sequence6" start="onevent:TriggerSequence6Start">
        <shot name="StaticCameraShot6" environment="scenezone" duration="onevent:TriggerSequence6Done">
          <camera>
            <position>
              <reference object="target_Lissa_Actor" x="0" y="1.6" z="1.2"/>
            </position>
            <lookdirection>
              <reference object="target_Lissa_Actor" x="0" y="1.6" z="0"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>
      
      <sequence name="Sequence7" start="onevent:TriggerSequence7Start">
        <shot name="StaticCameraShot7" environment="scenezone" duration="onevent:TriggerSequence7Done">
          <camera>
            <position>
              <reference object="target_Kaori_Actor" x="0" y="1.6" z="1.3"/>
            </position>
            <lookdirection>
              <reference object="target_Kaori_Actor" x="0" y="1.6" z="0"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>
      
      <sequence name="Sequence8" start="onevent:TriggerSequence8Start">
        <shot name="StaticCameraShot8" environment="scenezone" duration="onevent:TriggerSequence8Done">
          <camera_orbit reference="target_Tammancktall_Actor" orient_to="ecliptic" cycle="none" x="0.2" y="0.7">
            <begin distance="1.8" angle="90"/>
            <end distance="0.9" angle="90" time="15000"/>
          </camera_orbit>
        </shot>
      </sequence>
      
      <sequence name="Sequence9" start="onevent:TriggerSequence9Start">
        <shot name="StaticCameraShot9" environment="scenezone" duration="onevent:TriggerSequence9Done">
          <camera>
            <position>
              <reference object="missioncenter" x="20.99" y="2.77" z="17.09"/>
            </position>
            <lookdirection>
              <reference object="missioncenter" x="19.99" y="3.18" z="14.80"/>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

    </actions>
  </presentation>

</cutscene>
