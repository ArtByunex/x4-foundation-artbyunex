<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Scenario_Spacesuit_3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <documentation>
    <author name="Matthias Haan"/>
  </documentation>
  <cues>

    <cue name="Start" namespace="this" module="scenario_spacesuit_3">
      <conditions>
        <event_cue_signalled cue="md.Setup.GameStart" />
      </conditions>
      <actions>
        <include_actions ref="md.LIB_Scenario.ScenarioStarted"/>

        <!--========================================================
            Set some of the commonly used variables
            ============================================================-->

        <set_value name="$DebugChance"        exact="100"/>
        <set_value name="$MissionCue"         exact="namespace"/>

        <set_value name="$Page"               exact="0"/>
        <set_value name="$Difficulty"         exact="if event.param.$Difficulty? then event.param.$Difficulty else level.medium"/>
        <set_value name="$MissionType"        exact="missiontype.deliver"/>
        <set_value name="$MissionFaction"     exact="faction.civilian"/>

        <set_value name="$MissionActors"     exact="table[]"/>

        <set_value name="$HasError"           exact="false" comment="will be set true if any setup fails"/>

        <debug_text text="'Initialising Scenario:' + $Page" chance="$DebugChance"/>

        <!--========================================================
            Universe Flags
            ============================================================-->

        <!--$DisableAutoInitialisation prevents the InitUniverse script interfering with map objects. All map ships/stations will not have any entities such as engineers. Map stations will not have random amounts of wares/workforce
        Commented out as default but feel free to disable it if required by your scenario-->
        <!--<set_value name="md.InitUniverse.Start.$DisableAutoInitialisation" exact="true"/>-->

        <!--This disables the spawning of generic missions-->
        <set_value name="md.GenericMissions.Manager.$Disabled" exact="true"/>
        <set_external_view_allowed allow="false"/>

        <!--========================================================
            Custom scenario-specific variables go here
            ============================================================-->

        <set_value name="$PlayerSpawnZone" exact="player.zone"/>
        <set_value name="$PlayerSpawnPos" exact="player.ship.relativeposition.{$PlayerSpawnZone}"/>

        <set_value name="$TimeBonusPerSecond" exact="50"/>
        <set_value name="$TimeBonusThreshold" exact="4min"/>

        <find_object name="$Level" macro="macro.landmarks_gen_spacesuit_level_01_biathloncourse_01_macro" space="player.sector" required="true"/>

        <find_object_component groupname="$Displays" macro="macro.scs_gen_prop_textdisplay_02_macro" object="$Level" multiple="true" recursive="true"/>
        <debug_text text="'Found displays: ' + $Displays.count"/>

        <find_object_component object="$Level" name="$hatches" macro="macro.scs_gen_destructible_hatch_16_01_macro" multiple="true" recursive="true"/>
        <do_for_each name="$hatch" in="$hatches">
          <set_object_min_hull object="$hatch" exact="100"/>
        </do_for_each>

        <!-- Positions are relative to the station -->
        <set_value name="$Checkpoints" exact="[position.[176m, 0m, 80m], position.[0m, 0m, 80m], position.[0m, 0m, 40m], position.[0m, 0m, 0m], position.[176m, 0m, 0m]]"/>
        <set_value name="$CurrentCheckpoint" exact="1"/>
        <set_value name="$ShootingStartCheckpoint" exact="3"/>
        <set_value name="$ShootingEndCheckpoint" exact="4"/>
        <set_value name="$CurrentCheckpointPos" exact="$Checkpoints.{$CurrentCheckpoint}"/>
        <set_value name="$CheckDelta" exact="32m"/>
        <set_value name="$CurrentLap" exact="1"/>
        <set_value name="$NumLaps" exact="3"/>
        <set_value name="$TargetPenalty" exact="250"/>
        <set_value name="$ShotPenalty" exact="100"/>
        <set_value name="$MissedTargets" exact="0"/>

        <create_list name="$LapTargets" exact="$NumLaps"/>
        <create_list name="$LapTargetCount" exact="$NumLaps"/>
        <find_object_component groupname="$LapTargets.{1}" macro="macro.scs_gen_destructible_shoottarget_01_macro" object="$Level" multiple="true" grouptag="tag.shoottargets_01"/>
        <find_object_component groupname="$LapTargets.{2}" macro="macro.scs_gen_destructible_shoottarget_01_macro" object="$Level" multiple="true" grouptag="tag.shoottargets_02"/>
        <find_object_component groupname="$LapTargets.{3}" macro="macro.scs_gen_destructible_shoottarget_01_macro" object="$Level" multiple="true" grouptag="tag.shoottargets_03"/>
        <do_all counter="$i" exact="$NumLaps">
          <add_to_group groupname="$AllTargets" group="$LapTargets.{$i}"/>
          <set_value name="$LapTargetCount.{$i}" exact="$LapTargets.{$i}.count"/>
          <do_if value="$i != $CurrentLap">
            <do_for_each name="$target" in="$LapTargets.{$i}">
              <set_object_hidden object="$target" hidden="true"/>
              <set_known object="$target" known="true"/>
            </do_for_each>
          </do_if>
        </do_all>

        <set_value name="$PlayerWeapon" exact="player.controlled.weapons.operational.list.{1}"/>
        <set_value name="$HitTargets" exact="0"/>
        <set_value name="$MissedTargets" exact="0"/>
        <set_value name="$MissedShots" exact="0"/>
      </actions>
      <cues>

        <cue name="StopUseCase"/>

        <cue name="Setup_Scenario">
          <cues>

            <cue name="Call_Setup_Libraries">
              <actions>
                <include_actions ref="md.Scenario_Spacesuit_LIB.Setup_Player" chance="if $HasError then 0 else 100"/>
                <include_actions ref="md.Scenario_Spacesuit_LIB.Setup_Chief" chance="if $HasError then 0 else 100"/>

                <!--If there was an error, signal the CleanUp cue, otherwise signal the scenario to start-->
                <do_if value="$HasError">
                  <quit_to_game game="'x4ep1_gamestart_hub'"/>
                </do_if>
                <do_else>
                  <debug_text text="'Scenario has been successfully set up and can start'" chance="$DebugChance"/>
                  <signal_cue cue="IntroCutscene"/>
                </do_else>
              </actions>
            </cue>

          </cues>
        </cue>

        <cue name="IntroCutscene">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="$CutsceneActors" exact="table[]"/>
            <set_value name="$CutsceneActors.$Chief" exact="table[ $entity = $Chief ]"/>
            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
              $caller = this, $preset = '$plotlike', $actors = $CutsceneActors, $debugchance = 0,
              $script = [
                          table [$actor = '$Chief', $speak = 306140401, $recipient = 'player', $comment = 'Welcome... to the third annual Scoot-n-Shoot Tournament!'],
                          table [$actor = '$Chief', $speak = 306140402, $recipient = 'player', $comment = 'Sponsored by Swamp Fizz, the refreshing burst of energy to get you through your day.'],
                        ],
              $callbackcue = StopCutscene,
              $abortcallbackcue = StopCutscene,
              $abortonsignalledcue = StopUseCase
            ]" />
            <play_cutscene cinematicmode="true" result="$IntroCutscene" key="'scenario_spacesuit_3_intro_cutscene'">
              <param name="level" object="$Level"/>
            </play_cutscene>
          </actions>
          <cues>
            <cue name="StopCutscene">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <delay exact="1s"/>
              <actions>
                <stop_cutscene cutscene="$IntroCutscene"/>
              </actions>
            </cue>

            <cue name="CutsceneStopped">
              <conditions>
                <event_cutscene_stopped cutscene="$IntroCutscene"/>
              </conditions>
              <actions>
                <cancel_cue cue="IntroCutscene"/>
                <signal_cue cue="StopUseCase" check="false"/>
                <signal_cue cue="Start_Scenario"/>
              </actions>
            </cue>
          </cues>
        </cue>

        <!--****StartScenario****
        This cue is signalled if the setup cue hasn't found any issues and the scenario can now start
        This cue and following subcues will manage the presentation, objects, AI and mission objectives
        The mission itself does not have to be created until later (see create_mission)-->

        <cue name="Start_Scenario">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <muffle_sound strength="0" duration="0s"/>
            <blur_screen strength="0" duration="0s"/>
          </actions>
          <cues>
            <!-- The cues that make up the scenario will go here -->

            <cue name="SetupMission">
              <actions>
                <!-- Mission Objective -->
                <create_mission cue="$MissionCue" abortable="false" name="{30614,3001}" description="{30614,3004}"
                                icon="'briefing_mission_director_01'" iconcaption="{30293,102}"
                                difficulty="$Difficulty" type="$MissionType" faction="$MissionFaction">
                  <briefing>
                    <objective step="1" action="objective.race"/>
                    <objective step="2" action="objective.destroy" group="$LapTargets.{$CurrentLap}"/>
                  </briefing>
                </create_mission>
                <set_objective_from_briefing cue="$MissionCue" step="1"/>
              </actions>
            </cue>

            <cue name="DisplayStartText">
              <actions>
                <show_help custom="'{30614,10001}'" position="1" force="true" timeout="false"/>
              </actions>
            </cue>

            <cue name="PlayerFiredWeapon" instantiate="true">
              <conditions>
                <event_weapon_fired object="$PlayerWeapon"/>
              </conditions>
              <delay exact="0.1s"/>
              <actions>
                <set_value name="$MissedShots" exact="stat.bullets_fired - $HitTargets"/>
              </actions>
            </cue>

            <cue name="StartTimer" checkinterval="1ms">
              <conditions>
                <check_value value="player.ship.exists"/>
                <set_value name="$PlayerShipRelPos" exact="player.ship.relativeposition.{$Level}"/>
                <check_value value="$PlayerShipRelPos.distanceto.{$PlayerSpawnPos} gt 0.1m"/>
              </conditions>
              <actions>
                <play_sound object="player.entity" sound="'ui_notification_player_alert_13'" type="ui"/>
                <remove_help all="true"/>
                <set_value name="$StartTime" exact="player.age"/>
                <debug_text text="'Player at start position, timer starts at time ' + $StartTime" chance="$DebugChance"/>
                <play_music music="'music_soundtrack_timelines_spacesuit_3'" loop="true"/>
              </actions>
              <cues>
                <cue name="MitsunoHack">
                  <delay min="10s" max="30s"/>
                  <actions>
                    <run_actions ref="md.LIB_Scenario.Mitsuno_Play_Next_Hack"/>
                  </actions>
                </cue>

                <cue name="UpdateTimerDisplay">
                  <actions>
                    <set_value name="$textcolour_primary" exact="'text_normal'"/>
                    <set_value name="$textcolour_secondary" exact="'overlay_scenario_stat_text'"/>
                  </actions>
                  <delay exact="1ms"/>
                  <actions>
                    <show_overlay_text relwidth="1.0" reloffsetx="0.01" reloffsety="0.05" fromtop="true" >
                      <row>
                        <col idx="1"
                             text="{30614,10007}"
                             bgcolor="'overlay_scenario_stat_background'"
                             textcolor="$textcolour_secondary"
                             fontsize="20"
                             halign="right"
                             valign="bottom" />
                        <col idx="2"
                             text="(player.age - $StartTime).formatted.{'%m:%.3S'}"
                             bgcolor="'overlay_scenario_stat_background'"
                             textcolor="$textcolour_primary"
                             fontsize="20"
                             halign="left"
                             valign="bottom"/>
                        <col idx="6"
                         text="' '"
                         bgcolor="'overlay_scenario_stat_background'"
                         textcolor="$textcolour_secondary"
                         fontsize="20"
                         halign="left"
                         valign="bottom" />
                      </row>
                      <row fromtop="true">
                        <col idx="1"
                         text="{30614,10008}"
                         bgcolor="'overlay_scenario_stat_background'"
                         textcolor="$textcolour_secondary"
                         fontsize="12"
                         halign="right"
                         valign="bottom" />
                        <col idx="2"
                             text="'\033#text_normal#' + $CurrentLap + '\033X/' + $NumLaps"
                             bgcolor="'overlay_scenario_stat_background'"
                             textcolor="$textcolour_secondary"
                             fontsize="12"
                             halign="left"
                             valign="bottom"
                             />
                      </row>
                      <row fromtop="true">
                        <col idx="1"
                             text="readtext.{30614}.{205} + readtext.{1001}.{120}"
                             bgcolor="'overlay_scenario_stat_background'"
                             textcolor="$textcolour_secondary"
                             fontsize="12"
                             halign="right"
                             valign="bottom" />
                        <col idx="2"
                             text="'' + $MissedTargets"
                             bgcolor="'overlay_scenario_stat_background'"
                             textcolor="$textcolour_primary"
                             fontsize="12"
                             halign="left"
                             valign="bottom" />
                      </row>
                      <row fromtop="true">
                        <col idx="1"
                             text="readtext.{30614}.{206} + readtext.{1001}.{120}"
                             bgcolor="'overlay_scenario_stat_background'"
                             textcolor="$textcolour_secondary"
                             fontsize="12"
                             halign="right"
                             valign="bottom" />
                        <col idx="2"
                             text="'' + $MissedShots"
                             bgcolor="'overlay_scenario_stat_background'"
                             textcolor="$textcolour_primary"
                             fontsize="12"
                             halign="left"
                             valign="bottom" />
                      </row>
                    </show_overlay_text>
                    <reset_cue cue="this"/>
                  </actions>
                </cue>
                <cue name="PlayerCollided">
                  <conditions>
                    <event_object_collided group="global.$PlayerControlledGroup"/>
                  </conditions>
                  <actions>
                    <set_value name="$PlayerCollided" exact="true"/>
                  </actions>
                </cue>

                <cue name="PlayerDamagedUsecase">
                  <conditions>
                    <event_object_hull_damaged group="global.$PlayerControlledGroup"/>
                  </conditions>
                  <actions>
                    <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                      $caller = this, $preset = '$plotlike', $actors = $CutsceneActors, $debugchance = 0,
                      $script = [
                                  table [$actor = '$Chief', $speak = 306140105, $recipient = 'player', $comment = 'Careful!'],
                                ],
                      $abortonsignalledcue = StopUseCase
                    ]" />
                  </actions>
                  <delay exact="5s"/>
                  <actions>
                    <reset_cue cue="this"/>
                  </actions>
                </cue>

                <cue name="CheckpointReached" checkinterval="1ms">
                  <conditions>
                    <check_value value="player.ship.exists"/>
                    <set_value name="$PlayerShipRelPos" exact="player.ship.relativeposition.{$Level}"/>
                    <check_value value="abs($PlayerShipRelPos.x - $CurrentCheckpointPos.x) lt $CheckDelta and abs($PlayerShipRelPos.y - $CurrentCheckpointPos.y) lt $CheckDelta and abs($PlayerShipRelPos.z - $CurrentCheckpointPos.z) lt $CheckDelta"/>
                  </conditions>
                  <actions>
                    <!--first check if the race is finished-->
                    <do_if value="$CurrentCheckpoint == $Checkpoints.count and $CurrentLap == $NumLaps">
                      <play_sound object="player.entity" sound="'ui_notification_player_alert_13'" type="ui"/>
                      <set_value name="$Duration" exact="player.age - $StartTime"/>
                      <debug_text text="'Remaining targets for lap ' + $CurrentLap + ': ' + $LapTargets.{$CurrentLap}.count"/>
                      <do_for_each name="$target" in="$LapTargets.{$CurrentLap}">
                        <do_if value="$target.isfunctional">
                          <set_value name="$MissedTargets" exact="$MissedTargets + 1"/>
                        </do_if>
                      </do_for_each>
                      <debug_text text="'Missed targets: ' + $MissedTargets"/>
                      <set_value name="$MissedShots" exact="stat.bullets_fired - ($LapTargetCount.{$CurrentLap} * $NumLaps - $MissedTargets)"/>
                      <cancel_cue cue="UpdateTimerDisplay"/>
                      <!--Calculate score, speak line appropriate to rating-->
                      <set_value name="$Score_Time" exact="if $Duration lt $TimeBonusThreshold then $TimeBonusPerSecond * ($TimeBonusThreshold - $Duration)f else 0"/>
                      <set_value name="$Score_Targets" exact="-$MissedTargets * $TargetPenalty"/>
                      <set_value name="$Score_Shots" exact="-$MissedShots * $ShotPenalty"/>
                      <set_value name="$TotalScore" exact="$Score_Time + $Score_Targets + $Score_Shots"/>
                      <set_value name="$Rating" exact="player.allmodules.{player.module}.rating.{$TotalScore}"/>
                      <do_if value="$Rating == 0">
                        <set_value name="$FinalLine" exact="[306140108, 306140118].random" comment="Tss. A substandard result. / Do better."/>
                      </do_if>
                      <do_elseif value="$Rating lt 3">
                        <set_value name="$FinalLine" exact="306140109" comment="Satisfactory. With room for improvement."/>
                      </do_elseif>
                      <do_elseif value="$Rating lt 5">
                        <set_value name="$FinalLine" exact="[306140115, 306140119].random" comment="Impressive! Most impressive! / Well done!"/>
                      </do_elseif>
                      <do_else>
                        <set_value name="$FinalLine" exact="306140116" comment="Inconceivable! That beat my record!"/>
                      </do_else>
                      <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                        $caller = this, $preset = '$plotlike', $actors = $CutsceneActors, $debugchance = 0,
                        $script = [
                                    table [$actor = '$Chief', $speak = $FinalLine, $recipient = 'player'],
                                  ],
                        $callbackcue = FinalSpeakFinished,
                        $abortcallbackcue = FinalSpeakFinished,
                        $abortonsignalledcue = StopUseCase
                      ]" />
                      <do_if value="not $PlayerCollided?">
                        <unlock_achievement name="TL_MOVE_LIKE_SPACEFLY" scenario="true"/>
                      </do_if>
                    </do_if>
                    <do_else>
                      <!--check if we should change the current objective-->
                      <do_if value="$CurrentCheckpoint ge $ShootingStartCheckpoint and $CurrentCheckpoint le $ShootingEndCheckpoint">
                        <do_if value="not $ShootingObjectiveSet?">
                          <set_objective cue="$MissionCue" step="2" action="objective.destroy" group="$LapTargets.{$CurrentLap}" updatebriefing="true"/>
                          <set_value name="$ShootingObjectiveSet" exact="true"/>
                        </do_if>
                      </do_if>
                      <do_elseif value="$ShootingObjectiveSet?">
                        <set_objective_from_briefing cue="$MissionCue" step="1"/>
                        <remove_value name="$ShootingObjectiveSet"/>
                      </do_elseif>
                      <!--now check if we've completed a lap-->
                      <do_if value="$CurrentCheckpoint == $Checkpoints.count">
                        <!--count missed targets-->
                        <do_for_each name="$target" in="$LapTargets.{$CurrentLap}">
                          <do_if value="$target.isfunctional">
                            <set_value name="$MissedTargets" exact="$MissedTargets + 1"/>
                          </do_if>
                        </do_for_each>
                        <set_value name="$CurrentLap" exact="$CurrentLap + 1"/>
                        <set_value name="$CurrentCheckpoint" exact="1"/>
                        <do_for_each name="$target" in="$AllTargets">
                          <set_object_hidden object="$target" hidden="true"/>
                        </do_for_each>
                        <do_for_each name="$target" in="$LapTargets.{$CurrentLap}">
                          <set_object_hidden object="$target" hidden="false"/>
                        </do_for_each>
                      </do_if>
                      <!--simply go to the next checkpoint-->
                      <do_else>
                        <set_value name="$CurrentCheckpoint" exact="$CurrentCheckpoint + 1"/>
                      </do_else>
                      <set_value name="$CurrentCheckpointPos" exact="$Checkpoints.{$CurrentCheckpoint}"/>
                      <reset_cue cue="this"/>
                    </do_else>
                  </actions>
                </cue>

                <cue name="TargetDestroyed" instantiate="true">
                  <conditions>
                    <event_object_hull_below_function_threshold group="$AllTargets"/>
                  </conditions>
                  <actions>
                    <set_value name="$HitTargets" exact="1" operation="add"/>
                    <remove_from_group group="$LapTargets.{$CurrentLap}" object="event.object"/>
                    <do_if value="$LapTargets.{$CurrentLap}.count">
                      <set_objective cue="$MissionCue" step="2" action="objective.destroy" group="$LapTargets.{$CurrentLap}" updatebriefing="true" silent="true"/>
                    </do_if>
                    <do_else>
                      <set_objective_from_briefing cue="$MissionCue" step="1"/>
                    </do_else>
                  </actions>
                </cue>

                <cue name="FinalSpeakFinished">
                  <conditions>
                    <event_cue_signalled/>
                  </conditions>
                  <actions>
                    <signal_cue cue="ResultWindow"/>
                  </actions>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

        <cue name="PlayerDied">
          <conditions>
            <event_object_destroyed object="player.entity"/>
          </conditions>
          <actions>
            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
              $caller = this, $preset = '$plotlike', $actors = $CutsceneActors, $debugchance = 0,
              $script = [
                          table [$actor = '$Chief', $speak = 306140106, $recipient = 'player', $comment = 'Rogias? Rogias? ROGIIIAAAAAS!'],
                        ],
              $abortonsignalledcue = StopUseCase
            ]" />
          </actions>
        </cue>

        <cue name="ResultWindow" comment="Scenario Ended (Failure or Success Case)">
          <!-- set data when you die or finish a mission in the failure or success case -->
          <!-- game is force paused -->
          <conditions>
            <check_any>
              <event_cue_signalled/>
              <event_object_destroyed object="player.entity"/>
            </check_any>
          </conditions>
          <actions>
            <set_value name="$ResultData" exact="table[]"/>
            <set_value name="$ResultData.$PlayerDied" exact="event.name == 'event_object_destroyed' and event.object == player.entity"/>
            <do_if value="$Duration?" comment="null if the course has not been completed, probably due to the player dying">
              <set_value name="$Score_Time" exact="if $Duration lt $TimeBonusThreshold then $TimeBonusPerSecond * ($TimeBonusThreshold - $Duration)f else 0"/>
              <set_value name="$Score_Targets" exact="-$MissedTargets * $TargetPenalty"/>
              <set_value name="$Score_Shots" exact="-$MissedShots * $ShotPenalty"/>
              <set_value name="$ResultData.$Score" exact="$Score_Time + $Score_Targets + $Score_Shots"/>
              <substitute_text text="$timebonushinttext" source="{30614,204}">
                <replace string="'$SCORE$'" with="$TimeBonusPerSecond"/>
                <replace string="'$TIME$'" with="$TimeBonusThreshold.formatted.default" />
              </substitute_text>
              <add_scenario_stat id="'time'" name="{30620,52}" uivalue="$Duration.formatted.{'%m:%.3S'}" description="$timebonushinttext" score="$Score_Time"/>
              <add_scenario_stat id="'targets'" name="{30614,205}" uivalue="$MissedTargets" score="$Score_Targets"/>
              <add_scenario_stat id="'shots'" name="{30614,206}" uivalue="$MissedShots" score="$Score_Shots"/>
            </do_if>
            <do_else>
              <set_value name="$ResultData.$Score" exact="0"/>
              <add_scenario_stat id="'completed'" name="{30614,201}" uivalue="{1001,2618}" score="0"/>
            </do_else>
          </actions>
          <cues>
            <cue name="Finished_Ref" ref="md.LIB_Scenario.ScenarioFinished">
              <param name="ResultData" value="$ResultData"/>
            </cue>
          </cues>
        </cue>

      </cues>
    </cue>

  </cues>
</mdscript>
