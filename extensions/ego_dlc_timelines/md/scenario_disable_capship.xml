<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Scenario_Disable_Capship" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <documentation>
    <author name="Adrian Hamm"/>
  </documentation>
  <cues>

    <!--This template is a copy of scenario_template, with all the actions and sections marketd with the tag #TemplateExample removed. It can be used as the basis for new scenario scripts. -->
    <cue name="Start" namespace="this" module="scenario_disable_capship">
      <conditions>
        <event_cue_signalled cue="md.Setup.Start" />
      </conditions>
      <actions>
        <include_actions ref="md.LIB_Scenario.ScenarioStarted"/>

        <!--========================================================
            Set some of the commonly used variables
            ============================================================-->

        <set_value name="$DebugChance"        exact="100"/>
        <set_value name="$MissionCue"         exact="namespace"/>

        <set_value name="$Page"               exact="30609"/>
        <set_value name="$Difficulty"         exact="if event.param.$Difficulty? then event.param.$Difficulty else level.medium"/>
        <set_value name="$MissionType"        exact="missiontype.fight"/>
        <set_value name="$MissionFaction"     exact="faction.argon"/>

        <set_value name="$HasError"           exact="false" comment="will be set true if any setup fails"/>

        <debug_text text="'Initialising Scenario:' + $Page" chance="$DebugChance"/>

        <!-- Table that will be filled with all actors with active speaking roles -->
        <set_value name="$MissionActors" exact="table[]"/>

        <!-- Group of Objects which will End the Scenario and trigger ResultWindow if destroyed -->
        <create_group groupname="$MissionRelevantObjects" comment="add objects which trigger mission failure/success on destruction"/>

        <!--========================================================
            Universe Flags
            ============================================================-->

        <!--$DisableAutoInitialisation prevents the InitUniverse script interfering with map objects. All map ships/stations will not have any entities such as engineers. Map stations will not have random amounts of wares/workforce
        Commented out as default but feel free to disable it if required by your scenario-->
        <!--<set_value name="md.InitUniverse.Start.$DisableAutoInitialisation" exact="true"/>-->

        <!--This disables the spawning of generic missions-->
        <set_value name="md.GenericMissions.Manager.$Disabled" exact="true"/>

        <!--========================================================
            Custom scenario-specific variables go here
            ============================================================-->
        <create_group groupname="$PlayerShipGroup"/>
      </actions>
      <cues>

        <cue name="Setup_Scenario">
          <cues>

            <cue name="Call_Setup_Libraries">
              <actions>
                <include_actions ref="Setup_Player" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_PlayerFleet" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Target" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_ArgonCommander" chance="if $HasError then 0 else 100"/>

                <!--If there was an error, signal the CleanUp cue, otherwise signal the scenario to start-->
                <do_if value="$HasError">
                  <quit_to_game game="'x4ep1_gamestart_hub'"/>
                </do_if>
                <do_else>
                  <debug_text text="'Scenario has been successfully set up and can start'" chance="$DebugChance"/>
                  <signal_cue cue="Start_Scenario"/>
                </do_else>
              </actions>
            </cue>

            <library name="Setup_Player">
              <actions>
                <!-- Place the Player, then check for Player existence -->

                <do_if value="not player.exists">
                  <debug_text text="'Player does not exist'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>
                <!-- Add Teleportation Research to be able to jump between ships -->
                <add_research ware="ware.research_teleportation"/>
                <set_value name="$PlayerStartingShip" exact="player.ship"/>
              </actions>
            </library>

            <library name="Setup_PlayerFleet">
              <actions>
                <do_all exact="4" counter="$i">
                  <do_all exact="3" counter="$j">
                    <do_if value="$j == 1">
                      <create_ship name="$heavyship" macro="macro.ship_arg_s_heavyfighter_02_a_macro" sector="player.sector" groupname="$PlayerShipGroup" capturable="false" >
                        <owner exact="faction.player"/>
                        <pilot>
                          <select faction="$MissionFaction" tags="tag.pilot"/>
                          <skills>
                            <skill type="management"  exact="[6,9].randominrange"/>
                            <skill type="morale"      exact="[9,12].randominrange"/>
                            <skill type="piloting"    exact="12"/>
                            <skill type="engineering" exact="[6,9].randominrange"/>
                            <skill type="boarding"    exact="[6,9].randominrange"/>
                          </skills>
                        </pilot>
                        <loadout ref="scenario_disable_capship_player_escort_heavy_ship"/>
                        <safepos space="player.sector" object="player.ship" x="if $i == 1 then -105m else 105m" radius="1km"/>
                        <rotation value="player.ship.rotation"/>
                      </create_ship>
                      <create_formation leader="player.ship" formation="formationshape.vshape" follower="$heavyship" param="105m"/>
                      <create_order id="'AssignCommander'" object="$heavyship">
                        <param name="commander" value="player.ship"/>
                        <param name="assignment" value="assignment.attack"/>
                        <param name="cancelorders" value="true"/>
                      </create_order>
                    </do_if>
                    <do_else>
                      <create_ship name="$ship" macro="macro.ship_arg_s_fighter_01_b_macro" sector="player.sector" groupname="$PlayerShipGroup" capturable="false" >
                        <owner exact="faction.player"/>
                        <pilot>
                          <select faction="$MissionFaction" tags="tag.pilot"/>
                          <skills>
                            <skill type="management"  exact="[6,9].randominrange"/>
                            <skill type="morale"      exact="[9,12].randominrange"/>
                            <skill type="piloting"    exact="12"/>
                            <skill type="engineering" exact="[6,9].randominrange"/>
                            <skill type="boarding"    exact="[6,9].randominrange"/>
                          </skills>
                        </pilot>
                        <loadout ref="scenario_disable_capship_player_escort_ship"/>
                        <safepos space="player.sector" object="$heavyship" radius="45m"/>
                        <rotation value="player.ship.rotation"/>
                      </create_ship>
                      <create_formation leader="$heavyship" formation="formationshape.vshape" follower="$ship" param="45m"/>
                      <create_order id="'AssignCommander'" object="$ship">
                        <param name="commander" value="$heavyship"/>
                        <param name="assignment" value="assignment.interception"/>
                        <param name="cancelorders" value="true"/>
                      </create_order>

                    </do_else>
                  </do_all>
                </do_all>
              </actions>
            </library>

            <library name="Setup_Target">
              <actions>
                <!-- Place the target, then check for its existence -->
                <create_ship name="$Target" macro="macro.ship_xen_xl_carrier_01_a_macro" zone="player.zone">
                  <owner exact="faction.xenon" overridenpc="true"/>
                  <pilot>
                    <select faction="faction.xenon" tags="tag.fighterpilot"/>
                  </pilot>
                  <loadout ref="scenario_disable_capship_xenon_ship"/>
                  <position x="0km" y="10km" z="0km" />
                </create_ship>
                <set_object_forced_radar_visible object="$Target" visible="true"/>
                <set_known object="$Target" known="true"/>

                <do_if value="not $Target.exists">
                  <debug_text text="'Target does not exist'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>


                <create_order object="$Target" id="'Wait'">
                  <param name="timeout" value="20s"/>
                </create_order>
                <create_order object="$Target" id="'Patrol'" default="true">
                  <param name="space" value="$Target.sector"/>
                </create_order>

                <find_object_component groupname="$TargetComponents" object="$Target" class="class.engine" multiple="true"/>

                <!-- For easier balancing, already reduce the hull of the engines -->
                <do_for_each name="$engine" in="$TargetComponents">
                  <set_object_hull object="$engine" exact="33"/>
                </do_for_each>
                
                <find_object_component groupname="$TargetComponents" object="$Target" class="class.turret" multiple="true"/>

                <do_if value="not @$TargetComponents.count">
                  <debug_text text="'Target has no engines or turrets'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>

                <do_all exact="2">
                  <get_ship_definition reference="$XenonFighterRef" faction="faction.xenon" size="class.ship_s" tags="tag.fighter"/>
                  <create_ship name="$XenonFighter" ref="$XenonFighterRef" sector="player.sector" capturable="false">
                    <owner exact="faction.xenon"/>
                    <pilot>
                      <select faction="faction.xenon" tags="tag.pilot"/>
                    </pilot>
                    <loadout>
                      <quantity exact="1.0" comment="fill completely">
                        <variation exact="0"/>
                      </quantity>
                      <quality exact="0.2"/>
                    </loadout>
                    <safepos space="player.sector" object="$Target" radius="2km"/>
                  </create_ship>
                  <create_order id="'AssignCommander'" object="$XenonFighter" immediate="true">
                    <param name="commander" value="$Target"/>
                    <param name="assignment" value="assignment.interception"/>
                    <param name="cancelorders" value="true"/>
                  </create_order>
                </do_all>
              </actions>
            </library>
            
            <library name="Setup_ArgonCommander">
              <actions>
                <create_cue_actor name="$ArgonCommanderActor" cue="namespace" macro="character_argon_male_cau_base_01_macro">
                  <page exact="10134"/>
                  <owner exact="faction.argon"/>
                  <skills>
                    <skill type="management"  exact="6"/>
                    <skill type="morale"      exact="15"/>
                    <skill type="piloting"    exact="8"/>
                    <skill type="engineering" exact="5"/>
                    <skill type="boarding"    exact="2"/>
                  </skills>
                </create_cue_actor>
                <set_entity_traits    entity="$ArgonCommanderActor" missionactor="true" customhandler="true" subtitlename="true"/>

                <!-- NPC Usecase Setup -->
                <do_if value="not $MissionActors?">
                  <set_value name="$MissionActors" exact="table[]"/>
                </do_if>
                <set_value name="$MissionActors.$ArgonCommanderActor" exact="table[
                                              $entity = $ArgonCommanderActor,
                                              $monitor = table[
                                                $cutscenekey = 'ShowNPCFace',
                                                $caption = true
                                              ]
                                            ]"/>
              </actions>
            </library>

            <!-- Track the cause of death to be able to display it in the debrief menu, if applicable -->
            <cue name="Add_Stat_Cause_Of_Death" ref="md.LIB_Scenario.Track_Cause_Of_Death">
              <param name="SpecifyWeapon" value="true"/>
            </cue>

            <cue name="Debug">

            </cue>

          </cues>
        </cue>

        <!--****StartScenario****
        This cue is signalled if the setup cue hasn't found any issues and the scenario can now start
        This cue and following subcues will manage the presentation, objects, AI and mission objectives
        The mission itself does not have to be created until later (see create_mission)-->

        <cue name="Start_Scenario">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <cues>
            <!-- The cues that make up the scenario will go here -->
            <cue name="Intro_Cutscene">
              <actions>
                <!-- sort the group to consistently get the same component in the shot -->
                <sort_group group="$TargetComponents" sortbydistanceto="player.ship"/>
                <play_cutscene letterbox="true" movesoundcamera="true" result="this.$Cutscene" key="'scenario_disable_capship_intro_cutscene'" abortable="true">
                  <param name="target_capitalship" object="$Target"/>
                  <param name="target_component" object="$TargetComponents.{13}"/>
                  <param name="target_playership" object="$PlayerStartingShip"/>
                </play_cutscene>
              </actions>
              <cues>

                <cue name="Intro_Cutscene_Ended">
                  <conditions>
                    <event_cutscene_stopped key="'scenario_disable_capship_intro_cutscene'"/>
                  </conditions>
                  <actions>
                    <muffle_sound strength="0" duration="0s"/>
                    <blur_screen strength="0" duration="0s"/>
                    <do_if value="event.param3">
                      <signal_cue cue="Intro_Speech_NPCUsecase_Abort"/>
                    </do_if>
                    <fade_screen fadeout="0s" holdtime="0.5s" fadein="0.5s" realtime="true"/>
                  </actions>
                  <delay exact="0.5s"/>
                  <actions>
                    <signal_cue cue="SetupMission"/>
                  </actions>
                </cue>

                <cue name="Intro_Cutscene_Speech">
                  <actions>
                    <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                              $caller = this, $preset = '$plotlike', $actors = $MissionActors, $debugchance = $DebugChance,
                                                                              $abortonsignalledcue = Intro_Speech_NPCUsecase_Abort,
                                                                              $script = [
                                                                                      9s,
                                                                                      table[ $actor = '$ArgonCommanderActor', $speak = 306090101, $recipient = 'player', $comment = 'Wing leader, this is Patrol Command.' ],
                                                                                      1.0s,
                                                                                      table[ $actor = '$ArgonCommanderActor', $speak = 306090102, $recipient = 'player', $comment = 'Our scouts have come across a Xenon capital ship heading towards our territory.' ],
                                                                                      1.0s,
                                                                                      table[ $actor = '$ArgonCommanderActor', $speak = 306090103, $recipient = 'player', $comment = 'We dont currently have the firepower on hand to stave off that attack, but a fleet is being redeployed as we speak.' ],
                                                                                      0.5s,
                                                                                      table[ $actor = '$ArgonCommanderActor', $speak = 306090104, $recipient = 'player', $comment = 'You and your team need to buy us time.' ],
                                                                                      0.5s,
                                                                                      table[ $actor = '$ArgonCommanderActor', $speak = 306090105, $recipient = 'player', $comment = 'Get in there and take out the engines, take out the turrets.' ],
                                                                                      0.5s,
                                                                                      table[ $actor = '$ArgonCommanderActor', $speak = 306090106, $recipient = 'player', $comment = 'Good luck, and good hunting!' ],
                                                                              ]
                                                                            ]" />
                  </actions>
                </cue>

                <cue name="Intro_Speech_NPCUsecase_Abort">
                  <conditions>
                    <event_cue_signalled/>
                  </conditions>
                </cue>

              </cues>
            </cue>


            <cue name="SetupMission">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <delay exact="1s"/>
              <actions>
                <!-- Mission Objective -->
                <create_mission cue="$MissionCue" abortable="false"
                                name="{30609,1001}" description="{30609,1004}"
                                icon="'briefing_mission_director_01'" iconcaption="{30293,102}"
                                difficulty="$Difficulty" type="$MissionType" faction="$MissionFaction">
                  <briefing>
                    <objective step="1" action="objective.flyto" object="$Target"/>
                    <objective step="2" action="objective.destroy" group="$TargetComponents"/>
                  </briefing>
                </create_mission>
                <set_objective_from_briefing cue="$MissionCue" step="1"/>
              </actions>
            </cue>

            <cue name="Call_MitsunoHack">
              <actions>
                <set_value name="$RandomDelay" min="60s" max="150s" profile="bell"/>
              </actions>
              <delay exact="$RandomDelay"/>
              <actions>
                <run_actions ref="md.LIB_Scenario.Mitsuno_Play_Next_Hack"/>
              </actions>
            </cue>

            <cue name="PlayerShip_HullDamaged">
              <conditions>
                <event_object_hull_damaged object="$PlayerStartingShip"/>
                <check_value value="$PlayerStartingShip.hullpercentage lt 100"/>
              </conditions>
              <actions>
                <set_value name="$PlayerShipTookDamage"/>
              </actions>
            </cue>
            
            <cue name="SurfaceElementDestroyed" instantiate="true">
              <conditions>
                <event_object_destroyed group="$TargetComponents"/>
                <check_value value="event.param == player.occupiedship"/>
              </conditions>
              <actions>
                <set_value name="$PlayerDestroyedElements" operation="add" exact="1"/>
              </actions>
            </cue>

            <cue name="CheckDistanceToTarget" checkinterval="1s">
              <conditions>
                <check_any>
                  <check_value value="player.ship.distanceto.{$Target} lt 25km"/>
                  <check_any exact="$PlayerShipGroup.count" counter="$i">
                    <check_value value="$PlayerShipGroup.{$i}.distanceto.{$Target} lt 15km"/>
                  </check_any>
                </check_any>
              </conditions>
              <actions>
                <set_value name="$StartTime" exact="player.age"/>
                <update_mission cue="$MissionCue" showelapsedtime="true"/>
              </actions>
              <cues>
                <cue name="DestroyComponents_Ref" ref="md.RML_Destroy_Components.DestroyComponents">
                  <!-- always pass these -->
                  <param name="EndSignalCue"      value="ResultWindow"/>
                  <param name="MissionCue"        value="$MissionCue"/>
                  <param name="DebugChance"       value="$DebugChance"/>
                  <param name="StartStep"         value="2"/>
                  <!-- mission-related parameters -->
                  <param name="Targets_Param"     value="$TargetComponents"/>
                  <param name="ObjectiveIsGroup"  value="true"/>
                </cue>
              </cues>
            </cue>

            <!-- If the player's starting ship is destroyed or the player changes ship, set the corresponding flag -->
            <cue name="PlayerStarterShip_Destroyed">
              <conditions>
                <check_any>
                  <event_object_destroyed object="$PlayerStartingShip"/>
                </check_any>
              </conditions>
              <actions>
                <set_value name="$PlayerLeftStartingShip"/>
                <show_help line="30609001" position="1" duration="8s" force="true"/>
              </actions>
            </cue>

            <cue name="TargetDestroyedByBomds">
              <conditions>
                <check_all>
                  <event_object_destroyed group="$TargetComponents"/>
                  <check_value value="event.param == null or event.param.isclass.spacesuit"/>
                </check_all>
              </conditions>
              <actions>
                <set_value name="$BombDestroyedTargetComponent"/>
              </actions>
            </cue>

            <!-- If no player ships are still operational, end the scenario -->
            <cue name="FailureCheck_DestroyedShips" checkinterval="2s">
              <conditions>
                <count_ships result="$PlayerShipCount" owner="faction.player" exact="0" space="player.galaxy" checkoperational="true">
                  <match class="class.spacesuit" negate="true"/>
                </count_ships>
              </conditions>
              <actions>
                <signal_cue cue="ResultWindow"/>
              </actions>
            </cue>
          </cues>
        </cue>

        <cue name="ResultWindow" comment="Scenario Ended (Failure or Success Case)">
          <!-- set data when you die or finish a mission in the failure or success case -->
          <!-- game is force paused -->
          <conditions>
            <check_any>
              <event_cue_signalled/>
              <event_object_destroyed group="$MissionRelevantObjects"/>
              <event_object_destroyed object="player.entity"/>
            </check_any>
          </conditions>
          <actions>
            <pause_mission_timer cue="$MissionCue"/>
            <set_value name="$EndTime" exact="player.age"/>
            <set_value name="$ResultData" exact="table[]"/>
            <set_value name="$ResultData.$PlayerDied" exact="event.name == 'event_object_destroyed' and event.object == player.entity"/>
            <do_if value="@ResultWindow.$EndFeedbackValue gt 0">
              <!-- Stat: Time -->
              <run_actions ref="md.LIB_Scenario.Add_Scenario_Stat_Time" result="$Score_Time">
                <param name="StartTime" value="$StartTime"/>
                <param name="EndTime" value="$EndTime"/>
                <param name="ScoreTimeReference" value="1300"/>
                <param name="MandatorySurvival" value="true"/>
              </run_actions>
              
              <set_value name="$Score_PlayerLeftShip" exact="if $PlayerLeftStartingShip? then 0 else 300"/>
              <set_value name="$Score_PlayerHullIntact" exact="if $PlayerStartingShip.hullpercentage == 100 then 200 else 0"/>
              <set_value name="$Score_PersonalParticipation" exact="if$PlayerDestroyedElements? then 150 else 0"/>
              <set_value name="$Score_BombDestruction" exact="if $BombDestroyedTargetComponent? then 200 else 0 " comment="this is a nice fun achievement type score, not something that we should reward or punish the player over"/>

              <set_value name="$ResultData.$Score" exact="$Score_Time + $Score_PlayerLeftShip + $Score_PlayerHullIntact + $Score_PersonalParticipation + $Score_BombDestruction"/>
            </do_if>
            <do_else>
              <set_value name="$Score_PlayerLeftShip" exact="if $PlayerLeftStartingShip? then 0 else 300"/>
              <set_value name="$Score_PlayerHullIntact" exact="if $PlayerStartingShip.hullpercentage == 100 then 200 else 0"/>
              <set_value name="$Score_PersonalParticipation" exact="if $PlayerDestroyedElements? then 150 else 0"/>
              <set_value name="$Score_BombDestruction" exact="if $BombDestroyedTargetComponent? then 200 else 0 " comment="this is a nice fun achievement type score, not something that we should reward or punish the player over"/>

              <set_value name="$ResultData.$Score" exact="$Score_PlayerLeftShip + $Score_PlayerHullIntact + $Score_PersonalParticipation + $Score_BombDestruction"/>
            </do_else>

            <do_if value="not $PlayerShipTookDamage?">
              <!-- Award the Not a Scratch achievement if this mission was completed without taking any hull damage  -->
              <unlock_achievement name="TL_NOT_A_SCRATCH" scenario="true"/>
            </do_if>

            <add_scenario_stat id="'startingship'" name="{30609,1201}" description="{30609,1202}" comment="Did the Starting Ship survive?" uivalue="if $PlayerLeftStartingShip? then {1001,2618} else {1001,2617} " score="$Score_PlayerLeftShip" maxscore="300"/>
            <add_scenario_stat id="'nodamage'" name="{30609,1211}" description="{30609,1212}" comment="Player Ship did not take damage to the hull?" uivalue="if not $PlayerShipTookDamage? then {1001,2617} else {1001,2618}" score="$Score_PlayerHullIntact" maxscore="200"/>
            <add_scenario_stat id="'surfaceelement'" name="{30609,1221}" description="{30609,1222}" comment="Personally destroyed at least one surface element?" uivalue="if $PlayerDestroyedElements? then {1001,2617} else {1001,2618}" score="$Score_PersonalParticipation" maxscore="150"/>
            <add_scenario_stat id="'usedbombs'" name="{30609,1231}" description="{30609,1232}" comment="Spacesuit Bombs destroyed at least one surface element?" uivalue="if $BombDestroyedTargetComponent? then {1001,2617} else {1001,2618} " score="$Score_BombDestruction" maxscore="200"/>

          </actions>
          <cues>
            <cue name="Finished_Ref" ref="md.LIB_Scenario.ScenarioFinished">
              <param name="ResultData" value="$ResultData"/>
            </cue>
          </cues>
        </cue>

      </cues>
    </cue>

  </cues>
</mdscript>
