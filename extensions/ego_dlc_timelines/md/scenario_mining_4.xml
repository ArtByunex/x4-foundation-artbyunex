<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Scenario_Mining_4" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <documentation>
    <author name="Lennart Funk"/>
  </documentation>
  <cues>

    <!-- Xenon are attacking Getsu Fune in earnest during the Gate shutdown.
         A multi-faction coalition is trying to gather as many resources as possible to build up a defence.
         You're an experienced miner. Mine as much ore and silicon as you can within the time limit, and don't get killed. -->
    <cue name="Start" namespace="this" module="scenario_mining_4">
      <conditions>
        <event_game_started/>
      </conditions>
      <actions>
        <include_actions ref="md.LIB_Scenario.ScenarioStarted"/>

        <set_value name="$DebugChance"         exact="100"/>
        <set_value name="$DeepDebugChance"     exact="0"/>
        <set_value name="$MissionCue"          exact="namespace"/>

        <set_value name="$Page"                exact="30613"/>
        <set_value name="$Difficulty"          exact="level.medium"/>
        <set_value name="$MissionFaction"      exact="faction.civilian"/>
        <find_sector name="$MissionSector"     macro="macro.timelines_map_mining_1_cluster_001_sector_001_macro"/>
        <set_value name="$ResultData" exact="table[]"/>

        <set_value name="$HasError"           exact="false" comment="will be set true if any setup fails"/>

        <debug_text text="'Initialising Scenario:' + $Page" chance="$DebugChance"/>

        <!-- Table that will be filled with all actors with active speaking roles -->
        <set_value name="$MissionActors" exact="table[]"/>

        <!-- Custom Scenario-Related variables -->
        <set_value name="$ValidWaresList" exact="[ware.ore, ware.silicon]"/>

        <set_value name="$MissionDuration"                exact="10min"/>
        <set_value name="$DurationUntilAttack"            exact="4min"/>
        <set_value name="$DurationUntilHack"              exact="90s"/>

        <set_value name="$PlayerAttacked" exact="false"/>
        <set_owner object="$MissionSector" faction="faction.ownerless"/>

        <!-- Disable generic missions -->
        <set_value name="md.GenericMissions.Manager.$Disabled" exact="true"/>
        <!-- Create Resource Areas -->
        <create_resource_area yieldname="'sphere_medium_ice_low_average'" sector="$MissionSector">
          <position x="52000" y="-3000" z="-70000" />
        </create_resource_area>
        <create_resource_area yieldname="'sphere_large_silicon_medium_average'" sector="$MissionSector">
          <position x="52000" y="-3000" z="-70000" />
        </create_resource_area>
        <create_resource_area yieldname="'sphere_large_ore_high_average'" sector="$MissionSector">
          <position x="52000" y="-3000" z="-70000" />
        </create_resource_area>
      </actions>
      <cues>

        <cue name="DEBUG_Print_Player_Position" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <create_position name="this.$pos" object="player.ship" space="player.sector"/>
            <debug_text text="this.$pos"/>
          </actions>
        </cue>

        <cue name="DEBUG_Print_Player_Position_In_Room" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <create_position name="this.$pos" object="player.entity" space="player.room"/>
            <debug_text text="this.$pos"/>
          </actions>
        </cue>

        <cue name="DEBUG_Print_Target_Position" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <create_position name="this.$pos" object="player.target" space="player.sector"/>
            <debug_text text="this.$pos"/>
          </actions>
        </cue>

        <cue name="Setup_Scenario">
          <cues>

            <cue name="Call_Setup_Libraries">
              <actions>
                <include_actions ref="Setup_Player" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Player_Property" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Actors" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Stations" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_NPC_Ships" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Abandoned_Ships" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Positions" chance="if $HasError then 0 else 100"/>
                <run_actions ref="md.LIB_Scenario.Setup_Faction_ParanidEmpire" chance="if $HasError then 0 else 100"/>

                <set_value name="$HasError" exact="0"/>

                <!--If there was an error, signal the CleanUp cue, otherwise signal the scenario to start-->
                <do_if value="$HasError">
                  <signal_cue cue="CleanUp"/>
                </do_if>
                <do_else>
                  <debug_text text="'Scenario has been successfully set up and can start'" chance="$DebugChance"/>
                  <signal_cue cue="Start_Scenario"/>
                </do_else>
              </actions>
            </cue>

            <library name="Setup_Player">
              <actions>
                <do_if value="not player.exists">
                  <debug_text text="'Player does not exist'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>
              </actions>
            </library>

            <library name="Setup_Player_Property">
              <actions>
                <find_ship_by_true_owner groupname="$Player_Miners" name="$PlayerShip" faction="faction.player" space="$MissionSector"/>

                <find_object_component groupname="$PlayerTurrets" object="$PlayerShip" multiple="true" class="class.turret"/>
                <do_for_each in="$PlayerTurrets" name="$CurrentTurret">
                  <set_weapon_mode weapon="$CurrentTurret" weaponmode="weaponmode.attackenemies"/>
                </do_for_each>

                <!--<create_ship name="$PlayerShip" zone="player.zone" comment="#TemplateExample">
                  <select faction="$EnemyOwner" size="class.ship_s"/>
                  <owner exact="$EnemyOwner" overridenpc="true"/>
                  <safepos x="1km" z="10km"/>
                </create_ship>-->

                <!--<do_if value="not $PlayerShip.exists">
                  <debug_text text="'$PlayerShip not found'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>-->
              </actions>
            </library>

            <library name="Setup_Stations">
              <actions>
                <!-- SPL and BOR equipment dock wrecks are still there. Some smaller stations have been destroyed by the Xenon. -->
                <set_value name="$RemovedStationEntries" exact="[]"/>
                <set_value name="$WreckedStationEntries" exact="[ 'scenario_mining_1to4_bor_equipment',
                                                                  'scenario_mining_1to4_spl_equipment',
                                                                  'scenario_mining_1to4_ore_refinery_001',
                                                                  'scenario_mining_1to4_energy_001',
                                                                  'scenario_mining_1to4_energy_002',
                                                                  'scenario_mining_1to4_wheat_001' ]"/>

                <do_for_each in="$RemovedStationEntries" name="$CurrentEntry">
                  <find_station name="$Station" godstationentry="$CurrentEntry" space="$MissionSector"/>
                  <do_if value="$Station">
                    <destroy_object object="$Station" explosion="false"/>
                  </do_if>
                </do_for_each>

                <do_for_each in="$WreckedStationEntries" name="$CurrentEntry">
                  <find_station name="$Station" godstationentry="$CurrentEntry" space="$MissionSector"/>
                  <do_if value="$Station">
                    <set_allow_drop object="$Station" allow="false"/>
                    <destroy_object object="$Station" explosion="true"/>
                  </do_if>
                </do_for_each>

                <find_station name="$OreRefinery" godstationentry="'scenario_mining_1to4_ore_refinery_002'" space="$MissionSector"/>
                <find_station name="$SiliconRefinery" godstationentry="'scenario_mining_1to4_silicon_refinery_001'" space="$MissionSector"/>
                <find_station name="$MegaStation" godstationentry="'scenario_mining_4_funanori_station'" space="$MissionSector"/>

                <do_if value="not $SiliconRefinery.exists or not $OreRefinery.exists">
                  <debug_text text="'Refinery does not exist'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>
              </actions>
            </library>


            <library name="Setup_Actors">
              <actions>
                <create_cue_actor name="$MinerActor" cue="$MissionCue" macro="character_timelines_scenario_mining_seasoned_miner_macro">
                  <page exact="10136"/>
                  <owner exact="faction.civilian"/>
                </create_cue_actor>
                <set_entity_traits entity="$MinerActor" missionactor="true" customhandler="true" subtitlename="true"/>
                <set_entity_overrides entity="$MinerActor" icon="'pilot'"/>

                <!-- NPC Usecase Setup. Klaus' recommendations:
                         - use $recipient = 'player' in the usecase when we really want to show a monitor cutscene, instead of a general $forceonplayer in the monitor settings
                         - don't use $ignoredistance, unless we want a monitor cutscene even if the player is in the same room as the NPC -->
                <set_value name="$MissionActors.$MinerActor" exact="table[
                                              $entity = $MinerActor,
                                              $monitor = table[
                                                $cutscenekey = 'ShowNPCFace',
                                                $caption = true
                                              ]
                                            ]"/>
              </actions>
              <delay exact="0.5s"/>
              <actions>
                <signal_cue_instantly cue="md.Setup.AddStoryMentor" param="table[$story=$MissionCue, $actor=$MinerActor]"/>
              </actions>
            </library>

            <library name="Setup_NPC_Ships">
              <actions>
                <set_value name="this.$ResourceCounter" exact="1"/>
                <!-- Make sure that there's only one M miner mining Ore, and one mining Silicon, or the player could be blocked from docking if the timing is bad. -->
                <set_value name="$FleetComposition" exact="[
                                  [ macro.ship_arg_l_miner_solid_01_a_macro, 228, faction.argon, 'argon_elite_freighter_crew' ],
                                  [ macro.ship_par_l_miner_solid_02_a_macro, 227, faction.paranid, 'paranid_elite_freighter_crew' ],
                                  [ macro.ship_tel_l_miner_solid_02_a_macro, 201, faction.teladi, 'teladi_elite_freighter_crew' ],

                                  [ macro.ship_par_m_miner_solid_01_a_macro, 222, faction.paranid, 'paranid_elite_freighter_crew' ],
                                  [ macro.ship_tel_m_miner_solid_01_a_macro, 209, faction.teladi, 'teladi_elite_freighter_crew' ],

                                  [ macro.ship_arg_s_miner_solid_01_a_macro, 216, faction.argon, 'argon_elite_freighter_crew' ],
                                  [ macro.ship_arg_s_miner_solid_01_a_macro, 223, faction.argon, 'argon_elite_freighter_crew' ],
                                  [ macro.ship_arg_s_miner_solid_01_a_macro, 224, faction.argon, 'argon_elite_freighter_crew' ],

                                  [ macro.ship_par_s_miner_solid_01_a_macro, 232, faction.paranid, 'paranid_elite_freighter_crew' ],
                                  [ macro.ship_par_s_miner_solid_01_a_macro, 231, faction.paranid, 'paranid_elite_freighter_crew' ],
                                  [ macro.ship_par_s_miner_solid_01_a_macro, 204, faction.paranid, 'paranid_elite_freighter_crew' ],

                                  [ macro.ship_tel_s_miner_solid_01_a_macro, 219, faction.teladi, 'teladi_elite_freighter_crew' ],
                                  [ macro.ship_tel_s_miner_solid_01_a_macro, 220, faction.teladi, 'teladi_elite_freighter_crew' ],
                                  [ macro.ship_tel_s_miner_solid_01_a_macro, 203, faction.teladi, 'teladi_elite_freighter_crew' ]
                                  ]" />

                <do_all exact="$FleetComposition.count" counter="$m">
                  <create_ship groupname="$NPC_Miners" name="$CurrentShip" macro="$FleetComposition.{$m}.{1}" missioncue="$MissionCue" sector="$MissionSector">
                    <owner exact="$FleetComposition.{$m}.{3}" overridenpc="true"/>
                    <pilot>
                      <select faction="$FleetComposition.{$m}.{3}" tags="tag.traderpilot"/>
                    </pilot>
                    <people ref="$FleetComposition.{$m}.{4}"/>
                    <loadout>
                      <level exact="1.0"/>
                    </loadout>
                    <safepos object="[$OreRefinery, $SiliconRefinery].random" min="15km" max="50km"/>
                  </create_ship>
                  <set_object_name object="$CurrentShip" page="$Page" line="$FleetComposition.{$m}.{2}"/>
                  <!-- Distribute ships equally between the resources. -->
                  <create_order object="$CurrentShip" id="'MiningRoutine_Expert'" default="true">
                    <param name="warebasket" value="[ $ValidWaresList.{(this.$ResourceCounter % $ValidWaresList.count) + 1} ]"/>
                    <param name="range" value="$MissionSector"/>
                  </create_order>
                  <set_value name="this.$ResourceCounter" operation="add"/>
                  <do_if value="$CurrentShip.type == shiptype.largeminer">
                    <add_to_group groupname="$NPC_LargeMiners" object="$CurrentShip"/>
                  </do_if>
                  <do_elseif value="$CurrentShip.docksize == tag.dock_m">
                    <add_to_group groupname="$NPC_MediumMiners" object="$CurrentShip"/>
                  </do_elseif>
                </do_all>
              </actions>
            </library>

            <library name="Setup_Abandoned_Ships">
              <actions>
                <create_position name="$AbandonedMinerPosition" space="$MissionSector" x="68km" y="10km" z="-90km"/>

                <create_ship groupname="$AbandonedMiners" name="$AbandonedMiner" macro="macro.ship_tel_m_miner_solid_01_b_macro" sector="$MissionSector">
                  <owner exact="faction.ownerless" overridenpc="true" />
                  <loadout>
                    <level exact="1.0"/>
                  </loadout>
                  <safepos value="$AbandonedMinerPosition"/>
                  <rotation yaw="45deg" pitch="-15deg" roll="25deg"/>
                </create_ship>

                <add_to_group groupname="global.$IgnoredAbandonedShips" object="$AbandonedMiner"/>
              </actions>
            </library>

            <library name="Setup_Positions">
              <actions>
                <!-- TODO: Define actual Gate positions. If we use Getsu Fune, there's going to be 3 of them. -->
                <create_position name="$SectorEntryPosition_1" x="-25km" z="25km" space="$MissionSector"/>
                <create_position name="$SectorEntryPosition_2" x="25km" z="25km" space="$MissionSector"/>
                <create_position name="$SectorEntryPosition_3" x="0km" z="-35km" space="$MissionSector"/>
                <!-- For this scenario, it makes sense if the attackers only approach from the two northern Gates. -->
                <set_value name="$SectorEntryPositionList" exact="[$SectorEntryPosition_1, $SectorEntryPosition_2, $SectorEntryPosition_3]"/>
              </actions>
            </library>

          </cues>
        </cue>

        <cue name="Start_Scenario">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <cues>

            <!-- This sets the Cause of Death result screen stat when the player is killed. -->
            <cue name="Track_Cause_Of_Death_Ref" ref="md.LIB_Scenario.Track_Cause_Of_Death">
              <param name="SpecifyWeapon" value="true"/>
            </cue>

            <!-- TODO: Cutscene that shows the refineries and the Wharf, and zooms in on the player ship. -->
            <cue name="Intro_Cutscene">
              <actions>
                <play_cutscene result="this.$CutsceneID" key="'OrbitParameterized'">
                  <param name="targetobject" object="$PlayerShip"/>
                  <param name="orbitdist" number="$PlayerShip.size * 2"/>
                  <param name="orbitelevation" number="0.2"/>
                </play_cutscene>
              </actions>
              <cues>

                <cue name="Intro_Cutscene_Fade">
                  <conditions>
                    <event_cue_signalled/>
                    <check_value value="Intro_Cutscene_Stopped.state == cuestate.waiting"/>
                  </conditions>
                  <actions>
                    <fade_screen fadein="1s" fadeout="1s" realtime="true"/>
                  </actions>
                  <delay exact="1s"/>
                  <actions>
                    <stop_cutscene cutscene="parent.$CutsceneID"/>
                  </actions>
                </cue>

                <cue name="Intro_Cutscene_Stopped">
                  <conditions>
                    <event_cutscene_stopped cutscene="parent.$CutsceneID"/>
                  </conditions>
                  <actions>
                    <cancel_cue cue="Intro_Cutscene_Fade"/>
                    <muffle_sound strength="0" duration="0s"/>
                    <blur_screen strength="0" duration="0s"/>
                    <signal_cue cue="Intro_Dialog" check="false"/>
                    <signal_cue cue="Ch1_Mining"/>
                  </actions>
                </cue>

              </cues>
            </cue>

            <cue name="Intro_Dialog_Delay">
              <delay exact="5s"/>
              <actions>
                <signal_cue cue="Intro_Dialog" check="false"/>
              </actions>
            </cue>

            <cue name="Intro_Dialog">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <actions>
                <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130401, $recipient = 'player' ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130402, $recipient = 'player' ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130403, $recipient = 'player' ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130409, $recipient = 'player' ],
                                                                                          ],
                                                                                $callbackcue = Intro_Cutscene_Fade,
                                                                                ]"/>
              </actions>
            </cue>

            <cue name="Ch1_Mining">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <actions>
                <debug_text text="'Starting Chapter 1'" chance="$DebugChance"/>

                <set_value name="$ResourcesCollected" exact="0"/>
                <set_value name="$MissionStartTimeCue" exact="this"/>

                <create_mission cue="$MissionCue" abortable="true"
                                name="{30613,4001}" description="{30613,4003}"
                                difficulty="$Difficulty" type="missiontype.collect" faction="$MissionFaction" 
                                icon="'briefing_mission_director_01'" iconcaption="{30293,102}">
                </create_mission>
                <set_value name="$MissionStep" exact="1"/>
                <include_actions ref="md.Scenario_Mining_LIB.Update_Objective"/>
              </actions>
              <cues>

                <cue name="Ch1_Dialog_Mitsuno_Hack">
                  <delay exact="$DurationUntilHack"/>
                  <actions>
                    <run_actions ref="md.LIB_Scenario.Mitsuno_Play_Next_Hack"/>
                  </actions>
                </cue>

                <cue name="Ch1_Dialog_Xenon_Spotted">
                  <conditions>
                    <event_cue_signalled/>
                  </conditions>
                  <actions>
                    <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130404, $recipient = 'player' ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130405, $recipient = 'player' ],
                                                                                          ]
                                                                                ]"/>
                  </actions>
                </cue>

                <cue name="Ch1_Timer">
                  <delay exact="$DurationUntilAttack"/>
                  <actions>
                    <signal_cue cue="Ch1_Enemy_Attack"/>
                    <include_actions ref="md.Scenario_Mining_LIB.Update_Objective"/>
                  </actions>
                  <delay exact="$MissionDuration - $DurationUntilAttack"/>
                  <actions>
                    <signal_cue_instantly cue="Ch1_Finished" param="'timeout'"/>
                  </actions>
                </cue>

                <cue name="Ch1_Enemy_Attack">
                  <conditions>
                    <event_cue_signalled/>
                  </conditions>
                  <actions>
                    <!-- Spawn enemies to attack all NPC miners. After an enemy group has destroyed their target, they are allowed to attack the player. -->
                    <do_for_each in="$NPC_Miners" name="$CurrentTarget" counter="$i">
                      <run_actions ref="md.LIB_Generic.Spawn_Attack_Wave" result="$AttackWave">
                        <param name="AttackTarget"          value="$CurrentTarget"/>
                        <param name="Faction"               value="faction.xenon"/>
                        <param name="MissionCue"            value="$MissionCue"/>
                        <param name="Sector"                value="$MissionSector"/>
                        <param name="Composition"           value="if $NPC_LargeMiners.indexof.{$CurrentTarget} then
                                                                   [ [ macro.ship_xen_m_fighter_01_a_macro, 1 ],
                                                                     [ macro.ship_xen_s_fighter_01_a_macro, 2 ],
                                                                     [ macro.ship_xen_s_fighter_02_a_macro, 2 ] ]
                                                                   else if $NPC_MediumMiners.indexof.{$CurrentTarget} then
                                                                   [ [ macro.ship_xen_s_fighter_01_a_macro, 2 ] ]
                                                                   else
                                                                   [ [ macro.ship_xen_s_fighter_01_a_macro, 1 ] ]"/>
                        <param name="SpawnPosition"         value="$SectorEntryPositionList.{($i % $SectorEntryPositionList.count) + 1}"/>
                        <param name="AllowOtherTargets"     value="false"/>
                        <param name="Assignment"            value="assignment.attack"/>
                      </run_actions>
                    </do_for_each>

                    <set_value name="$AttackCounter" exact="1"/>

                    <signal_cue cue="Ch1_Dialog_Xenon_Spotted" check="false"/>
                  </actions>
                  <cues>

                    <cue name="Ch1_Enemy_Attack_Player_Loop">
                      <actions>
                        <run_actions ref="md.LIB_Generic.Spawn_Attack_Wave" result="$AttackWave">
                          <param name="AttackTarget"          value="player.ship"/>
                          <param name="Faction"               value="faction.xenon"/>
                          <param name="MissionCue"            value="$MissionCue"/>
                          <param name="Sector"                value="$MissionSector"/>
                          <param name="Composition"           value="[ [ macro.ship_xen_s_fighter_01_a_macro, 1 ] ]"/>
                          <param name="SpawnPosition"         value="$SectorEntryPositionList.{($AttackCounter % $SectorEntryPositionList.count) + 1}"/>
                          <param name="AllowOtherTargets"     value="false"/>
                          <param name="Assignment"            value="assignment.attack"/>
                        </run_actions>
                        <add_to_group groupname="$DedicatedEnemyShips" group="$AttackWave"/>
                      </actions>
                      <delay exact="50s"/>
                      <actions>
                        <set_value name="$AttackCounter" operation="add"/>
                        <reset_cue cue="this"/>
                      </actions>
                    </cue>

                    <!-- Once the dedicated player enemies have hit the player once, they can be distracted. -->
                    <cue name="Ch1_Enemy_Attack_Allow_Other_Targets" instantiate="true">
                      <conditions>
                        <event_object_attacked group="global.$PlayerContainerGroup"/>
                        <check_value value="$DedicatedEnemyShips.indexof.{event.param}"/>
                      </conditions>
                      <actions>
                        <edit_order_param order="event.param.order" param="'allowothertargets'" value="true"/>
                        <remove_from_group group="$DedicatedEnemyShips" object="event.param"/>
                      </actions>
                    </cue>

                  </cues>
                </cue>

                <cue name="Ch1_Register_Ore_Collection" instantiate="true">
                  <conditions>
                    <event_player_owned_collected_resource comment="Also works if the player picks something up"/>
                    <check_value value="$ValidWaresList.indexof.{event.param}"/>
                  </conditions>
                  <actions>
                    <set_value name="$ResourcesCollected" exact="event.param2" operation="add"/>

                    <include_actions ref="md.Scenario_Mining_LIB.Update_Objective"/>
                  </actions>
                </cue>

                <cue name="Ch1_Register_Ore_Drop" instantiate="true">
                  <conditions>
                    <event_player_owned_dropped_objects/>
                  </conditions>
                  <actions>
                    <run_actions ref="md.Scenario_Mining_LIB.On_Player_Ware_Drop" result="$DroppedAmount">
                      <param name="DropList" value="event.param2"/>
                      <param name="ValidWaresList" value="$ValidWaresList"/>
                    </run_actions>
                    <do_if value="$DroppedAmount">
                      <debug_text text="'Player owned dropped ' + $DroppedAmount + ' units of cargo'" chance="$DebugChance"/>
                      <set_value name="$ResourcesCollected" operation="subtract" exact="$DroppedAmount"/>
                      <include_actions ref="md.Scenario_Mining_LIB.Update_Objective"/>
                    </do_if>
                  </actions>
                </cue>

                <cue name="Ch1_Register_Player_Attack">
                  <conditions>
                    <event_object_attacked group="global.$PlayerContainerGroup"/>
                  </conditions>
                  <actions>
                    <set_value name="$PlayerAttacked"/>
                    <include_actions ref="md.Scenario_Mining_LIB.Update_Objective"/>
                  </actions>
                </cue>

                <cue name="Ch1_Register_New_Player_Miner" instantiate="true">
                  <conditions>
                    <event_object_changed_owner group="$AbandonedMiners" owner="faction.player"/>
                  </conditions>
                  <actions>
                    <add_to_group groupname="$Player_Miners" object="event.object"/>
                  </actions>
                </cue>

                <!-- This creates the variable $HighestAsteroidYield in $MissionCue. -->
                <cue name="Ch1_Track_Highest_Asteroid_Yield_Ref" ref="md.Scenario_Mining_LIB.Track_Highest_Asteroid_Yield">
                  <param name="ValidWaresList" value="$ValidWaresList"/>
                  <param name="MissionCue"     value="$MissionCue"/>
                </cue>

                <!-- This creates the variable $MiningNodesDestroyed in $MissionCue. -->
                <cue name="Ch1_Track_Mining_Nodes_Destroyed_Ref" ref="md.Scenario_Mining_LIB.Track_Mining_Nodes_Destroyed">
                  <param name="MissionCue"     value="$MissionCue"/>
                </cue>

                <!-- This creates the variable $FastestRunTime in $MissionCue, unless no run is finished before the mission ends.-->
                <cue name="Ch1_Track_Fastest_Run_Ref" ref="md.Scenario_Mining_LIB.Track_Fastest_Run">
                  <param name="MissionCue"     value="$MissionCue"/>
                </cue>

                <cue name="Ch1_Drain_Ore_Refinery_Ref" ref="md.Scenario_Mining_LIB.Drain_Station">
                  <param name="Station" value="$OreRefinery"/>
                  <param name="Ware"    value="ware.ore"/>
                </cue>

                <cue name="Ch1_Drain_Silicon_Refinery_Ref" ref="md.Scenario_Mining_LIB.Drain_Station">
                  <param name="Station" value="$SiliconRefinery"/>
                  <param name="Ware"    value="ware.silicon"/>
                </cue>

                <cue name="Ch1_Drain_Funanori_Ore_Ref" ref="md.Scenario_Mining_LIB.Drain_Station">
                  <param name="Station" value="$MegaStation"/>
                  <param name="Ware"    value="ware.ore"/>
                </cue>

                <cue name="Ch1_Drain_Funanori_Silicon_Ref" ref="md.Scenario_Mining_LIB.Drain_Station">
                  <param name="Station" value="$MegaStation"/>
                  <param name="Ware"    value="ware.silicon"/>
                </cue>

                <cue name="Ch1_All_Miners_Destroyed">
                  <conditions>
                    <event_object_destroyed group="$Player_Miners"/>
                    <check_value value="$Player_Miners.count == 1"/>
                  </conditions>
                  <delay exact="5s"/>
                  <actions>
                    <signal_cue_instantly cue="Ch1_Finished" param="'all_miners_destroyed'"/>
                  </actions>
                </cue>

                <cue name="Ch1_Finished">
                  <conditions>
                    <check_any>
                      <event_object_destroyed object="player.entity"/>
                      <event_cue_signalled/>
                    </check_any>
                  </conditions>
                  <actions>
                    <!-- Adjust these to tweak the bonus scores. -->
                    <set_value name="$PointsPerMiningNode" exact="40"/>
                    <set_value name="$TargetTime" exact="180s"/>
                    <set_value name="$PointsPerSecond" exact="6"/>
                    <set_value name="$AsteroidYieldPerPoint" exact="5"/>

                    <do_if value="event.name == 'event_object_destroyed'">
                      <do_for_each in="$ValidWaresList" name="$CurrentWare">
                        <set_value name="$ResourcesCollected" exact="player.ship.cargo.{$CurrentWare}.count" operation="subtract"/>
                      </do_for_each>
                    </do_if>

                    <set_value name="$ResourcesCollectedScore" exact="$ResourcesCollected"/>
                    <set_value name="$MiningNodesDestroyedScore" exact="$MiningNodesDestroyed * $PointsPerMiningNode"/>
                    <set_value name="$FastestRunScore" exact="if $FastestRunTime? then [($TargetTime - ($FastestRunTime)s)i * $PointsPerSecond, 0].max else 0"/>
                    <do_if value="not $FastestRunTime?">
                      <set_value name="$FastestRunTime" exact="0s"/>
                    </do_if>
                    <set_value name="$HighestAsteroidYieldScore" exact="$HighestAsteroidYield / $AsteroidYieldPerPoint"/>

                    <substitute_text text="$MiningNodesDestroyedDescription" source="{30613,2105}">
                      <replace string="'$NUMBER$'" with="$PointsPerMiningNode"/>
                    </substitute_text>
                    <substitute_text text="$FastestRunDescription" source="{30613,2110}">
                      <replace string="'$NUMBER$'" with="$PointsPerSecond"/>
                      <replace string="'$TIME$'" with="$TargetTime.formatted.{'%m:%S'}"/>
                    </substitute_text>
                    <substitute_text text="$HighestAsteroidYieldDescription" source="{30613,2109}">
                      <replace string="'$NUMBER$'" with="$AsteroidYieldPerPoint"/>
                    </substitute_text>

                    <add_scenario_stat id="'resources_collected'" name="{30613,3102}" uivalue="$ResourcesCollected" description="{30613,3103}" score="$ResourcesCollectedScore" maxscore="4900"/>
                    <add_scenario_stat id="'mining_nodes_destroyed'" name="{30613,2104}" uivalue="$MiningNodesDestroyed" description="$MiningNodesDestroyedDescription" score="$MiningNodesDestroyedScore" maxscore="$PointsPerMiningNode * 5"/>
                    <add_scenario_stat id="'fastest_run'" name="{30613,2106}" uivalue="$FastestRunTime.formatted.{'%m:%S'}" description="$FastestRunDescription" score="$FastestRunScore" maxscore="474"/>
                    <add_scenario_stat id="'highest_asteroid_yield'" name="{30613,2108}" uivalue="$HighestAsteroidYield" description="$HighestAsteroidYieldDescription" score="$HighestAsteroidYieldScore" maxscore="1000"/>

                    <set_value name="$ResultData.$PlayerDied" exact="event.name == 'event_object_destroyed'"/>
                    <set_value name="$ResultData.$Score" exact="$ResourcesCollectedScore + $MiningNodesDestroyedScore + $FastestRunScore + $HighestAsteroidYieldScore"/>

                    <do_if value="(event.name == 'event_cue_signalled') and ($ResultData.$Score ge player.allmodules.{player.module}.score.{1})">
                      <remove_mission cue="$MissionCue" type="completed"/>
                    </do_if>
                    <do_else>
                      <remove_mission cue="$MissionCue" type="failed"/>
                    </do_else>

                    <do_if value="event.name != 'event_object_destroyed'">
                      <do_if value="$ResultData.$Score ge player.allmodules.{player.module}.score.{4}">
                        <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130408, $recipient = 'player', $monitor = false ],
                                                                                          ],
                                                                                $callbackcue = ResultWindow,
                                                                                $abortcallbackcue = ResultWindow
                                                                                ]"/>
                      </do_if>
                      <do_elseif value="$ResultData.$Score ge player.allmodules.{player.module}.score.{1}">
                        <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130407, $recipient = 'player', $monitor = false ],
                                                                                          ],
                                                                                $callbackcue = ResultWindow,
                                                                                $abortcallbackcue = ResultWindow
                                                                                ]"/>
                      </do_elseif>
                      <do_else>
                        <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130406, $recipient = 'player', $monitor = false ],
                                                                                          ],
                                                                                $callbackcue = ResultWindow,
                                                                                $abortcallbackcue = ResultWindow
                                                                                ]"/>
                      </do_else>
                    </do_if>
                    <do_else>
                      <signal_cue cue="ResultWindow"/>
                    </do_else>

                    <cancel_cue cue="Ch1_Mining"/>
                  </actions>
                </cue>

              </cues>
            </cue>

            <!--These cues handle the briefing presentations e.g. Holomap or cutscene render targets (depending on the mission)-->
            <cue name="BriefingStarted">
              <conditions>
                <check_any>
                  <event_briefing_started cue="$MissionCue"/>
                  <event_briefing_submission_selected cue="$MissionCue"/>
                </check_any>
              </conditions>
              <actions>
                <set_value name="$RenderTarget" exact="event.param.{1}"/>

                <debug_text text="'Briefing started'" chance="$DebugChance"/>
              </actions>
              <cues>

                <cue name="DisplayCutscene" onfail="cancel">
                  <conditions>
                    <check_value value="$BriefingCutsceneStarted?"/>
                  </conditions>
                  <actions>
                    <play_cutscene result="$BriefingCutscene" key="'OrbitParameterized'">
                      <param name="targetobject" object="$OreRefinery"/>
                      <param name="orbitdist" number="0.3"/>
                      <param name="orbitelevation" number="0.0"/>
                    </play_cutscene>
                  </actions>
                </cue>

                <cue name="BriefingStopped">
                  <conditions>
                    <check_any>
                      <event_briefing_cancelled cue="$MissionCue"/>
                      <event_briefing_submission_unselected cue="$MissionCue"/>
                    </check_any>
                  </conditions>
                  <actions>
                    <stop_cutscene key="$BriefingCutscene"/>

                    <debug_text text="'Briefing cancelled'" chance="$DebugChance"/>
                    <reset_cue cue="BriefingStarted"/>
                  </actions>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

        <cue name="ResultWindow" comment="Scenario Ended (Failure or Success Case)">
          <!-- set data when you die or finish a mission in the failure or success case -->
          <!-- game is force paused -->
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <cues>
            <cue name="Finished_Ref" ref="md.LIB_Scenario.ScenarioFinished">
              <param name="ResultData" value="$ResultData"/>
            </cue>
          </cues>
        </cue>

      </cues>
    </cue>

  </cues>
</mdscript>
