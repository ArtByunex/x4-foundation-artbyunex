<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Scenario_Mining_1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <documentation>
    <author name="Lennart Funk"/>
  </documentation>
  <cues>

    <!-- You're a miner working for an L mining ship.
         A Xenon scout destroyed the mining drones, so you have to deliver the rest of the ice as quickly as possible to fill up the L miner. -->
    <cue name="Start" namespace="this" module="scenario_mining_1">
      <conditions>
        <event_game_started/>
      </conditions>
      <actions>
        <include_actions ref="md.LIB_Scenario.ScenarioStarted"/>

        <set_value name="$DebugChance"         exact="100"/>
        <set_value name="$DeepDebugChance"     exact="0"/>
        <set_value name="$MissionCue"          exact="namespace"/>

        <set_value name="$Page"                exact="30613"/>
        <set_value name="$Difficulty"          exact="level.veryeasy"/>
        <set_value name="$MissionFaction"      exact="faction.civilian"/>
        <find_sector name="$MissionSector"     macro="macro.timelines_map_mining_1_cluster_001_sector_001_macro"/>
        <set_value name="$ResultData" exact="table[]"/>

        <set_value name="$HasError"            exact="false" comment="will be set true if any setup fails"/>

        <debug_text text="'Initialising Scenario:' + $Page" chance="$DebugChance"/>

        <!-- Table that will be filled with all actors with active speaking roles -->
        <set_value name="$MissionActors" exact="table[]"/>

        <!-- Custom Scenario-Related variables -->
        <set_value name="$ValidWaresList"   exact="[ware.ice]"/>
        <set_value name="$TargetWareAmount" exact="250"/>
        <set_owner object="$MissionSector" faction="faction.ownerless"/>

        <!-- Since score thresholds have to be defined in ascending order in gamestarts.xml we have to set a "fail" time, where the player's score drops to 0 stars.
             The score defined in gamestarts.xml is how many seconds the player has to go under the fail time to get each star.
             Also translate the score to a time format, for easier use. -->
        <set_value name="$FailDelay" exact="160s" comment="This has to be longer than the 5 star score time, else the calculation doesn't work"/>

        <set_value name="$ScoreDelay_5" exact="(player.allmodules.{player.module}.score.{5})s"/>
        <set_value name="$ScoreDelay_4" exact="(player.allmodules.{player.module}.score.{4})s"/>
        <set_value name="$ScoreDelay_3" exact="(player.allmodules.{player.module}.score.{3})s"/>
        <set_value name="$ScoreDelay_2" exact="(player.allmodules.{player.module}.score.{2})s"/>
        <set_value name="$ScoreDelay_1" exact="(player.allmodules.{player.module}.score.{1} - 1)s" comment="The lowest score in gamestarts.xml can't be 0, so it's 1, so we reduce it by 1 here to make it look nicer."/>

        <!-- Disable generic missions -->
        <set_value name="md.GenericMissions.Manager.$Disabled" exact="true"/>
        <!-- Create Resource Areas -->
        <create_resource_area yieldname="'sphere_medium_ice_medium_average'" sector="$MissionSector">
          <position x="140000" y="50" z="55000" />
        </create_resource_area>
        <create_resource_area yieldname="'sphere_large_silicon_low_average'" sector="$MissionSector">
          <position x="140000" y="50" z="55000" />
        </create_resource_area>
        <create_resource_area yieldname="'sphere_large_ore_verylow_average'" sector="$MissionSector">
          <position x="140000" y="50" z="55000" />
        </create_resource_area>
      </actions>
      <cues>

        <cue name="DEBUG_Print_Player_Position" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <create_position name="this.$pos" object="player.ship" space="player.sector"/>
            <debug_text text="this.$pos"/>
          </actions>
        </cue>

        <cue name="DEBUG_Print_Target_Position" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <create_position name="this.$pos" object="player.target" space="player.sector"/>
            <debug_text text="this.$pos"/>
          </actions>
        </cue>

        <cue name="Setup_Scenario">
          <cues>

            <cue name="Call_Setup_Libraries">
              <actions>
                <include_actions ref="Setup_Player" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Player_Property" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Actors" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Stations" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_NPC_Ships" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Abandoned_Ships" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_Positions" chance="if $HasError then 0 else 100"/>
                <run_actions ref="md.LIB_Scenario.Setup_Faction_ParanidEmpire" chance="if $HasError then 0 else 100"/>

                <set_value name="$HasError" exact="0"/>

                <!--If there was an error, signal the CleanUp cue, otherwise signal the scenario to start-->
                <do_if value="$HasError">
                  <signal_cue cue="CleanUp"/>
                </do_if>
                <do_else>
                  <debug_text text="'Scenario has been successfully set up and can start'" chance="$DebugChance"/>
                  <signal_cue cue="Start_Scenario"/>
                </do_else>
              </actions>
            </cue>

            <library name="Setup_Player">
              <actions>
                <set_emergency_eject_active active="false"/>
                <do_if value="not player.exists">
                  <debug_text text="'Player does not exist'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>
              </actions>
            </library>

            <library name="Setup_Player_Property">
              <actions>
                <find_ship_by_true_owner name="$PlayerShip" faction="faction.player" space="$MissionSector"/>

                <do_if value="not $PlayerShip.exists">
                  <debug_text text="'$PlayerShip not found'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>
              </actions>
            </library>

            <library name="Setup_Stations">
              <actions>
                <!-- Refineries haven't been built yet. -->
                <set_value name="$RemovedStationEntries" exact="[ 'scenario_mining_1to4_ore_refinery_001',
                                                                  'scenario_mining_1to4_ore_refinery_002',
                                                                  'scenario_mining_1to4_silicon_refinery_001' ]"/>

                <do_for_each in="$RemovedStationEntries" name="$CurrentEntry">
                  <find_station name="$Station" godstationentry="$CurrentEntry" space="$MissionSector"/>
                  <do_if value="$Station">
                    <destroy_object object="$Station" explosion="false"/>
                  </do_if>
                </do_for_each>
              </actions>
            </library>

            <library name="Setup_Actors">
              <actions>
                <create_cue_actor name="$MinerActor" cue="$MissionCue" macro="character_timelines_scenario_mining_seasoned_miner_macro">
                  <page exact="10136"/>
                  <owner exact="faction.civilian"/>
                </create_cue_actor>
                <set_entity_traits entity="$MinerActor" missionactor="true" customhandler="true" subtitlename="true"/>
                <set_entity_overrides entity="$MinerActor" icon="'pilot'"/>

                <!-- NPC Usecase Setup. Klaus' recommendations:
                         - use $recipient = 'player' in the usecase when we really want to show a monitor cutscene, instead of a general $forceonplayer in the monitor settings
                         - don't use $ignoredistance, unless we want a monitor cutscene even if the player is in the same room as the NPC -->
                <set_value name="$MissionActors.$MinerActor" exact="table[
                                              $entity = $MinerActor,
                                              $monitor = table[
                                                $cutscenekey = 'ShowNPCFace',
                                                $caption = true
                                              ]
                                            ]"/>
              </actions>
              <delay exact="0.5s"/>
              <actions>
                <signal_cue_instantly cue="md.Setup.AddStoryMentor" param="table[$story=$MissionCue, $actor=$MinerActor]"/>
              </actions>
            </library>

            <library name="Setup_NPC_Ships">
              <actions>
                <find_ship name="$MiningBaseShip" macro="macro.ship_par_l_miner_solid_02_a_macro" space="$MissionSector"/>

                <do_if value="$MiningBaseShip">
                  <add_cargo object="$MiningBaseShip" ware="$ValidWaresList.{1}" exact="$MiningBaseShip.cargo.{$ValidWaresList.{1}}.free - $TargetWareAmount"/>

                  <create_order object="$MiningBaseShip" id="'Wait'" default="true">
                    <param name="noattackresponse" value="true"/>
                  </create_order>

                  <set_object_name object="$MiningBaseShip" page="$Page" line="227"/>

                  <find_object_component name="$MiningBaseShipTurrets" object="$MiningBaseShip" multiple="true" class="class.turret" />
                  <do_for_each in="$MiningBaseShipTurrets" name="$CurrentTurret">
                    <set_weapon_mode weapon="$CurrentTurret" weaponmode="weaponmode.attackfighters"/>
                  </do_for_each>

                  <set_value name="$DroneWreckPositions" exact="[ position.[-800m, 2000m,  500m],
                                                                  position.[-100m, 1000m, -500m],
                                                                  position.[ 500m, -200m,  100m],
                                                                  position.[ 200m,  300m, 1000m] ]"/>
                  <do_for_each in="$DroneWreckPositions" name="$CurrentPosition">
                    <create_ship name="$DroneWreck" macro="macro.ship_gen_s_miningdrone_solid_01_a_macro" sector="$MissionSector" state="componentstate.wreck">
                      <owner exact="faction.argon" overridenpc="true"/>
                      <pilot>
                        <select race="race.drone" tags="tag.aipilot"/>
                      </pilot>
                      <safepos object="$MiningBaseShip" value="$CurrentPosition"/>
                      <rotation pitch="[0deg,360deg].randominrange" yaw="[0deg,360deg].randominrange"/>
                    </create_ship>
                    <!--<set_object_commander object="$DroneWreck" commander="$MiningBaseShip" assignment="assignment.mining"/>-->
                  </do_for_each>
                </do_if>
                <do_else>
                  <debug_text text="'$MiningBaseShip was not found'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_else>

              </actions>
            </library>

            <library name="Setup_Abandoned_Ships">
              <actions>
              </actions>
            </library>

            <library name="Setup_Positions">
              <actions>
              </actions>
            </library>

          </cues>
        </cue>

        <cue name="Start_Scenario">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <cues>

            <!-- This sets the Cause of Death result screen stat when the player is killed. -->
            <cue name="Track_Cause_Of_Death_Ref" ref="md.LIB_Scenario.Track_Cause_Of_Death">
              <param name="SpecifyWeapon" value="true"/>
            </cue>

            <!-- TODO: Cutscene that shows the Xenon S ship destroying a drone, getting blown up itself, and then zooms in on the player ship on the dock. -->
            <cue name="Intro_Cutscene">
              <actions>
                <play_cutscene result="this.$CutsceneID" key="'OrbitParameterized'">
                  <param name="targetobject" object="$MiningBaseShip"/>
                  <param name="orbitdist" number="$MiningBaseShip.size * 2"/>
                  <param name="orbitelevation" number="0.2"/>
                </play_cutscene>
              </actions>
              <cues>

                <cue name="Intro_Cutscene_Spawn_Ships">
                  <actions>
                    <create_ship name="$IntroCutsceneDrone" macro="macro.ship_gen_s_miningdrone_solid_01_a_macro" sector="$MissionSector">
                      <owner exact="faction.argon" overridenpc="true"/>
                      <pilot>
                        <select race="race.drone" tags="tag.aipilot"/>
                      </pilot>
                      <position object="$MiningBaseShip" x="-1km" y="500m" z="0"/>
                    </create_ship>
                    <set_object_commander object="$IntroCutsceneDrone" commander="$MiningBaseShip" assignment="assignment.mining"/>

                    <create_ship name="$IntroCutsceneScout" macro="macro.ship_xen_s_fighter_01_a_macro" sector="$MissionSector">
                      <owner exact="faction.xenon" overridenpc="true"/>
                      <pilot>
                        <select race="race.xenon" tags="tag.fighterpilot"/>
                      </pilot>
                      <orientation refobject="$IntroCutsceneDrone" orientation="look_at"/>
                      <position object="$MiningBaseShip" x="1km" y="500m" z="0"/>
                    </create_ship>
                    <create_order object="$IntroCutsceneScout" id="'Attack'">
                      <param name="primarytarget" value="$IntroCutsceneDrone"/>
                    </create_order>
                  </actions>
                  <delay exact="4s"/>
                  <actions>
                    <destroy_object object="$IntroCutsceneDrone" explosion="true"/>
                  </actions>
                  <delay exact="5.5s"/>
                  <actions>
                    <destroy_object object="$IntroCutsceneScout" explosion="true"/>
                  </actions>
                </cue>

                <cue name="Intro_Cutscene_Fade">
                  <conditions>
                    <event_cue_signalled/>
                    <check_value value="Intro_Cutscene_Stopped.state == cuestate.waiting"/>
                  </conditions>
                  <actions>
                    <fade_screen fadein="1s" fadeout="1s" realtime="true"/>
                  </actions>
                  <delay exact="1s"/>
                  <actions>
                    <stop_cutscene cutscene="parent.$CutsceneID"/>
                  </actions>
                </cue>

                <cue name="Intro_Cutscene_Stopped">
                  <conditions>
                    <event_cutscene_stopped cutscene="parent.$CutsceneID"/>
                  </conditions>
                  <actions>
                    <cancel_cue cue="Intro_Cutscene_Fade"/>
                    <muffle_sound strength="0" duration="0s"/>
                    <blur_screen strength="0" duration="0s"/>
                    <signal_cue cue="Intro_Dialog" check="false"/>
                    <signal_cue cue="Ch1_Mining"/>
                  </actions>
                </cue>

              </cues>
            </cue>

            <cue name="Intro_Dialog_Delay">
              <delay exact="5s"/>
              <actions>
                <signal_cue cue="Intro_Dialog" check="false"/>
              </actions>
            </cue>

            <cue name="Intro_Dialog">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <actions>
                <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130101, $recipient = 'player' ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130102, $recipient = 'player' ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130103, $recipient = 'player' ],
                                                                                          ],
                                                                                $callbackcue = Intro_Cutscene_Fade,
                                                                                ]"/>
              </actions>
            </cue>

            <cue name="Ch1_Mining">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <actions>
                <debug_text text="'Starting Chapter 1'" chance="$DebugChance"/>

                <create_trade_offer name="$TradeOffer" buyer="$MiningBaseShip" object="$MiningBaseShip" ware="$ValidWaresList.{1}" amount="$TargetWareAmount" price="0Cr" virtualmoney="true" playeronly="true" missioncue="$MissionCue" virtual="false"/>

                <set_value name="$StartTime" exact="player.age"/>
                <set_value name="$FailTime" exact="$StartTime + $FailDelay"/>
                <set_value name="$ScoreTime_5" exact="$FailTime - $ScoreDelay_5"/>
                <set_value name="$ScoreTime_4" exact="$FailTime - $ScoreDelay_4"/>
                <set_value name="$ScoreTime_3" exact="$FailTime - $ScoreDelay_3"/>
                <set_value name="$ScoreTime_2" exact="$FailTime - $ScoreDelay_2"/>
                <set_value name="$ScoreTime_1" exact="$FailTime - $ScoreDelay_1"/>

                <create_mission cue="$MissionCue" abortable="true"
                                name="{30613,1001}" description="{30613,1004}"
                                difficulty="$Difficulty" type="missiontype.collect" faction="$MissionFaction"
                                icon="'briefing_mission_director_01'" iconcaption="{30293,102}">
                </create_mission>
                <set_value name="$MissionStep" exact="1"/>
              </actions>
              <cues>

                <cue name="Ch1_Timer">
                  <actions>
                    <include_actions ref="Update_Objective"/>
                  </actions>
                  <delay exact="$FailDelay - $ScoreDelay_5"/>
                  <actions>
                    <include_actions ref="Update_Objective"/>
                  </actions>
                  <delay exact="$ScoreDelay_5 - $ScoreDelay_4"/>
                  <actions>
                    <include_actions ref="Update_Objective"/>
                  </actions>
                  <delay exact="$ScoreDelay_4 - $ScoreDelay_3"/>
                  <actions>
                    <include_actions ref="Update_Objective"/>
                  </actions>
                  <delay exact="$ScoreDelay_3 - $ScoreDelay_2"/>
                  <actions>
                    <include_actions ref="Update_Objective"/>
                  </actions>
                  <delay exact="$ScoreDelay_2 - $ScoreDelay_1"/>
                  <actions>
                    <include_actions ref="Update_Objective"/>
                  </actions>
                </cue>

                <library name="Update_Objective">
                  <actions>
                    <do_if value="player.age lt $FailTime">
                      <!--TODO @Owen @Lennart escape the ( ) brackets when importing to the text DB-->
                      <substitute_text text="$ObjectiveText" source="{30613,1011}">
                        <replace string="'$AMOUNT$'" with="$MiningBaseShip.cargo.{$ValidWaresList.{1}}.free"/>
                        <replace string="'$WARE$'"         with="$ValidWaresList.{1}"/>
                        <replace string="'$TARGETTIME$'"    with="if (player.age lt $ScoreTime_5) then $ScoreDelay_5.formatted.{'%m:%S'}
                                                             else if (player.age lt $ScoreTime_4) then $ScoreDelay_4.formatted.{'%m:%S'}
                                                             else if (player.age lt $ScoreTime_3) then $ScoreDelay_3.formatted.{'%m:%S'}
                                                             else if (player.age lt $ScoreTime_2) then $ScoreDelay_2.formatted.{'%m:%S'}
                                                             else $ScoreDelay_1.formatted.{'%m:%S'}"/>
                        <replace string="'$SCORE$'"         with="if (player.age lt $ScoreTime_5) then {30613,305}
                                                             else if (player.age lt $ScoreTime_4) then {30613,304}
                                                             else if (player.age lt $ScoreTime_3) then {30613,303}
                                                             else if (player.age lt $ScoreTime_2) then {30613,302}
                                                             else {30613,301}"/>
                      </substitute_text>
                    </do_if>
                    <do_else>
                      <substitute_text text="$ObjectiveText" source="{30613,1012}">
                        <replace string="'$AMOUNT$'"        with="$MiningBaseShip.cargo.{$ValidWaresList.{1}}.free"/>
                        <replace string="'$WARE$'"          with="$ValidWaresList.{1}"/>
                      </substitute_text>
                    </do_else>

                    <set_objective cue="$MissionCue" step="$MissionStep" action="objective.custom" customaction="$ObjectiveText" object="$MiningBaseShip" updatebriefing="true" endtime="$FailTime"/>
                  </actions>
                </library>

                <cue name="Ch1_Trade_Order_Started" instantiate="true">
                  <conditions>
                    <event_trade_started tradeoffer="$TradeOffer"/>
                  </conditions>
                  <actions>
                    <set_value name="this.$tradeorder" exact="event.param2"/>
                    <set_value name="this.$tradeorder_buyer" exact="event.param2.buyer"/>
                    <set_value name="this.$tradeorder_seller" exact="event.param2.seller"/>
                  </actions>
                  <cues>

                    <cue name="Ch1_Trade_Order_Completed">
                      <conditions>
                        <event_trade_completed seller="parent.$tradeorder_seller" buyer="parent.$tradeorder_buyer"/>
                        <check_value value="event.param == parent.$tradeorder"/>
                      </conditions>
                      <actions>
                        <include_actions ref="Update_Objective"/>
                      </actions>
                    </cue>

                  </cues>
                </cue>

                <cue name="Ch1_Register_Final_Dock">
                  <conditions>
                    <event_object_docking_started group="global.$PlayerContainerGroup" dock="$MiningBaseShip"/>
                    <check_value value="event.object.cargo.{$ValidWaresList.{1}}.count ge ($MiningBaseShip.cargo.{$ValidWaresList.{1}}.free)"/>
                  </conditions>
                  <actions>
                    <signal_cue cue="Ch1_Finished"/>
                  </actions>
                </cue>

                <cue name="Ch1_Finished">
                  <conditions>
                    <check_any>
                      <event_object_destroyed object="player.entity"/>
                      <event_cue_signalled/>
                    </check_any>
                  </conditions>
                  <actions>
                    <do_if value="(event.name != 'event_object_destroyed') and (player.age lt $FailTime)">
                      <set_value name="$TimeScore" exact="($FailTime - player.age)i"/>
                    </do_if>
                    <do_else>
                      <set_value name="$TimeScore" exact="0"/>
                    </do_else>

                    <add_scenario_stat id="'time_score'" name="{30600,3031}" uivalue="($FailTime - player.age).formatted.{'%m:%S'}" description="{30613,1102}" score="$TimeScore" maxscore="player.allmodules.{player.module}.score.{5}"/>

                    <set_value name="$ResultData.$PlayerDied" exact="event.name == 'event_object_destroyed'"/>
                    <set_value name="$ResultData.$Score" exact="$TimeScore"/>

                    <do_if value="(event.name == 'event_cue_signalled') and ($ResultData.$Score ge player.allmodules.{player.module}.score.{1})">
                      <remove_mission cue="$MissionCue" type="completed"/>
                    </do_if>
                    <do_else>
                      <remove_mission cue="$MissionCue" type="failed"/>
                    </do_else>

                    <do_if value="event.name != 'event_object_destroyed'">
                      <do_if value="$ResultData.$Score ge player.allmodules.{player.module}.score.{4}">
                        <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130108, $recipient = 'player', $monitor = false ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130109, $recipient = 'player', $monitor = false ],
                                                                                          ],
                                                                                $callbackcue = ResultWindow,
                                                                                $abortcallbackcue = ResultWindow
                                                                                ]"/>
                      </do_if>
                      <do_elseif value="$ResultData.$Score ge player.allmodules.{player.module}.score.{1}">
                        <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130106, $recipient = 'player', $monitor = false ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130107, $recipient = 'player', $monitor = false ],
                                                                                          ],
                                                                                $callbackcue = ResultWindow,
                                                                                $abortcallbackcue = ResultWindow
                                                                                ]"/>
                      </do_elseif>
                      <do_else>
                        <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                                                                $caller = this, $preset = '$plotlike', $actors = $MissionActors, $nofullscreenmenu = false, $debugchance = $DeepDebugChance,
                                                                                $script = [
                                                                                          table[ $actor = '$MinerActor', $speak = 306130104, $recipient = 'player', $monitor = false ],
                                                                                          table[ $actor = '$MinerActor', $speak = 306130105, $recipient = 'player', $monitor = false ],
                                                                                          ],
                                                                                $callbackcue = ResultWindow,
                                                                                $abortcallbackcue = ResultWindow
                                                                                ]"/>
                      </do_else>
                    </do_if>
                    <do_else>
                      <signal_cue cue="ResultWindow"/>
                    </do_else>

                    <cancel_cue cue="Ch1_Mining" comment="Stop the attempted objective updates"/>
                  </actions>
                </cue>

              </cues>
            </cue>

            <!--These cues handle the briefing presentations e.g. Holomap or cutscene render targets (depending on the mission)-->
            <cue name="BriefingStarted">
              <conditions>
                <check_any>
                  <event_briefing_started cue="$MissionCue"/>
                  <event_briefing_submission_selected cue="$MissionCue"/>
                </check_any>
              </conditions>
              <actions>
                <set_value name="$RenderTarget" exact="event.param.{1}"/>

                <debug_text text="'Briefing started'" chance="$DebugChance"/>
              </actions>
              <cues>

                <cue name="DisplayCutscene" onfail="cancel">
                  <conditions>
                    <check_value value="$MiningBaseShip.isoperational"/>
                  </conditions>
                  <actions>
                    <play_cutscene result="$BriefingCutscene" key="'OrbitParameterized'" rendertarget="$RenderTarget">
                      <param name="targetobject" object="$MiningBaseShip"/>
                      <param name="orbitdist" number="$MiningBaseShip.size * 2"/>
                      <param name="orbitelevation" number="0.0"/>
                    </play_cutscene>
                  </actions>
                </cue>

                <cue name="BriefingStopped">
                  <conditions>
                    <check_any>
                      <event_briefing_cancelled cue="$MissionCue"/>
                      <event_briefing_submission_unselected cue="$MissionCue"/>
                    </check_any>
                  </conditions>
                  <actions>
                    <do_if value="$BriefingCutscene?">
                      <remove_overlay_text force="true"/>
                      <stop_cutscene cutscene="$BriefingCutscene"/>
                      <remove_value name="$BriefingCutscene"/>
                    </do_if>

                    <debug_text text="'Briefing cancelled'" chance="$DebugChance"/>
                    <reset_cue cue="BriefingStarted"/>
                  </actions>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

        <cue name="ResultWindow" comment="Scenario Ended (Failure or Success Case)">
          <!-- set data when you die or finish a mission in the failure or success case -->
          <!-- game is force paused -->
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <cues>
            <cue name="Finished_Ref" ref="md.LIB_Scenario.ScenarioFinished">
              <param name="ResultData" value="$ResultData"/>
            </cue>
          </cues>
        </cue>

      </cues>
    </cue>

  </cues>
</mdscript>
