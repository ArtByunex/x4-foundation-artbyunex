<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Scenario_Fleet_Battle_2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <documentation>
    <author name="Ketraar"/>
  </documentation>
  <cues>

    <cue name="Start" namespace="this" module="scenario_fleet_battle_2">
      <conditions>
        <event_cue_signalled cue="md.Setup.Start" />
      </conditions>
      <actions>
        <include_actions ref="md.LIB_Scenario.ScenarioStarted"/>

        <!--========================================================
            Set some of the commonly used variables
            ============================================================-->

        <set_value name="$DebugChance"        exact="100"/>
        <set_value name="$MissionCue"         exact="namespace"/>

        <set_value name="$Page"               exact="30622"/>
        <set_value name="$Difficulty"         exact="if event.param.$Difficulty? then event.param.$Difficulty else level.medium"/>
        <set_value name="$MissionType"        exact="missiontype.deliver"/>
        <set_value name="$MissionFaction"     exact="faction.civilian"/>

        <set_value name="$HasError"           exact="false" comment="will be set true if any setup fails"/>

        <debug_text text="'Initialising Scenario:' + $Page" chance="$DebugChance"/>

        <!-- Table that will be filled with all actors with active speaking roles -->
        <set_value name="$MissionActors" exact="table[]"/>

        <!-- Group of Objects which will End the Scenario and trigger ResultWindow if destroyed -->
        <create_group groupname="$MissionRelevantObjects" comment="add objects which trigger mission failure/success on destruction"/>

        <!--========================================================
            Universe Flags
            ============================================================-->

        <!--$DisableAutoInitialisation prevents the InitUniverse script interfering with map objects. All map ships/stations will not have any entities such as engineers. Map stations will not have random amounts of wares/workforce
        Commented out as default but feel free to disable it if required by your scenario-->
        <set_value name="md.InitUniverse.Start.$DisableAutoInitialisation" exact="false"/>

        <!--This disables the spawning of generic missions-->
        <set_value name="md.GenericMissions.Manager.$Disabled" exact="true"/>

        <!--========================================================
            Custom scenario-specific variables go here
            ============================================================-->
        <set_value name="$Destroyed_XL" exact="0"/>
        <set_value name="$Destroyed_L" exact="0"/>
        <set_value name="$Destroyed_M" exact="0"/>
        <set_value name="$Destroyed_S" exact="0"/>
        <set_value name="$Score_Kills_XL" exact="0"/>
        <set_value name="$Score_Kills_L" exact="0"/>
        <set_value name="$Score_Kills_M" exact="0"/>
        <set_value name="$Score_Kills_S" exact="0"/>
        <set_value name="$Survivors_XL" exact="0"/>
        <set_value name="$Survivors_L" exact="0"/>
        <set_value name="$Survivors_M" exact="0"/>
        <set_value name="$Survivors_S" exact="0"/>
        <set_value name="$Survivors_Outpost" exact="0"/>
        <set_value name="$Survivors_Refinery" exact="0"/>
        <set_value name="$Score_Survivors_XL" exact="0"/>
        <set_value name="$Score_Survivors_L" exact="0"/>
        <set_value name="$Score_Survivors_M" exact="0"/>
        <set_value name="$Score_Survivors_S" exact="0"/>
        <set_value name="$Score_Survivors_Outpost" exact="0"/>
        <set_value name="$Score_Survivors_Refinery" exact="0"/>
        <set_value name="$DisabledFlag" exact="0"/>
        <set_ambient_sound_state active="false"/>
        <add_research ware="ware.research_teleportation"/>
        <set_value name="$TimeBonusPerSecond" exact="1"/>
        <set_value name="$TimeBonusThreshold" exact="30min"/>
        <set_value name="$RevealEnemies" exact="0"/>
        <find_sector name="$MookyesRevenge" macro="macro.timelines_map_fleet_battle_2_cluster_001_sector_001_macro" space="player.galaxy"/>
        <find_sector name="$CardinalsDomain" macro="macro.timelines_map_fleet_battle_2_cluster_002_sector_001_macro" space="player.galaxy"/>
        <find_station groupname="$Stations" space="$CardinalsDomain" class="class.station" multiple="1" required="1"/>
        <find_station name="$MiningOutpost" groupname="$Stations" space="$MookyesRevenge" godstationentry="'par_mining_outpost_cluster001_001'" required="1"/>
        <find_station name="$Refinery" groupname="$Stations" space="$MookyesRevenge" godstationentry="'par_refinery_cluster001_001'" required="1"/>
        <find_gate name="$MooKyeGate" space="$MookyesRevenge" active="true"/>
        <set_known object="$MookyesRevenge" known="true"/>
        <set_known object="$MookyesRevenge.cluster" known="true"/>
        <set_known object="$MooKyeGate" known="true"/>
        <create_position name="$StartPosition" x="156500" y="0" z="111700"/>
        <create_position name="$PatrolPosition1" object="$MiningOutpost" space="$MookyesRevenge"/>
        <create_position name="$PatrolPosition2" object="$Refinery" space="$MookyesRevenge"/>
        <create_position name="$PatrolPosition3" space="$MookyesRevenge" x="44000" y="0" z="-140000"/>
        <do_for_each in="$Stations" counter="$K">
          <set_known object="$Stations.{$K}" known="1" updatesnapshot="true"/>
        </do_for_each>
        <clear_fog_of_war sector="$CardinalsDomain" range="500km">
          <position space="$CardinalsDomain" x="0" y="0" z="0"/>
        </clear_fog_of_war>
        <clear_fog_of_war sector="$MookyesRevenge" range="300km">
          <position space="$MookyesRevenge" x="0" y="0" z="0"/>
        </clear_fog_of_war>
        <create_object groupname="$Sats" macro="macro.eq_arg_satellite_01_macro" owner="faction.player" sector="$MookyesRevenge">
          <position object="$MiningOutpost" max="5km"/>
        </create_object>
        <create_object groupname="$Sats" macro="macro.eq_arg_satellite_01_macro" owner="faction.player" sector="$MookyesRevenge">
          <position object="$Refinery" max="5km"/>
        </create_object>
        <do_for_each name="$Object" in="$Sats">
          <run_actions ref="md.LIB_Generic.RequestObjectInvincibility">
            <param name="Object" value="$Object"/>
            <param name="RequesterCue" value="namespace"/>
            <param name="MinHull" value="100"/>
            <param name="DebugChance" value="$DebugChance"/>
          </run_actions>
          <set_object_radar_visible object="$Object" visible="false"/>
        </do_for_each>
      </actions>
      <cues>

        <cue name="StopUseCase"/>

        <cue name="Setup_Scenario">
          <cues>
            <cue name="Placements">
              <actions>
                <create_ship name="$DerelictShip" macro="macro.ship_xen_l_terraformer_01_b_macro" sector="$MookyesRevenge" >
                  <loadout>
                    <level exact="0.7" faction="faction.xenon"/>
                  </loadout>
                  <owner exact="faction.ownerless"/>
                  <position space="$MookyesRevenge" x="70000" y="0" z="-280000"/>
                  <rotation yaw="0deg" pitch="0deg" roll="0deg"/>
                </create_ship>
                <create_ship name="$PARAuxiliary" macro="macro.ship_par_xl_carrier_02_a_macro" sector="$MookyesRevenge" >
                  <pilot group="paranid.pilot">
                    <owner exact="faction.paranid" />
                  </pilot>
                  <people>
                    <fillpercent exact="60"/>
                    <person role="service">
                      <select faction="faction.paranid" tags="tag.crew"/>
                    </person>
                  </people>
                  <owner exact="faction.paranid"/>
                  <loadout>
                    <quantity exact="1.0" comment="fill completely">
                      <variation exact="0"/>
                    </quantity>
                    <quality exact="0.7"/>
                  </loadout>
                  <position space="$MookyesRevenge" x="45000" y="0" z="-140000"/>
                  <rotation yaw="250deg" pitch="0deg" roll="0deg"/>
                </create_ship>
                <create_object name="$Navbeacon" macro="macro.env_deco_nav_beacon_t1_mission_macro" owner="faction.player" sector="$MookyesRevenge">
                  <position space="$MookyesRevenge" x="44000" y="0" z="-140000"/>
                </create_object>
              </actions>
            </cue>

            <cue name="Call_Setup_Libraries">
              <actions>
                <include_actions ref="Setup_Player" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_PlayerFleet" chance="if $HasError then 0 else 100"/>
                <include_actions ref="Setup_EnemyFleet" chance="if $HasError then 0 else 100"/>

                <!--If there was an error, signal the CleanUp cue, otherwise signal the scenario to start-->
                <do_if value="$HasError">
                  <quit_to_game game="'x4ep1_gamestart_hub'"/>
                </do_if>
                <do_else>
                  <debug_text text="'Scenario has been successfully set up and can start'" chance="$DebugChance"/>
                  <signal_cue cue="Start_Scenario_IntroCutscene"/>
                </do_else>
              </actions>
            </cue>

            <library name="Setup_Player">
              <actions>
                <!-- Place the Player, then check for Player existence -->

                <do_if value="not player.exists">
                  <debug_text text="'Player does not exist'" filter="error"/>
                  <set_value name="$HasError" exact="true"/>
                </do_if>
              </actions>
            </library>

            <library name="Setup_PlayerFleet">
              <actions>
                <run_actions ref="md.Scenario_Fleet_Battle_Lib.Setup_ParanidFleet" result="$PlayerFleet">
                  <param name="player" value="true"/>
                  <param name="ParanidLocation" value="$MookyesRevenge"/>
                  <param name="PatrolDestination" value="$MookyesRevenge"/>
                  <param name="PatrolPosition1" value="$PatrolPosition1"/>
                </run_actions>

                <do_for_each in="$PlayerFleet" name="$ship">
                  <set_allow_drop object="$ship" allow="false"/>
                  <set_value name="$ship.pilot.$donotbail"/>
                  <do_if value="not $ship.exists">
                    <debug_text text="'PlayerFleet ship does not exist'" filter="error"/>
                    <set_value name="$HasError" exact="true"/>
                  </do_if>
                </do_for_each>
              </actions>
            </library>

            <library name="Setup_EnemyFleet">
              <actions>
                <!-- CPU Fleet -->
                <run_actions ref="md.Scenario_Fleet_Battle_Lib.Setup_CPUFleet" result="$CPUfleet">
                  <param name="player" value="false"/>
                  <param name="XenonLocation" value="$MookyesRevenge"/>
                  <param name="PatrolDestination" value="$MookyesRevenge"/>
                  <param name="PatrolPosition2" value="$PatrolPosition2"/>
                </run_actions>
                <do_for_each in="$CPUfleet" name="$ship">
                  <set_allow_drop object="$ship" allow="false"/>
                  <do_if value="not $ship.exists">
                    <debug_text text="'EnemyShips ship does not exist'" filter="error"/>
                    <set_value name="$HasError" exact="true"/>
                  </do_if>
                </do_for_each>
                <!-- Xenon I Fleet -->
                <run_actions ref="md.Scenario_Fleet_Battle_Lib.Setup_XenonCarrierFleet" result="$XenonCarrierfleet">
                  <param name="player" value="false"/>
                  <param name="XenonLocation" value="$MookyesRevenge"/>
                  <param name="PatrolDestination" value="$MookyesRevenge"/>
                  <param name="PatrolPosition1" value="$PatrolPosition1"/>
                </run_actions>
                <do_for_each in="$XenonCarrierfleet" name="$ship">
                  <set_allow_drop object="$ship" allow="false"/>
                  <do_if value="not $ship.exists">
                    <debug_text text="'EnemyShips ship does not exist'" filter="error"/>
                    <set_value name="$HasError" exact="true"/>
                  </do_if>
                </do_for_each>
                <!-- Terraformers -->
                <run_actions ref="md.Scenario_Fleet_Battle_Lib.Setup_XenonTerraformerFleet" result="$Terraformerfleet">
                  <param name="player" value="false"/>
                  <param name="XenonLocation" value="$MookyesRevenge"/>
                  <param name="PatrolDestination" value="$MookyesRevenge"/>
                  <param name="PatrolPosition3" value="$PatrolPosition3"/>
                </run_actions>
              </actions>
              <delay exact="1s"/>
              <actions>
                <do_for_each in="$Terraformerfleet" name="$ship">
                  <set_allow_drop object="$ship" allow="false"/>
                  <do_if value="$ship.isclass.ship_l">
                    <set_drone_mode object="$ship" category="unitcategory.defence" mode="dronemode.attackenemies"/>
                    <set_drone_armed object="$ship" category="unitcategory.defence" armed="true"/>
                  </do_if>
                  <do_if value="not $ship.exists">
                    <debug_text text="'EnemyShips ship does not exist'" filter="error"/>
                    <set_value name="$HasError" exact="true"/>
                  </do_if>
                </do_for_each>
              </actions>
            </library>

            <cue name="Debug">
              <cues>
                <cue name="DestroyAllEnemies">
                  <conditions>
                    <event_cue_signalled/>
                  </conditions>
                  <actions>
                    <destroy_group group="$CPUfleet" explosion="true"/>
                    <destroy_group group="$XenonCarrierfleet" explosion="true"/>
                    <destroy_group group="$Terraformerfleet" explosion="true"/>
                  </actions>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

        <!--****StartScenario****
        This cue is signalled if the setup cue hasn't found any issues and the scenario can now start
        This cue and following subcues will manage the presentation, objects, AI and mission objectives
        The mission itself does not have to be created until later (see create_mission)-->
        <cue name="Start_Scenario_IntroCutscene">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <delay exact="2s"/>
          <actions>
            <find_ship name="$CPU" space="$MookyesRevenge" macro="macro.ship_tfm_xl_carrier_02_b_macro" required="1"/>
            <find_ship name="$PARZeus" space="$MookyesRevenge" macro="macro.ship_par_xl_carrier_02_a_macro" required="1"/>
            <add_to_group groupname="$DefendTargets" list="[$MiningOutpost, $Refinery, $PARAuxiliary]"/>
            <add_to_group groupname="$EnemyFleet" group="$CPUfleet"/>
            <add_to_group groupname="$EnemyFleet" group="$XenonCarrierfleet"/>
            <add_to_group groupname="$EnemyFleet" group="$Terraformerfleet"/>
            <add_to_group groupname="$PlayerFleet" object="$PARZeus"/>
            <play_cutscene result="this.$FB2Cutscene" key="'scenario_fleet_battle_2_intro_cutscene'" abortable="true">
              <param name="cpu" object="$CPU"/>
              <param name="outpost" object="$MiningOutpost"/>
            </play_cutscene>
            <play_music music="'music_soundtrack_timelines_fleet_battle_2_001'"/>
          </actions>
          <delay exact="19s"/>
          <actions>
            <play_music music="'music_soundtrack_timelines_fleet_battle_2_002'"/>
            <signal_cue cue="Start_Scenario_IntroCutscene_Fadeout"/>
          </actions>
          <cues>
            <cue name="Start_Scenario_IntroCutscene_Fadeout">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <delay exact="10s"/>
              <actions>
                <fade_screen fadeout="1.5s" fadein="2s" realtime="true"/>
              </actions>
            </cue>
            <cue name="Start_Scenario_IntroCutscene_Speak">
              <conditions>
                <event_cutscene_stopped cutscene="parent.$FB2Cutscene"/>
              </conditions>
              <actions>
                <cancel_cue cue="Start_Scenario_IntroCutscene_Fadeout"/>
                <stop_music/>
                <set_ambient_sound_state active="true"/>
                <muffle_sound strength="0" duration="0s"/>
                <blur_screen strength="0" duration="0s"/>
                <set_value name="$FleetCaptain" exact="$PARZeus.aipilot"/>
                <set_value name="$CutsceneActors" exact="table[]"/>
                <set_value name="$CutsceneActors.$FleetCaptain" exact="table[ $entity = $FleetCaptain ]"/>
                <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $actors = $CutsceneActors, $debugchance = 0,
                                  $script = [
                                            table [$actor = '$FleetCaptain', $speak = [10301,10074] , $recipient = 'player', $comment='Unholy machine!' ],
                                            table [$actor = '$FleetCaptain', $speak = [10301,10060] , $recipient = 'player', $comment='In the name of the Paranid Empire!' ],
                                            table [$actor = '$FleetCaptain', $speak = [10301,10075] , $recipient = 'player', $comment='Prepare to be destroyed!' ],
                                            1s,
                                            table [$actor = '$FleetCaptain', $speak = [10301,10009] , $recipient = 'player', $comment='They cannot withstand the might of the Paranid.' ],
                                            ],
                                            $callbackcue = Start_Scenario_IntroCutscene_Ended,
                                            $abortcallbackcue = Start_Scenario_IntroCutscene_Ended,
                                            $abortonsignalledcue = StopUseCase
                                ]" />
              </actions>
              <cues>
                <cue name="Start_Scenario_IntroCutscene_Ended">
                  <conditions>
                    <event_cue_signalled/>
                  </conditions>
                  <actions>
                    <signal_cue cue="Start_Scenario"/>
                    <cancel_cue cue="Start_Scenario_IntroCutscene"/>
                  </actions>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

        <cue name="Start_Scenario">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <cues>
            <cue name="Debug_ShipAmount_List">
              <actions>
                <do_if value="$DebugChance != 0">
                  <do_for_each name="$PlayerFleetShip" in="$PlayerFleet">
                    <do_if value="$PlayerFleetShip.isclass.ship_xl">
                      <set_value name="$PlayerFleetShip_XL" exact="1" operation="add"/>
                    </do_if>
                    <do_elseif value="$PlayerFleetShip.isclass.ship_l">
                      <set_value name="$PlayerFleetShip_L" exact="1" operation="add"/>
                    </do_elseif>
                    <do_elseif value="$PlayerFleetShip.isclass.ship_m">
                      <set_value name="$PlayerFleetShip_M" exact="1" operation="add"/>
                    </do_elseif>
                    <do_elseif value="$PlayerFleetShip.isclass.ship_s">
                      <set_value name="$PlayerFleetShip_S" exact="1" operation="add"/>
                    </do_elseif>
                  </do_for_each>
                  <do_for_each name="$EnemyFleetShip" in="$EnemyFleet">
                    <do_if value="$EnemyFleetShip.isclass.ship_xl">
                      <set_value name="$EnemyFleetShip_XL" exact="1" operation="add"/>
                    </do_if>
                    <do_elseif value="$EnemyFleetShip.isclass.ship_l">
                      <set_value name="$EnemyFleetShip_L" exact="1" operation="add"/>
                    </do_elseif>
                    <do_elseif value="$EnemyFleetShip.isclass.ship_m">
                      <set_value name="$EnemyFleetShip_M" exact="1" operation="add"/>
                    </do_elseif>
                    <do_elseif value="$EnemyFleetShip.isclass.ship_s">
                      <set_value name="$EnemyFleetShip_S" exact="1" operation="add"/>
                    </do_elseif>
                  </do_for_each>
                  <debug_text text="'Player XL Ships: ' + $PlayerFleetShip_XL"/>
                  <debug_text text="'Player L Ships: ' + $PlayerFleetShip_L"/>
                  <debug_text text="'Player M Ships: ' + $PlayerFleetShip_M"/>
                  <debug_text text="'Player S Ships: ' + $PlayerFleetShip_S"/>
                  <debug_text text="'Enemy XL Ships: ' + $EnemyFleetShip_XL"/>
                  <debug_text text="'Enemy L Ships: ' + $EnemyFleetShip_L"/>
                  <debug_text text="'Enemy M Ships: ' + $EnemyFleetShip_M"/>
                  <debug_text text="'Enemy S Ships: ' + $EnemyFleetShip_S"/>
                </do_if>
              </actions>
            </cue>
            <!-- The cues that make up the scenario will go here -->

            <cue name="SetupMission">
              <actions>
                <set_value name="$StartTime" exact="player.age"/>
                <create_mission cue="$MissionCue" abortable="false"
                                name="{30622,2301}" description="{30622,2004}"
                                icon="'briefing_mission_director_01'" iconcaption="{30293,102}"
                                difficulty="$Difficulty" type="$MissionType" faction="$MissionFaction">
                  <briefing>
                    <objective step="1" action="objective.defend" group="$DefendTargets" text="{30622,2321}"/>
                  </briefing>
                </create_mission>
                <set_objective_from_briefing cue="$MissionCue" step="1"/>
              </actions>
              <cues>
                <cue name="Gate_Traversed">
                  <conditions>
                    <check_any>
                      <event_object_entered_live_view group="$CPUfleet"/>
                      <event_object_entered_live_view group="$XenonCarrierfleet"/>
                      <event_object_entered_live_view group="$Terraformerfleet"/>
                    </check_any>
                  </conditions>
                  <delay exact="10s"/>
                  <actions>
                    <create_mission cue="$MissionCue" abortable="false" name="{30622,2301}" description="{30622,2004}" 
                                    icon="'briefing_mission_director_01'" iconcaption="{30293,102}"
                                    difficulty="$Difficulty" type="$MissionType" faction="$MissionFaction">
                      <briefing>
                        <objective step="1" action="objective.defeat" text="{30622,2311}"/>
                      </briefing>
                    </create_mission>
                    <set_objective_from_briefing cue="$MissionCue" step="1"/>
                  </actions>
                </cue>
                <cue name="Derelict_Ship_Claimed">
                  <conditions>
                    <check_any>
                      <event_object_changed_owner object="$DerelictShip" owner="faction.player"/>
                      <event_object_destroyed object="$DerelictShip"/>
                    </check_any>
                  </conditions>
                  <actions>
                    <do_if value="$DerelictShip.exists">
                      <add_to_group groupname="$PlayerFleet" object="$DerelictShip"/>
                    </do_if>
                  </actions>
                </cue>

                <cue name="Refinery_Destroyed">
                  <conditions>
                    <event_object_destroyed object="$Refinery"/>
                  </conditions>
                  <actions>
                    <set_value name="$Survivors_Refinery" exact="1"/>
                    <do_if value="$CPUfleet.count" min="1">
                      <do_for_each name="$CPUShip" in="$CPUfleet">
                        <create_order id="'ProtectPosition'" object="$CPUShip" default="true">
                          <param name="destination" value="[$MookyesRevenge, $PatrolPosition1]"/>
                        </create_order>
                      </do_for_each>
                    </do_if>
                  </actions>
                </cue>

                <cue name="Outpost_Destroyed">
                  <conditions>
                    <event_object_destroyed object="$MiningOutpost"/>
                  </conditions>
                  <actions>
                    <set_value name="$Survivors_Outpost" exact="1"/>
                  </actions>
                </cue>

                <cue name="CPUDestroyed">
                  <conditions>
                    <event_object_destroyed object="$CPU"/>
                  </conditions>
                  <actions>
                    <do_for_each name="$FleetShip" in="$EnemyFleet">
                      <abort_scripts entity="$FleetShip.pilot"/>
                    </do_for_each>
                    <set_value name="$DisabledFlag" exact="1"/>
                    <signal_cue cue="ReactivateEnemies"/>
                  </actions>
                </cue>
                <cue name="ReactivateEnemies">
                  <conditions>
                    <event_cue_signalled/>
                  </conditions>
                  <delay exact="120s"/>
                  <actions>
                    <set_value name="$DisabledFlag" exact="0"/>
                    <do_for_each name="$FleetShip" in="$EnemyFleet">
                      <start_script name="'orders.base'" object="$FleetShip.pilot" />
                    </do_for_each>
                  </actions>
                </cue>
              </cues>
            </cue>

            <cue name="Window_of_Opportunity" instantiate="true">
              <conditions>
                <event_object_destroyed group="$EnemyFleet"/>
                <check_value value="$DisabledFlag" exact="1"/>
              </conditions>
              <actions>
                <set_value name="$KilledObject" exact="event.object"/>
                <do_if value="$KilledObject.isclass.ship_xl or $KilledObject.isclass.ship_l">
                  <do_if value="event.param.isplayerowned">
                    <unlock_achievement scenario="true" name="TL_CAPSHIP_OPPORTUNITY"/>
                  </do_if>
                </do_if>
              </actions>
            </cue>

            <cue name="Auxiliary_Ignored" checkinterval="60s">
              <conditions>
                <check_value value="not $PARAuxiliary.isplayerowned"/>
                <check_value value="player.age" min="1200s"/>
              </conditions>
              <actions>
                <destroy_object object="$PARAuxiliary" explosion="true"/>
                <cancel_cue cue="Auxiliary_Saved"/>
              </actions>
            </cue>

            <cue name="Auxiliary_Destroyed">
              <conditions>
                <event_object_destroyed object="$PARAuxiliary"/>
              </conditions>
              <actions>
                <cancel_cue cue="Auxiliary_Saved"/>
                <do_if value="$Terraformerfleet.count" min="1">
                  <do_for_each name="$TFShip" in="$Terraformerfleet">
                    <create_order id="'ProtectPosition'" object="$TFShip" default="true">
                      <param name="destination" value="[$MookyesRevenge, $PatrolPosition1]"/>
                    </create_order>
                  </do_for_each>
                </do_if>
              </actions>
            </cue>

            <cue name="Auxiliary_Saved">
              <conditions>
                <event_object_entered_live_view object="$PARAuxiliary"/>
              </conditions>
              <actions>
                <cancel_cue cue="Auxiliary_Ignored"/>
                <set_owner object="$PARAuxiliary" faction="faction.player"/>
                <add_to_group object="$PARAuxiliary" groupname="$PlayerFleet"/>
              </actions>
              <delay min="60s" max="120s"/>
              <actions>
                <do_if value="$Terraformerfleet.count" min="1">
                  <do_for_each name="$TFShip" in="$Terraformerfleet">
                    <create_order id="'ProtectPosition'" object="$TFShip" default="true">
                      <param name="destination" value="[$MookyesRevenge, $PatrolPosition1]"/>
                    </create_order>
                  </do_for_each>
                </do_if>
              </actions>
            </cue>

            <cue name="Reveal_Enemies" checkinterval="180s">
              <conditions>
                <check_value value="$EnemyFleet.count != 0"/>
                <check_value value="player.age" min="1800s"/>
              </conditions>
              <actions>
                <set_value name="$RevealEnemies" exact="1"/>
                <create_mission cue="$MissionCue" abortable="false"
                                                    name="{30622,2301}" description="{30622,2004}"
                                                    icon="'briefing_mission_director_01'" iconcaption="{30293,102}"
                                                    difficulty="$Difficulty" type="$MissionType" faction="$MissionFaction">
                  <briefing>
                    <objective step="1" action="objective.defeat" text="{30622,2311}"/>
                  </briefing>
                </create_mission>
                <set_objective cue="$MissionCue" step="1" action="objective.defeat" group="$EnemyFleet" updatebriefing="true"/>
              </actions>
            </cue>

            <cue name="EnemyDestroyed" instantiate="true">
              <conditions>
                <event_object_destroyed group="$EnemyFleet"/>
              </conditions>
              <actions>
                <set_value name="$DestroyedObject" exact="event.object"/>
                <do_if value="event.param.isplayerowned">
                  <do_if value="$DestroyedObject.isclass.ship_xl">
                    <set_value name="$Destroyed_XL" exact="1" operation="add"/>
                    <set_value name="$Score_Kills_XL" exact="99" operation="add"/>
                    <set_value name="$KillsScore" exact="99" operation="add"/>
                  </do_if>
                  <do_elseif value="$DestroyedObject.isclass.ship_l">
                    <set_value name="$Destroyed_L" exact="1" operation="add"/>
                    <set_value name="$Score_Kills_L" exact="66" operation="add"/>
                    <set_value name="$KillsScore" exact="66" operation="add"/>
                  </do_elseif>
                  <do_elseif value="$DestroyedObject.isclass.ship_m">
                    <set_value name="$Destroyed_M" exact="1" operation="add"/>
                    <set_value name="$Score_Kills_M" exact="33" operation="add"/>
                    <set_value name="$KillsScore" exact="33" operation="add"/>
                  </do_elseif>
                  <do_elseif value="$DestroyedObject.isclass.ship_s">
                    <set_value name="$Destroyed_S" exact="1" operation="add"/>
                    <set_value name="$Score_Kills_S" exact="11" operation="add"/>
                    <set_value name="$KillsScore" exact="11" operation="add"/>
                  </do_elseif>
                </do_if>
                <remove_from_group group="$EnemyFleet" object="$DestroyedObject"/>
                <do_if value="$EnemyFleet.count == 0">
                  <cancel_cue cue="ReactivateEnemies"/>
                  <signal_cue cue="Finish"/>
                </do_if>
                <do_elseif value="$EnemyFleet.count le 10 or $RevealEnemies ge 1">
                  <create_mission cue="$MissionCue" abortable="false"
                                    name="{30622,2301}" description="{30622,2004}"
                                    icon="'briefing_mission_director_01'" iconcaption="{30293,102}"
                                    difficulty="$Difficulty" type="$MissionType" faction="$MissionFaction">
                    <briefing>
                      <objective step="1" action="objective.defeat" text="{30622,2311}"/>
                    </briefing>
                  </create_mission>
                  <set_objective cue="$MissionCue" step="1" action="objective.defeat" group="$EnemyFleet" updatebriefing="true"/>
                </do_elseif>
              </actions>
            </cue>

            <cue name="Finish">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <actions>
                <!--Calculate score, speak line appropriate to rating-->
                <set_value name="$Duration" exact="player.age - $StartTime"/>
                <set_value name="$TimeRemaining" exact="if $Duration lt $TimeBonusThreshold then ($TimeBonusThreshold - $Duration) else 0s"/>
                <set_value name="$Score_Time" exact="$TimeBonusPerSecond * ($TimeRemaining)f"/>
                <do_if value="$Survivors_Outpost == 0">
                  <set_value name="$Score_Survivors_Outpost" exact="333" operation="add"/>
                </do_if>
                <do_if value="$Survivors_Refinery == 0">
                  <set_value name="$Score_Survivors_Refinery" exact="666" operation="add"/>
                </do_if>
                <do_for_each name="$survivingship" in="$PlayerFleet">
                  <do_if value="$survivingship.isclass.ship_xl">
                    <set_value name="$Survivors_XL" exact="1" operation="add"/>
                    <set_value name="$Score_Survivors_XL" exact="99" operation="add"/>
                  </do_if>
                  <do_elseif value="$survivingship.isclass.ship_l">
                    <set_value name="$Survivors_L" exact="1" operation="add"/>
                    <set_value name="$Score_Survivors_L" exact="66" operation="add"/>
                  </do_elseif>
                  <do_elseif value="$survivingship.isclass.ship_m">
                    <set_value name="$Survivors_M" exact="1" operation="add"/>
                    <set_value name="$Score_Survivors_M" exact="33" operation="add"/>
                  </do_elseif>
                  <do_elseif value="$survivingship.isclass.ship_s">
                    <set_value name="$Survivors_S" exact="1" operation="add"/>
                    <set_value name="$Score_Survivors_S" exact="11" operation="add"/>
                  </do_elseif>
                  <do_if value="not $SurvivingCaptain?">
                    <set_value name="$SurvivingCaptain" exact="$survivingship.aipilot"/>
                  </do_if>
                </do_for_each>
                <set_value name="$TotalScore" exact="$Score_Time + $Score_Survivors_XL + $Score_Survivors_L + $Score_Survivors_M + $Score_Survivors_S + $Score_Survivors_Outpost + $Score_Survivors_Refinery + $KillsScore"/>
                <set_value name="$Rating" exact="player.allmodules.{player.module}.rating.{$TotalScore}"/>
                <do_if value="$Rating == 0">
                  <signal_cue cue="ResultWindow"/>
                </do_if>
                <do_elseif value="$Rating lt 3">
                  <set_value name="$FinalLine" exact="10037" comment="{10301,10037}"/>
                </do_elseif>
                <do_elseif value="$Rating lt 4">
                  <set_value name="$FinalLine" exact="10036" comment="{10301,10036}"/>
                </do_elseif>
                <do_else>
                  <set_value name="$FinalLine" exact="10038" comment="{10301,10038}"/>
                </do_else>
                <set_value name="$CutsceneActors" exact="table[]"/>
                <set_value name="$CutsceneActors.$SurvivingCaptain" exact="table[ $entity = $SurvivingCaptain ]"/>
                <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $nofullscreenmenu = false, $actors = $CutsceneActors, $debugchance = 0,
                                  $script = [
                                            table [$actor = '$SurvivingCaptain', $speak = $FinalLine, $recipient = 'player'],
                                            ],
                                            $callbackcue = FinalSpeakFinished,
                                            $abortcallbackcue = FinalSpeakFinished,
                                            $abortonsignalledcue = StopUseCase
                                ]" />
              </actions>
              <cues>
                <cue name="FinalSpeakFinished">
                  <conditions>
                    <event_cue_signalled/>
                  </conditions>
                  <actions>
                    <signal_cue cue="ResultWindow"/>
                  </actions>
                </cue>
              </cues>
            </cue>

          </cues>
        </cue>

        <cue name="ResultWindow" comment="Scenario Ended (Failure or Success Case)">
          <!-- set data when you die or finish a mission in the failure or success case -->
          <!-- game is force paused -->
          <conditions>
            <check_any>
              <event_cue_signalled/>
              <event_object_destroyed object="player.entity"/>
            </check_any>
          </conditions>
          <actions>
            <set_value name="$ResultData" exact="table[]"/>
            <set_value name="$ResultData.$PlayerDied" exact="event.name == 'event_object_destroyed' and event.object == player.entity"/>
            <do_if value="event.name == 'event_object_destroyed' and event.object == player.entity">
              <set_value name="$Rating" exact="player.allmodules.{player.module}.rating.{$KillsScore}"/>
              <add_scenario_stat id="'kills_xl'" name="{30622,2211}" uivalue="$Destroyed_XL" score="$Score_Kills_XL/2"/>
              <add_scenario_stat id="'kills_l'" name="{30622,2212}" uivalue="$Destroyed_L" score="$Score_Kills_L/2"/>
              <add_scenario_stat id="'kills_m'" name="{30622,2213}" uivalue="$Destroyed_M" score="$Score_Kills_M/2"/>
              <add_scenario_stat id="'kills_s'" name="{30622,2214}" uivalue="$Destroyed_S" score="$Score_Kills_S/2"/>
              <set_value name="$ResultData.$Score" exact="$KillsScore/2"/>
            </do_if>
            <do_else>
              <substitute_text text="$timebonushinttext" source="{30622,2201}">
                <replace string="'$SCORE$'" with="$TimeBonusPerSecond"/>
                <replace string="'$TIME$'" with="$TimeBonusThreshold.formatted.default" />
              </substitute_text>
              <add_scenario_stat id="'time'" name="{30622,2202}" uivalue="$Duration.formatted.{'%mm %ss'}" description="$timebonushinttext" score="$Score_Time"/>
              <add_scenario_stat id="'survivors_xl'" name="{30622,2203}" uivalue="$Survivors_XL" score="$Score_Survivors_XL"/>
              <add_scenario_stat id="'survivors_l'" name="{30622,2204}" uivalue="$Survivors_L" score="$Score_Survivors_L"/>
              <add_scenario_stat id="'survivors_m'" name="{30622,2205}" uivalue="$Survivors_M" score="$Score_Survivors_M"/>
              <add_scenario_stat id="'survivors_s'" name="{30622,2206}" uivalue="$Survivors_S" score="$Score_Survivors_S"/>
              <add_scenario_stat id="'kills_xl'" name="{30622,2211}" uivalue="$Destroyed_XL" score="$Score_Kills_XL"/>
              <add_scenario_stat id="'kills_l'" name="{30622,2212}" uivalue="$Destroyed_L" score="$Score_Kills_L"/>
              <add_scenario_stat id="'kills_m'" name="{30622,2213}" uivalue="$Destroyed_M" score="$Score_Kills_M"/>
              <add_scenario_stat id="'kills_s'" name="{30622,2214}" uivalue="$Destroyed_S" score="$Score_Kills_S"/>
              <add_scenario_stat id="'survivors_outpost'" name="{30622,2207}" uivalue="if $Survivors_Outpost ge 1 then {1001,2618} else {1001,2617}" score="$Score_Survivors_Outpost"/>
              <add_scenario_stat id="'survivors_refinery'" name="{30622,2208}" uivalue="if $Survivors_Refinery ge 1 then {1001,2618} else {1001,2617}" score="$Score_Survivors_Refinery"/>
              <set_value name="$ResultData.$Score" exact="$TotalScore"/>
            </do_else>
          </actions>
          <cues>
            <cue name="Finished_Ref" ref="md.LIB_Scenario.ScenarioFinished">
              <param name="ResultData" value="$ResultData"/>
            </cue>
          </cues>
        </cue>

      </cues>
    </cue>

  </cues>
</mdscript>
