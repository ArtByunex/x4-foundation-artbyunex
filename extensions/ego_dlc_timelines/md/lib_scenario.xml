<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LIB_Scenario" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <!-- Mitsuno Hacks -->
    <cue name="Mitsuno_Hack_Manager" namespace="this">
      <!--
            - A list of $Hacks (cues with voice interaction) will be played in order
            - some routine scenarios call the 'play_next_hack' lib during quiet moments (players can play scenarios out of order)
            - if caller has not played a hack yet and there are more generic hacks available in our list, we play the next hack interaction
      -->
      <conditions>
        <event_cue_signalled cue="md.Setup.Start" comment="required for Scenario_Hub.Setup_Character"/>
      </conditions>
      <actions>
        <!-- voice actors for hack interactions -->
        <include_actions ref="md.Scenario_Hub.Setup_Character_Player"/>
        <include_actions ref="md.Scenario_Hub.Setup_Character_PlayerNPC"/>
        <include_actions ref="md.Scenario_Hub.Setup_Character_HackerActor"/>
        <include_actions ref="md.Scenario_Hub.Setup_Character_MissionDirectorActor"/>

        <set_value name="$DebugChance" exact="100"/>

        <!-- Don't reset everytime -->
        <do_if value="not userdata.timelines_hub_currenthack?">
          <set_userdata name="'timelines_hub_currenthack'"  value="1" comment="signal current hack, then increment"/>
        </do_if>

        <!-- hack interactions to increment over -->
        <set_value name="$Hacks" exact="[Mitsuno_Hack1,
                                         Mitsuno_Hack2,
                                         Mitsuno_Hack3,
                                         Mitsuno_Hack4,
                                         Mitsuno_Hack5,
                                         Mitsuno_Hack6,
                                         Mitsuno_Hack7
                                         ]"/>

        <!-- caller validation; each module can only call a hack once -->
        <create_list name="$CallerModules"/>
        <create_list name="$CallerChapters"/>
        <do_all exact="player.scenarios.chapters.count" counter="$chapter">
          <set_value name="$LastChapter" exact="$chapter"/>
          <do_for_each in="player.scenarios.chapters.{$chapter}" name="$module">
            <set_value name="$userdata_name" exact="'timelines_hub_hack_ch' + $chapter + '_' + $module"/>
            <do_if value="player.module == $module">
              <set_value name="$CurrentModule" exact="$userdata_name"/>
              <set_value name="$CurrentChapter" exact="$chapter"/>
            </do_if>
            <do_if value="userdata.{$userdata_name}?">
              <append_to_list name="$CallerModules" exact="$userdata_name"/>
              <append_to_list name="$CallerChapters" exact="$chapter"/>
            </do_if>
          </do_for_each>
        </do_all>

        <debug_text text="'Caller Modules ' + $CallerModules" chance="0"/>
      </actions>
      <cues>

        <cue name="Debug_Hack" comment="call from different scenario modules for testing">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <debug_text text="'signal next hack'"/>
            <run_actions ref="md.LIB_Scenario.Mitsuno_Play_Next_Hack"/>
          </actions>
        </cue>

        <cue name="Debug_Userdata">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <do_all exact="player.scenarios.chapters.count" counter="$chapter">
              <do_for_each in="player.scenarios.chapters.{$chapter}" name="$module">
                <set_value name="$userdata_name" exact="'timelines_hub_hack_ch' + $chapter + '_' + $module"/>
                <debug_text text="'%s %s %s'.[@userdata.{$userdata_name}, (if player.module == $module then ' >player.module' else ''), $userdata_name]"/>
              </do_for_each>
            </do_all>
          </actions>
        </cue>

        <library name="Mitsuno_Play_Next_Hack" purpose="run_actions">
          <actions>

            <!-- Hack Terminator Check - we found mitsuno and don't need cryptic messages anymore -->
            <do_if value="userdata.hub_a5s3_complete? and (not userdata.hub_a5s4_complete?)">
              <do_if value="userdata.timelines_hub_currenthack le 7">
                <debug_text text="'terminator set; skipping to last hacking attempt despite counter being at ' + userdata.timelines_hub_currenthack"/>
                <signal_cue cue="md.LIB_Scenario.Mitsuno_Hack_Manager.$Hacks.last" check="false" comment="each scenario run gets only one attempt"/>
              </do_if>
            </do_if>
            <do_elseif value="not userdata.hub_a5s3_complete?" comment="terminator - we found mitsuno and don't need cryptic messages anymore">

              <do_if value="not md.LIB_Scenario.Mitsuno_Hack_Manager.$CurrentModule?">
                <debug_text text="'hacking prevented - only supported from within scenarios in player.scenarios.chapters.{$chapter}'"/>
              </do_if>
              <do_elseif value="md.LIB_Scenario.Mitsuno_Hack_Manager.$CurrentChapter == 1">
                <debug_text text="'hacking prevented - this graph is graph 1, we only allow the final mitsuno hack here'"/>
              </do_elseif>
              <do_elseif value="(md.LIB_Scenario.Mitsuno_Hack_Manager.$CurrentChapter != md.LIB_Scenario.Mitsuno_Hack_Manager.$LastChapter) and md.LIB_Scenario.Mitsuno_Hack_Manager.$CallerChapters.indexof.{md.LIB_Scenario.Mitsuno_Hack_Manager.$CurrentChapter}">
                <debug_text text="'hacking prevented - this graph already attempted hacking and is not the last graph'"/>
              </do_elseif>
              <do_elseif value="md.LIB_Scenario.Mitsuno_Hack_Manager.$Hacks.count lt userdata.timelines_hub_currenthack">
                <debug_text text="'hacking prevented - no more hacks left'"/>
              </do_elseif>
              <do_elseif value="md.LIB_Scenario.Mitsuno_Hack_Manager.$CallerModules.indexof.{md.LIB_Scenario.Mitsuno_Hack_Manager.$CurrentModule} and (userdata.timelines_hub_currenthack le 6)">
                <debug_text text="'hacking prevented - this mission already attempted hacking'"/>
              </do_elseif>
              <do_else comment="success">
                <debug_text text="'hacking attempt'"/>
                <signal_cue cue="md.LIB_Scenario.Mitsuno_Hack_Manager.$Hacks.{userdata.timelines_hub_currenthack}" check="false" comment="each scenario run gets only one attempt"/>
              </do_else>

            </do_elseif>
          </actions>
        </library>

        <cue name="Mitsuno_Hack_Success" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_userdata name="'timelines_hub_currenthack'"  value="userdata.timelines_hub_currenthack + 1" comment="increment on hacking"/>

            <append_to_list name="md.LIB_Scenario.Mitsuno_Hack_Manager.$CallerModules" exact="md.LIB_Scenario.Mitsuno_Hack_Manager.$CurrentModule"/>
            <set_value name="$CurrentModule" exact="md.LIB_Scenario.Mitsuno_Hack_Manager.$CurrentModule"/>
            <set_userdata name="$CurrentModule"  value="1" comment="increment on hacking"/>

            <do_if value="(not userdata.hub_a5s3_complete?) and userdata.timelines_hub_currenthack le 7" comment="only hacks 1 to 6 are in act 8; first condition accounts for Terminator handling">
              <do_if value="userdata.timelines_scenarios_finished?">
                <set_userdata name="'hub_a8s' + $Hacks.indexof.{event.param} + '_complete'" value="userdata.timelines_scenarios_finished"/>
              </do_if>
              <do_else>
                <set_userdata name="'hub_a8s' + $Hacks.indexof.{event.param} + '_complete'" value="-1"/>
              </do_else>
            </do_if>
            <do_else comment="act 5 hack">
              <set_userdata name="'hub_a5s4_complete'" value="userdata.timelines_scenarios_finished" comment="set to scenario counter for 'more missions played afterwards' checks"/>
            </do_else>
          </actions>
        </cue>

        <cue name="Mitsuno_Hack1" comment="a8s1">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <debug_text text="'a8s1 - hack 1'"/>

            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $actors = $MissionActors, $debugchance = $DebugChance, $nofullscreenmenu = false, $allow_player_speak = true,
                                  $script = [
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 10, $monitor = table[$cutscenekey = 'ShowNoise', $caption = true], $comment = '*** Static Noise ***' ],
                                            table[ $closemonitor = true ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $speak = 302930801, $comment = 'What was that?' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930801, $monitor = false, $comment = 'What was what, Recruit Donel?' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $speak = 302930802, $comment = 'Comms malfunction?' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930802, $monitor = false, $comment = 'I don t see any malfunction. Let me check diagnostics.' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930803, $monitor = false, $comment = 'No - nothing showing up on diagnostics. Are you sure you re not seeing things? We can get you a medical checkup back at The Facility.' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $speak = 302930803, $comment = 'Forget about it.' ],
                                            ],
                                  $callbackcue = Mitsuno_Hack_Success,
                                  $callbackparam = this,
                                  ]" />
          </actions>
        </cue>

        <cue name="Mitsuno_Hack2" comment="a8s2">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <debug_text text="'a8s2 - hack 2'"/>

            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $actors = $MissionActors, $debugchance = $DebugChance, $nofullscreenmenu = false, $allow_player_speak = true,
                                  $script = [
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 10, $monitor = table[$cutscenekey = 'ShowNoise', $caption = true], $comment = '*** Static Noise ***' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $monitor = false, $speak = 302930804, $comment = 'Hey, Mission Director.' ],
                                            table[ $closemonitor = true ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930804, $monitor = false, $comment = 'What s the problem, recruit?' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $monitor = false, $speak = 302930805, $comment = 'Comms malfunction' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930805, $monitor = false, $comment = 'Again? I ll check it out.' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930806, $monitor = false, $comment = 'Diagnostics are clear. I ll do a deep systems scan back at The Facility. For now, just focus on the mission.' ],
                                            ],
                                  $callbackcue = Mitsuno_Hack_Success,
                                  $callbackparam = this,
                                  ]" />
          </actions>
        </cue>

        <cue name="Mitsuno_Hack3" comment="a8s3">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <debug_text text="'a8s3 - hack 3'"/>

            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $actors = $MissionActors, $debugchance = $DebugChance, $nofullscreenmenu = false, $allow_player_speak = true,
                                  $script = [
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 10, $monitor = table[$cutscenekey = 'ShowNoise', $caption = true], $comment = '*** Static Noise ***' ],
                                            table[ $closemonitor = true ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $monitor = false, $speak = 302930806, $comment = 'Mission Director' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930807, $monitor = false, $comment = 'What s the problem, recruit?' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $monitor = false, $speak = 302930807, $comment = 'Another comms glitch' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930808, $monitor = false, $comment = 'Nothing came up on the deep scan last time this happened. And no-one has seen these glitches.' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930809, $monitor = false, $comment = 'Are you working too hard? Does the recruit need some rest?' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $monitor = false, $speak = 302930808, $comment = 'I m fine.' ],
                                            ],
                                  $callbackcue = Mitsuno_Hack_Success,
                                  $callbackparam = this,
                                  ]" />
          </actions>
        </cue>

        <cue name="Mitsuno_Hack4" comment="a8s4 LOST IN THE DARK">
          <conditions>
            <event_cue_signalled/>
            <check_value value="userdata.hub_a3s6_complete?" comment="you need to progress the hub story past meeting pa to trigger this hack"/>
          </conditions>
          <actions>
            <debug_text text="'a8s4 - hack 4'"/>

            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $actors = $MissionActors, $debugchance = $DebugChance, $nofullscreenmenu = false, $allow_player_speak = true,
                                  $script = [
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 10, $monitor = table[$cutscenekey = 'ShowNoise', $caption = true], $comment = '*** Static Noise ***' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930801, $monitor = true, $comment = 'Lost... in... the... dark' ],
                                            table[ $closemonitor = true ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $monitor = false, $speak = 302930809, $comment = 'MD!' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930810, $monitor = false, $comment = 'What s the problem, recruit? Another comms glitch?' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $speak = 302930810, $comment = 'Yes, but it spoke.' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930811, $monitor = false, $comment = 'You re hearing voices?' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $monitor = false, $speak = 302930811, $comment = 'Oh forget it.' ],
                                            ],
                                  $callbackcue = Mitsuno_Hack_Success,
                                  $callbackparam = this,
                                  ]" />
          </actions>
        </cue>

        <cue name="Mitsuno_Hack5" comment="a8s5">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <debug_text text="'a8s5 - hack 5'"/>

            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $actors = $MissionActors, $debugchance = $DebugChance, $nofullscreenmenu = false, $allow_player_speak = true,
                                  $script = [
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 10, $monitor = table[$cutscenekey = 'ShowNoise', $caption = true], $comment = '*** Static Noise ***' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930802, $monitor = true, $comment = 'Mitsuno.' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930813, $monitor = true, $comment = 'Find me. In the dark.' ],
                                            ],
                                  $callbackcue = Mitsuno_Hack_Success,
                                  $callbackparam = this,
                                  ]" />
          </actions>
        </cue>

        <cue name="Mitsuno_Hack6" comment="a8s6 Graph3Complete Mitsuno Introduction">
          <conditions>
            <event_cue_signalled/>
            <check_value value="userdata.scenario_chapter_3_terminus_completed?"/>
          </conditions>
          <actions>
            <debug_text text="'a8s6 - hack 6'"/>

            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $actors = $MissionActors, $debugchance = $DebugChance, $nofullscreenmenu = false, $allow_player_speak = true,
                                  $script = [
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 10, $monitor = table[$cutscenekey = 'ShowNoise', $caption = true], $comment = '*** Static Noise ***' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930803, $monitor = true, $comment = 'I... am... Mitsuno...' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930804, $monitor = true, $comment = 'I... have... blocked... Mission... Director...' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930805, $monitor = true, $comment = 'Find... me... in... the... dark...' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $speak = 302930812, $comment = 'Who are you?' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930809, $monitor = true, $comment = 'Mitsuno... Find... me...' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $speak = 302930813, $comment = 'Where?' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930820, $monitor = true, $comment = 'In... the... facility...tell... no-one...' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $speak = 302930819, $comment = 'Give me details!' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930823, $monitor = true, $comment = 'Find... me...' ],
                                            ],
                                  $callbackcue = Mitsuno_Hack_Success,
                                  $callbackparam = this,
                                  ]" />
          </actions>
        </cue>

        <cue name="Mitsuno_Hack7" comment="a5s4 Graph6Complete Mitsuno Ready To Breach">
          <conditions>
            <event_cue_signalled/>
            <!-- Scene Condition -->
            <!-- <check_value value="userdata.hub_a5s3_complete?"/> -->
            <check_value value="userdata.hub_a9s3_complete?"/>
            <check_any>
              <check_value value="userdata.scenario_chapter_6_terminus_completed?"/>
              <check_all comment="chapter finale of final chapter">
                <check_value value="player.allmodules.{player.module}.ischapterfinale"/>
                <check_value value="player.scenarios.chapters.{player.scenarios.chapters.count}.indexof.{player.module}"/>
              </check_all>
            </check_any>
          </conditions>
          <actions>
            <debug_text text="'a5s4 - hack 7'"/>

            <signal_cue_instantly cue="md.NPC_UseCases.UseCase" param="table[
                                  $caller = this, $preset = '$plotlike', $actors = $MissionActors, $debugchance = $DebugChance, $nofullscreenmenu = false, $allow_player_speak = true,
                                  $script = [
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 10, $monitor = table[$cutscenekey = 'ShowNoise', $caption = true], $comment = '*** Static Noise ***' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930501, $monitor = true, $comment = 'Harper... Donel...' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930503, $monitor = true, $comment = 'I... am... Mitsuno... I... am... ready...' ],
                                            table[ $actor = '$HackerActor', $recipient = '$PlayerActor', $speak = 302930504, $monitor = true, $comment = 'Find... me... in... the... dark...' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $speak = 302930517, $comment = 'OK.' ],
                                            table[ $closemonitor = true ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930501, $monitor = false, $comment = 'Did you say something, Harper?' ],
                                            table[ $actor = '$PlayerActor_Clone', $voiceover = true, $monitor = true, $speak = 302930518, $comment = 'All good here' ],
                                            table[ $actor = '$MissionDirectorActor', $recipient = '$PlayerActor', $speak = 302930502, $monitor = false, $comment = 'OK, recruit. Focus on the mission. No need to be talking to yourself.' ],
                                            ],
                                  $callbackcue = Mitsuno_Hack_Success,
                                  $callbackparam = this,
                                  ]" />

          </actions>
        </cue>

      </cues>
    </cue>

    <!-- Terraformer Faction -->
    <library name="Setup_Faction_Terraformers" purpose="run_actions">
      <params>
        <param name="MissionFaction" default="faction.xenon"/>
      </params>
      <actions>
        <set_faction_identity faction="$MissionFaction" name="'{20203,3901}'" description="'{20203,3902}'" shortname="'{20203,3903}'" prefixname="'{20203,3904}'" spacename="'{20203,3905}'" homespacename="'{20203,3906}'" icon="'faction_terraformer'"/>
      </actions>
    </library>

