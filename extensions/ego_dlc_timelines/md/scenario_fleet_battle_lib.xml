    <library name="Setup_XenonTerraformerFleet" purpose="run_actions">
      <params>
        <param name="player"/>
        <param name="XenonLocation"/>
        <param name="PatrolDestination"/>
        <param name="PatrolPosition3"/>
      </params>
      <actions>
        <create_group groupname="$Terraformerfleet"/>
        <!-- Xenon H -->
        <create_ship groupname="$Terraformerfleet" name="$DroneCarrier" sector="$XenonLocation" macro="macro.ship_xen_l_terraformer_01_b_macro" capturable="false">
          <owner exact="if $player then faction.player else faction.xenon" overridenpc="true"/>
          <loadout>
            <quantity exact="1.0"     comment="all slots filled">
              <variation exact="0.0"  comment="all slots filled"/>
            </quantity>
            <quality exact="1.0">
              <variation exact="0.0"  comment="no variation"/>
            </quality>
          </loadout>
          <pilot>
            <select faction="faction.xenon" tags="tag.aipilot"/>
          </pilot>
          <safepos space="$XenonLocation" x="165000" y="0" z="-95000"/>
          <rotation yaw="250deg"/>
        </create_ship>
        <do_if value="$player">
          <create_order id="'Wait'" object="$DroneCarrier" default="true"/>
        </do_if>
        <do_else>
          <create_order id="'ProtectPosition'" object="$DroneCarrier" default="true">
            <param name="destination" value="[$PatrolDestination, $PatrolPosition3]"/>
          </create_order>
        </do_else>
        
        <!--corvete-->
        <do_all exact="5">
          <create_ship groupname="$Terraformerfleet" name="$interceptor" sector="$XenonLocation" macro="macro.ship_xen_m_corvette_01_b_macro" capturable="false">
            <owner exact="if $player then faction.player else faction.xenon" overridenpc="true"/>
            <loadout>
              <quantity exact="1.0"     comment="all slots filled">
                <variation exact="0.0"  comment="all slots filled"/>
              </quantity>
              <quality exact="1.0">
                <variation exact="0.0"  comment="no variation"/>
              </quality>
            </loadout>
            <pilot>
              <select faction="faction.xenon" tags="tag.aipilot"/>
            </pilot>
            <safepos object="$DroneCarrier" max="5km"/>
            <rotation value="$DroneCarrier.rotation"/>
          </create_ship>
          <set_object_commander object="$interceptor" commander="$DroneCarrier" assignment="assignment.interception"/>
          <do_all exact="2">
            <create_ship groupname="$Terraformerfleet" name="$wingman" sector="$XenonLocation" macro="macro.ship_xen_s_heavyfighter_01_b_macro" capturable="false">
              <owner exact="if $player then faction.player else faction.xenon" overridenpc="true"/>
              <loadout>
                <quantity exact="1.0"     comment="all slots filled">
                  <variation exact="0.0"  comment="all slots filled"/>
                </quantity>
                <quality exact="1.0">
                  <variation exact="0.0"  comment="no variation"/>
                </quality>
              </loadout>
              <pilot>
                <select faction="faction.xenon" tags="tag.aipilot"/>
              </pilot>
              <safepos object="$interceptor" max="3km"/>
              <rotation value="$DroneCarrier.rotation"/>
            </create_ship>
            <set_object_commander object="$wingman" commander="$interceptor" assignment="assignment.attack"/>
          </do_all>
        </do_all>

        <!--scouts-->
        <do_all exact="10">
          <create_ship groupname="$Terraformerfleet" name="$scout" sector="$XenonLocation" macro="macro.ship_xen_s_heavyfighter_01_b_macro" capturable="false">
            <owner exact="if $player then faction.player else faction.xenon" overridenpc="true"/>
            <loadout>
              <quantity exact="1.0"     comment="all slots filled">
                <variation exact="0.0"  comment="all slots filled"/>
              </quantity>
              <quality exact="1.0">
                <variation exact="0.0"  comment="no variation"/>
              </quality>
            </loadout>
            <pilot>
              <select faction="faction.xenon" tags="tag.aipilot"/>
            </pilot>
            <safepos space="$XenonLocation" x="-25000" y="0" z="-72000" min="1km" max="5km"/>
            <rotation value="$DroneCarrier.rotation"/>
          </create_ship>
          <do_if value="$player">
            <create_order id="'Wait'" object="$scout" default="true"/>
          </do_if>
          <do_else>
            <create_order id="'Patrol'" object="$scout" default="true">
              <param name="space" value="$PatrolDestination"/>
            </create_order>
          </do_else>
