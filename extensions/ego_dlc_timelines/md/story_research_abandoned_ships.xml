                <add_inventory entity="player.entity" ware="ware.paintmod_0161" exact="5" />
                <set_value name="$ShipClaimed" exact="1"/>
                <set_value name="Start.$AnyShipClaimed" operation="add" exact="1"/>
              </actions>
              <patch sinceversion="2">
                <do_if value="Odachi_Claimed.state == cuestate.complete and ware.research_ship_ter_m_corvette_01.research.unlocked">
                  <add_blueprints wares="[ware.shield_ter_m_virtual_01_mk2, ware.shield_ter_m_virtual_01_mk3]"/>
                </do_if>
              </patch>
              <cues>
                <cue name="Odachi_Reasearch" ref="Research_Unlock">
                  <param name="ShipClaimed" value="$ShipClaimed"/>
                  <param name="ResearchItem" value="'research_ship_ter_m_corvette_01'"/>
                  <param name="ResearchWare" value="ware.research_ship_ter_m_corvette_01"/>
                  <param name="Blueprints" value="[ware.ship_ter_m_corvette_02_a,
                                                   ware.shield_ter_m_virtual_01_mk1,
                                                   ware.shield_ter_m_virtual_01_mk2,
                                                   ware.shield_ter_m_virtual_01_mk3,
                                                   ware.engine_ter_m_virtual_01_mk1,
                                                   ware.weapon_ter_m_laser_02_mk1,
                                                   ware.turret_ter_m_laser_03_mk1]"/>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

        <cue name="Sapporo_Setup" namespace="this" version="2">
          <conditions>
            <check_any>
              <event_cue_signalled cue="md.Setup.Start"/>
              <event_cue_completed cue="Gamestarted"/>
            </check_any>
            <check_any>
              <check_value value="@userdata.scenario_dragonfyre_best_rating" min="1"/>
              <check_value value="gamestart.storystate.story_timelines_quettanaut"/>
              <check_value value="gamestart.storystate.story_timelines_grandmother"/>
            </check_any>
          </conditions>
          <actions>
            <set_value name="$ShipClaimed" exact="0"/>
            <set_value name="$LastResearchDescriptionTime" exact="0"/>
            <get_safe_pos sector="Start.$MistsOfArtemis" x="-75797m" y="1571m" z="-178854m" result="$Position"/>
            <run_actions ref="Create_Abandoned_Ship" result="$Sapporo">
              <param name="Cue" value="namespace"/>
              <param name="Macro" value="macro.ship_ter_l_flagship_01_a_macro"/>
              <param name="Sector" value="Start.$MistsOfArtemis"/>
              <param name="CustomLoadout" value="'timelines_sandbox_ter_l'"/>
              <param name="Paintmod" value="ware.paintmod_0184"/>
              <param name="Position" value="$Position"/>
              <param name="DebugChance" value="Start.$DebugChance"/>
            </run_actions>
            <add_to_group groupname="global.$IgnoredAbandonedShips" object="$Sapporo" comment="prevent i.e. Yaki from claiming the ship"/>
          </actions>
          <patch sinceversion="2">
            <get_loadout result="$SapporoLoadout" macro="macro.ship_ter_l_flagship_01_a_macro" loadout="'timelines_sandbox_ter_l'"/>
            <apply_loadout object="$Sapporo" loadout="$SapporoLoadout"/>
            <do_for_each in="$Sapporo.weapons.all.list" name="$Weapon">
              <do_if value="$Weapon.macro == macro.weapon_ter_l_flagship_01_mk1_macro">
                <remove_weapon_from_weapongroup weapon="$Weapon" weapongroup="0" primary="true"/>
                <add_weapon_to_weapongroup weapon="$Weapon" weapongroup="0" primary="false"/>
              </do_if>
            </do_for_each>
          </patch>
          <cues>
            <cue name="Sapporo_Aproach">
              <conditions>
                <event_object_entered_live_view object="$Sapporo"/>
              </conditions>
              <actions>
                <create_ship name="$KhaakRavager" macro="macro.ship_kha_l_destroyer_01_a_macro" sector="Start.$MistsOfArtemis">
                  <owner exact="faction.khaak"/>
                  <pilot>
                    <select faction="faction.khaak" tags="tag.aipilot"/>
                  </pilot>
                  <drop ref="ship_large_khaak"/>
                  <safepos object="$Sapporo" max="5km"/>
                </create_ship>
                <create_order id="'ProtectPosition'" object="$KhaakRavager" default="true">
                  <param name="destination" value="[Start.$MistsOfArtemis, $Sapporo.position]"/>
                </create_order>
              </actions>
            </cue>
            <cue name="Sapporo_Claimed" version="6">
              <conditions>
                <event_object_changed_owner object="$Sapporo" owner="faction.player"/>
              </conditions>
              <actions>
                <substitute_text text="$EmailText" source="{30005,14210}">
                  <replace string="'$RESEARCH$'" with="$Sapporo.name"/>
                </substitute_text>
                <write_incoming_message title="{30005,14200}" text="$EmailText" source="{30301,101}" highpriority="true"/>
                <run_actions ref="md.LIB_Generic.RequestObjectVulnerability">
                  <param name="Object" value="$Sapporo"/>
                  <param name="RequesterCue" value="namespace"/>
                  <param name="DebugChance" value="Start.$DebugChance"/>
                </run_actions>
                <add_inventory entity="player.entity" ware="ware.paintmod_0184" exact="5" />
                <set_value name="$ShipClaimed" exact="1"/>
                <set_value name="Start.$AnyShipClaimed" operation="add" exact="1"/>
              </actions>
              <patch sinceversion="2">
                <do_if value="Sapporo_Reasearch.state == cuestate.complete and ware.research_ship_ter_l_flagship_01.research.unlocked">
                  <add_blueprints wares="[ware.weapon_ter_l_flagship_01_mk1, ware.missile_flagship_heavy_mk1]"/>
                </do_if>
              </patch>
              <patch sinceversion="3">
                <do_if value="Sapporo_Reasearch.state == cuestate.complete and ware.research_ship_ter_l_flagship_01.research.unlocked">
                  <add_blueprints wares="[ware.missile_flagship_light_mk1]"/>
                </do_if>
              </patch>
              <patch sinceversion="4">
                <get_loadout result="$SapporoLoadout" macro="macro.ship_ter_l_flagship_01_a_macro" loadout="'timelines_sandbox_ter_l'"/>
                <apply_loadout object="$Sapporo" loadout="$SapporoLoadout"/>
                <do_for_each in="$Sapporo.weapons.all.list" name="$Weapon">
                  <do_if value="$Weapon.macro == macro.weapon_ter_l_flagship_01_mk1_macro">
                    <remove_weapon_from_weapongroup weapon="$Weapon" weapongroup="0" primary="true"/>
                    <add_weapon_to_weapongroup weapon="$Weapon" weapongroup="0" primary="false"/>
                  </do_if>
                </do_for_each>
              </patch>
              <patch sinceversion="5">
                <do_if value="Sapporo_Claimed.state == cuestate.complete and ware.research_ship_ter_l_flagship_01.research.unlocked">
                  <add_blueprints wares="[ware.weapon_ter_l_flagship_01_mk1, ware.missile_flagship_heavy_mk1, ware.missile_flagship_light_mk1]"/>
                </do_if>
              </patch>
              <patch sinceversion="6">
                <do_if value="Sapporo_Claimed.state == cuestate.complete">
                  <set_value name="Sapporo_Reasearch.$Blueprints" exact="[ware.ship_ter_l_flagship_01_a,
                                                                          ware.shield_ter_l_standard_02_mk1,
                                                                          ware.shield_ter_l_standard_02_mk2,
                                                                          ware.shield_ter_l_standard_02_mk3,
                                                                          ware.shield_ter_m_standard_04_mk1,
                                                                          ware.shield_ter_m_standard_04_mk2,
                                                                          ware.shield_ter_m_standard_04_mk3,
                                                                          ware.engine_ter_l_allround_02_mk1,
                                                                          ware.turret_ter_m_laser_04_mk1,
                                                                          ware.weapon_ter_l_flagship_01_mk1,
                                                                          ware.missile_flagship_heavy_mk1,
                                                                          ware.missile_flagship_light_mk1]"/>
                </do_if>
              </patch>
              <cues>
                <cue name="Sapporo_Reasearch" ref="Research_Unlock">
                  <param name="ShipClaimed" value="$ShipClaimed"/>
                  <param name="ResearchItem" value="'research_ship_ter_l_flagship_01'"/>
                  <param name="ResearchWare" value="ware.research_ship_ter_l_flagship_01"/>
                  <param name="Blueprints" value="[ware.ship_ter_l_flagship_01_a,
                                                   ware.shield_ter_l_standard_02_mk1,
                                                   ware.shield_ter_l_standard_02_mk2,
                                                   ware.shield_ter_l_standard_02_mk3,
                                                   ware.shield_ter_m_standard_04_mk1,
                                                   ware.shield_ter_m_standard_04_mk2,
                                                   ware.shield_ter_m_standard_04_mk3,
                                                   ware.engine_ter_l_allround_02_mk1,
                                                   ware.turret_ter_m_laser_04_mk1,
                                                   ware.weapon_ter_l_flagship_01_mk1,
                                                   ware.missile_flagship_heavy_mk1,
                                                   ware.missile_flagship_light_mk1]"/>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

