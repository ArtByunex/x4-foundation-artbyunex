        <!-- Libraries -->
        <library name="Create_Abandoned_Ship" purpose="run_actions">
          <params>
            <param name="Cue"/>
            <param name="Macro"/>
            <param name="Sector"/>
            <param name="CustomLoadout" default="null"/>
            <param name="Loadout" default="null"/>
            <param name="Paintmod"/>
            <param name="Faction" default="null"/>
            <param name="Position"/>
            <param name="DebugChance"/>
          </params>
          <actions>
            <do_if value="$CustomLoadout == null">
              <create_ship name="$Ship" macro="$Macro" sector="$Sector">
                <owner exact="faction.ownerless"/>
                <loadout>
                  <level faction="$Faction" exact="$Loadout"/>
                </loadout>
                <paint ware="$Paintmod"/>
                <pilot actor="null" />
                <safepos value="$Position"/>
                <rotation yaw="[-90deg,90deg].randominrange" roll="[-8deg,8deg].randominrange" />
              </create_ship>
            </do_if>
            <do_else>
              <create_ship name="$Ship" macro="$Macro" sector="$Sector">
                <owner exact="faction.ownerless"/>
                <loadout ref="$CustomLoadout"/>
                <paint ware="$Paintmod"/>
                <pilot actor="null" />
                <safepos value="$Position"/>
                <rotation yaw="[-90deg,90deg].randominrange" roll="[-8deg,8deg].randominrange" />
              </create_ship>
            </do_else>
            <set_value name="$Hull" min="33" max="66"/>
            <set_object_hull object="$Ship" exact="$Hull"/>
            <run_actions ref="md.LIB_Generic.RequestObjectInvincibility">
              <param name="Object" value="$Ship"/>
              <param name="RequesterCue" value="$Cue"/>
              <param name="MinHull" value="$Hull"/>
              <param name="AllowCapturable" value="true"/>
              <param name="DebugChance" value="$DebugChance"/>
            </run_actions>
            <return value="$Ship"/>
          </actions>
        </library>

        <library name="Research_Unlock">
          <params>
            <param name="ShipClaimed"/>
            <param name="ResearchItem"/>
            <param name="ResearchWare"/>
            <param name="Blueprints"/>
          </params>
          <cues>
            <cue name="Check_Research_Unlocked" onfail="cancel">
              <conditions>
                <cue_is_complete cue="md.X4Ep1_Mentor_Subscriptions.UnlockResearch"/>
              </conditions>
            </cue>

            <cue name="Research_Unlocked">
              <conditions>
                <check_any>
                  <event_cue_completed cue="md.X4Ep1_Mentor_Subscriptions.UnlockResearch"/>
                  <event_cue_completed cue="Check_Research_Unlocked"/>
                </check_any>
              </conditions>
              <!--Delay to allow any further initialisation of the HQ and mentors-->
              <delay exact="1s"/>
              <actions>
                <set_value name="$CharacterCutsceneTable" exact="table[]"/>
                <do_if value="md.X4Ep1_Mentor_Subscriptions.Start.$BoronMet?" comment="only if we already met with Boso">
                  <do_if value="not $Boso?">
                    <set_value name="$Boso" exact="@md.$PersistentCharacters.$BosoTa"/>
                    <do_if value="$Boso">
                      <set_value name="$CharacterCutsceneTable.{$Boso}" exact="table[$key = 'ShowCharacterBoron']"/>
                    </do_if>
                  </do_if>
                </do_if>
              </actions>
              <cues>
                <cue name="Research_Unlocked_Wait">
                  <conditions>
                    <event_cue_completed cue="Research_Unlocked"/>
                  </conditions>
                  <cues>
                    <cue name="Unhide_Research" checkinterval="1min">
                      <conditions>
                        <check_value value="$ShipClaimed ge 1"/>
                      </conditions>
                      <actions>
                        <add_encyclopedia_entry type="researchables" item="$ResearchItem"/>
                        <set_value name="$LastResearchDescriptionTime" exact="player.age"/>
                      </actions>
                    </cue>

                    <cue name="Research_Entry_Selected" instantiate="true">
                      <conditions>
                        <event_object_signalled object="player.entity" param="'research_selected_no_speak'"/>
                        <check_value value="player.age gt $LastResearchDescriptionTime + 30s"/>
                        <check_any>
                          <check_value value="event.param2 == $ResearchWare"/>
                        </check_any>
                      </conditions>
                      <actions>
                        <set_value name="$LastResearchDescriptionTime" exact="player.age"/>
                        <speak actor="$Boso" line="30201162" priority="85" recipient="player.entity" comment="{10201,30201162}"/>
                      </actions>
                    </cue>

                    <cue name="Research_Finished" instantiate="true">
                      <conditions>
                        <event_player_research_unlocked ware="$ResearchWare"/>
                      </conditions>
                      <actions>
                        <set_value name="this.$Dialog_Lines" exact="[[30201174]]" comment="{10201,30201174}"/>
                        <add_blueprints wares="$Blueprints"/>
                      </actions>
                      <cues>
                        <cue name="Research_Finished_LastMentorSpeak" checkinterval="10s">
                          <conditions>
                            <check_value value="player.age ge (md.$LastMentorSpeak + 10min)"/>
                          </conditions>
                          <cues>
                            <cue name="Research_Finished_Speak_Ref_v2" ref="md.LIB_Dialog.Speak_Actor">
                              <param name="Actor"             value="$Boso"/>
                              <param name="CutsceneKey"       value="$CharacterCutsceneTable.{$Boso}"/>
                              <param name="DelayInitial"      value="2s"/>
                              <param name="Lines"             value="parent.parent.$Dialog_Lines"/>
                              <param name="IsInMission"       value="false"/>
                            </cue>
                          </cues>
                        </cue>
                      </cues>
                    </cue>
                  </cues>
                </cue>
              </cues>
            </cue>
          </cues>
        </library>
      </cues>
    </cue>
  </cues>
</mdscript>
