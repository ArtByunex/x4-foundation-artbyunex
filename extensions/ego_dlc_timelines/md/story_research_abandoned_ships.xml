<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Story_Research_Abandoned_Ships" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Start" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$DebugChance" exact="0"/>
        <set_value name="$AnyShipClaimed" exact="0"/>
        <!-- Notifications in md.Scenario_Hub - Reward_Notifications; If sectors here change also update in Reward_Notifications -->
        <find_sector name="$HereticsEnd"      macro="macro.cluster_31_sector001_macro"/>
        <find_sector name="$GetsuFune"        macro="macro.cluster_48_sector001_macro"/>
        <find_sector name="$MistsOfArtemis"   macro="macro.cluster_715_sector001_macro"/>
        <find_sector name="$FreedomsReach"    macro="macro.cluster_714_sector001_macro"/>
        <find_sector name="$MooKyesRevenge"   macro="macro.cluster_710_sector001_macro"/>
        <find_sector name="$NopileosFortune"  macro="macro.cluster_04_sector001_macro"/>
        <find_sector name="$TharkasCascadeXV" macro="macro.cluster_32_sector001_macro"/>
        <find_sector name="$AntigoneMemorial" macro="macro.cluster_28_sector001_macro"/>
        <find_sector name="$CEODoubt"         macro="macro.cluster_713_sector001_macro"/>
      </actions>
      <cues>
        <cue name="Gamestarted">
          <!-- Used to trigger cues below for new games -->
        </cue>

        <cue name="Cutlass_Setup" namespace="this">
          <conditions>
            <check_any>
              <event_cue_signalled cue="md.Setup.Start"/>
              <event_cue_completed cue="Gamestarted"/>
            </check_any>
            <check_any>
              <check_value value="@userdata.scenario_protect_object_best_rating" min="1"/>
              <check_value value="gamestart.storystate.story_timelines_quettanaut"/>
              <check_value value="gamestart.storystate.story_timelines_grandmother"/>
            </check_any>
          </conditions>
          <actions>
            <set_value name="$ShipClaimed" exact="0"/>
            <set_value name="$LastResearchDescriptionTime" exact="0"/>
            <get_safe_pos sector="Start.$HereticsEnd" x="-170000m" y="10000m" z="-280000m" result="$Position"/>
            <run_actions ref="Create_Abandoned_Ship" result="$Cutlass">
              <param name="Cue" value="namespace"/>
              <param name="Macro" value="macro.ship_ter_s_fighter_04_a_macro"/>
              <param name="Sector" value="Start.$HereticsEnd"/>
              <param name="Loadout" value="0.5"/>
              <param name="Paintmod" value="ware.paintmod_0130"/>
              <param name="Faction" value="faction.terran"/>
              <param name="Position" value="$Position"/>
              <param name="DebugChance" value="Start.$DebugChance"/>
            </run_actions>
            <add_to_group groupname="global.$IgnoredAbandonedShips" object="$Cutlass" comment="prevent i.e. Yaki from claiming the ship"/>
          </actions>
          <cues>
            <cue name="Cutlass_Claimed">
              <conditions>
                <event_object_changed_owner object="$Cutlass" owner="faction.player"/>
              </conditions>
              <actions>
                <substitute_text text="$EmailText" source="{30005,14210}">
                  <replace string="'$RESEARCH$'" with="$Cutlass.name"/>
                </substitute_text>
                <write_incoming_message title="{30005,14200}" text="$EmailText" source="{30301,101}" highpriority="true"/>
                <run_actions ref="md.LIB_Generic.RequestObjectVulnerability">
                  <param name="Object" value="$Cutlass"/>
                  <param name="RequesterCue" value="namespace"/>
                  <param name="DebugChance" value="Start.$DebugChance"/>
                </run_actions>
                <add_inventory entity="player.entity" ware="ware.paintmod_0130" exact="5" />
                <set_value name="$ShipClaimed" exact="1"/>
                <set_value name="Start.$AnyShipClaimed" operation="add" exact="1"/>
              </actions>
              <cues>
                <cue name="Cutlass_Reasearch" ref="Research_Unlock">
                  <param name="ShipClaimed" value="$ShipClaimed"/>
                  <param name="ResearchItem" value="'research_ship_ter_s_fighter_01'"/>
                  <param name="ResearchWare" value="ware.research_ship_ter_s_fighter_01"/>
                  <param name="Blueprints" value="[ware.ship_ter_s_fighter_04_a,
                                                   ware.shield_ter_s_virtual_01_mk1,
                                                   ware.engine_ter_s_virtual_01_mk1,
                                                   ware.weapon_ter_s_laser_02_mk1]"/>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>

        <cue name="Odachi_Setup" namespace="this">
          <conditions>
            <check_any>
              <event_cue_signalled cue="md.Setup.Start"/>
              <event_cue_completed cue="Gamestarted"/>
            </check_any>
            <check_any>
              <check_value value="@userdata.scenario_dragonfyre_best_rating" min="1"/>
              <check_value value="gamestart.storystate.story_timelines_quettanaut"/>
              <check_value value="gamestart.storystate.story_timelines_grandmother"/>
            </check_any>
          </conditions>
          <actions>
            <set_value name="$ShipClaimed" exact="0"/>
            <set_value name="$LastResearchDescriptionTime" exact="0"/>
            <get_safe_pos sector="Start.$GetsuFune" x="60000m" y="-32000m" z="275000m" result="$Position"/>
            <run_actions ref="Create_Abandoned_Ship" result="$Odachi">
              <param name="Cue" value="namespace"/>
              <param name="Macro" value="macro.ship_ter_m_corvette_02_a_macro"/>
              <param name="Sector" value="Start.$GetsuFune"/>
              <param name="Loadout" value="0.7"/>
              <param name="Paintmod" value="ware.paintmod_0161"/>
              <param name="Faction" value="faction.terran"/>
              <param name="Position" value="$Position"/>
              <param name="DebugChance" value="Start.$DebugChance"/>
            </run_actions>
            <add_to_group groupname="global.$IgnoredAbandonedShips" object="$Odachi" comment="prevent i.e. Yaki from claiming the ship"/>
          </actions>
          <cues>
            <cue name="Odachi_Claimed" version="2">
              <conditions>
                <event_object_changed_owner object="$Odachi" owner="faction.player"/>
              </conditions>
              <actions>
                <substitute_text text="$EmailText" source="{30005,14210}">
                  <replace string="'$RESEARCH$'" with="$Odachi.name"/>
                </substitute_text>
                <write_incoming_message title="{30005,14200}" text="$EmailText" source="{30301,101}" highpriority="true"/>
                <run_actions ref="md.LIB_Generic.RequestObjectVulnerability">
                  <param name="Object" value="$Odachi"/>
                  <param name="RequesterCue" value="namespace"/>
                  <param name="DebugChance" value="Start.$DebugChance"/>
