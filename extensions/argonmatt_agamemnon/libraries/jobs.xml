<?xml version="1.0" encoding="utf-8"?>

<diff>
 	<add sel="//jobs">
		
		<!-- GODREALM OF THE PARANID-->
		<!-- Add PAR Agamemnon patrol job-->
		<job id="paranid_argonmattagamemnon_xl_sector_exp" name="{999830,3}" comment="each sector, expansion">
			<modifiers commandeerable="true"/>
			<orders>
				<order order="Patrol" default="true">
					<param name="range" value="class.sector"/>
				</order>
			</orders>
			<category faction="paranid" tags="[factionlogic, military, battleship]" size="ship_xl"/>
			<quota galaxy="3" sector="1"/>
			 <location class="galaxy" macro="xu_ep2_universe_macro" faction="paranid" relation="self" comparison="exact" matchextension="false"/>
			<environment buildatshipyard="true"/>
			<ship>
				<select faction="paranid" tags="[battleship]" size="ship_xl"/>
				<loadout>
					<level exact="1"/>
				</loadout>
				<owner exact="paranid" overridenpc="true"/>
			</ship>
			<subordinates>
				<subordinate job="paranid_frigate_escort_m"/>
			</subordinates>
		  </job>
	</add>
		<!-- HOLY ORDER OF THE PONTIFEX-->
		<!-- Add HOP Agamemnon patrol job-->
	<add sel="//jobs">
		<job id="holyorder_argonmattagamemnon_xl_sector_exp" name="{999830,4}" comment="each sector, expansion">
