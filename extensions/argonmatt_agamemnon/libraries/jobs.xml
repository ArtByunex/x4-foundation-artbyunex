				<owner exact="holyorder" overridenpc="true"/>
			</ship>
			<subordinates>
				<subordinate job="holyorder_frigate_escort_m"/>
			</subordinates>
		  </job>
	</add>

		<!-- TRINITY -->
		<!-- Add Trinity Agamemnon patrol job-->

<!-- This job does not start active. It is enabled when the Godrealm and the Holy Order are united into the Trinity. 
Check the MD file for the relevant paranid story event for the deactivation of the old jobs and the activation of the TRI job -->

