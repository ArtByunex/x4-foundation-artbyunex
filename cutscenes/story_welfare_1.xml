<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- Welfare race cutscene 1 -->
  <director key="Story_welfare_1">
    <params>
      <!--Casino room-->
      <param name="room" object="true"/>
      <!--Race ship-->
      <param name="ship" object="true" />

      <!--Room shot positions-->
      <!--<param name="room_x" number="true"/>
      <param name="room_y" number="true"/>
      <param name="room_z" number="true"/>

      <param name="room_x2" number="true"/>
      <param name="room_y2" number="true"/>
      <param name="room_z2" number="true"/>-->

      <!--Camera position-->
      <param name="ship_x" number="true"/>
      <param name="ship_y" number="true"/>
      <param name="ship_z" number="true"/>

      <param name="ship_x2" number="true"/>
      <param name="ship_y2" number="true"/>
      <param name="ship_z2" number="true"/>
    </params>
  </director>

  <!-- Environment in which the scene will take place. -->
  <environments>
    <environment_implicit name="roomscene" zone="@auto:room" />
    <environment_implicit name="shipscene" zone="@auto:ship" />
  </environments>

  <presentation>
    <actions>
      <sequence name="CrewmanChatSequence" start="0">
        <shot name="CrewmanChat" environment="roomscene" duration="onevent:DrekChatEnd">
          <camera>
            <position>
              <keyframes>
                <keyframe timestamp="0" interpolation="linear">
                  <value exact="-4.8"/>
                  <value exact="2.7"/>
                  <value exact="-6.9"/>
                </keyframe>
                <keyframe timestamp="17000" interpolation="linear">
                  <value exact="-5.9"/>
                  <value exact="2.4"/>
                  <value exact="-5.9"/>
                </keyframe>
              </keyframes>
            </position>
            <lookdirection>
              <keyframes>
                <keyframe timestamp="0" interpolation="linear">
                  <angles>
                    <yaw>
                      <value exact="0"/>
                    </yaw>
                    <pitch>
                      <value exact="-100"/>
                    </pitch>
                  </angles>
                </keyframe>
                <keyframe timestamp="17000" interpolation="linear">
                  <angles>
                    <yaw>
                      <value exact="5"/>
                    </yaw>
                    <pitch>
                      <value exact="5"/>
                    </pitch>
                  </angles>
                </keyframe>
              </keyframes>
            </lookdirection>
          </camera>
        </shot>
      </sequence>

      <sequence name="FindShip" start="onevent:ShipShot1">
        <shot name="FindShipShot" environment="shipscene" duration="onevent:ShipShot1End">
          <camera>
            <position>
              <keyframes>
                <keyframe timestamp="0" interpolation="linear">
                  <value var="ship_x2" comment="Ship zone X coordinate" />
                  <value var="ship_y2" comment="Ship zone Y coordinate" />
                  <value var="ship_z2" comment="Ship zone Z coordinate" />
                </keyframe>
                <keyframe timestamp="20000" interpolation="linear">
                  <value var="ship_x" comment="Ship zone X coordinate" />
                  <value var="ship_y" comment="Ship zone Y coordinate" />
                  <value var="ship_z" comment="Ship zone Z coordinate" />
                </keyframe>
              </keyframes>
            </position>
            <panloop yaw="0.02" pitch="0.03" roll="0.01" time="26"/>
            <lookdirection>
              <keyframes>
                <keyframe timestamp="0" interpolation="linear">
                  <angles>
                    <yaw>
                      <value exact="30"/>
                    </yaw>
                    <pitch>
                      <value exact="5"/>
                    </pitch>
                  </angles>
                </keyframe>
                <keyframe timestamp="5000" interpolation="linear">
                  <angles>
                    <yaw>
                      <value exact="35"/>
                    </yaw>
                    <pitch>
                      <value exact="5"/>
                    </pitch>
                  </angles>
                </keyframe>
                <keyframe timestamp="10000" interpolation="linear">
                  <angles>
                    <yaw>
                      <value exact="20"/>
                    </yaw>
                    <pitch>
                      <value exact="3"/>
                    </pitch>
                  </angles>
                </keyframe>
                <keyframe timestamp="17000" interpolation="linear">
                  <angles>
                    <yaw>
                      <value exact="20"/>
                    </yaw>
                    <pitch>
                      <value exact="3"/>
                    </pitch>
                  </angles>
                </keyframe>
                <keyframe timestamp="22000" interpolation="linear">
                  <angles>
                    <yaw>
                      <value exact="30"/>
                    </yaw>
                    <pitch>
                      <value exact="5"/>
                    </pitch>
                  </angles>
                </keyframe>
              </keyframes>
            </lookdirection>
            <zoom>
              <keyframes>
                <keyframe timestamp="0" interpolation="smooth">
                  <value exact="90.0"/>
                </keyframe>
                <keyframe timestamp="3500" interpolation="linear">
                  <value exact="70.0"/>
                </keyframe>
                <keyframe timestamp="8000" interpolation="linear">
                  <value exact="60.0"/>
                </keyframe>
                <keyframe timestamp="9500" interpolation="linear">
                  <value exact="70.0"/>
                </keyframe>
                <keyframe timestamp="10000" interpolation="linear">
                  <value exact="50.0"/>
                </keyframe>
                <keyframe timestamp="15000" interpolation="linear">
                  <value exact="45.0"/>
                </keyframe>
                <keyframe timestamp="20000" interpolation="linear">
                  <value exact="55.0"/>
                </keyframe>
              </keyframes>
            </zoom>
          </camera>
        </shot>
      </sequence>
      
      <sequence name="LookAtShip" start="onevent:ShipShot2">
        <shot name="LookAtShipShot" environment="shipscene" duration="onevent:ShipShot2END">
          <camera>
            <position>
              <keyframes>
                <keyframe timestamp="0" interpolation="linear">
                  <value var="ship_x" comment="Ship zone X coordinate" />
                  <value var="ship_y" comment="Ship zone Y coordinate" />
                  <value var="ship_z" comment="Ship zone Z coordinate" />
                </keyframe>
                <keyframe timestamp="16000" interpolation="linear">
                  <value var="ship_x2" comment="Ship zone X coordinate" />
                  <value var="ship_y2" comment="Ship zone Y coordinate" />
                  <value var="ship_z2" comment="Ship zone Z coordinate" />
                </keyframe>
              </keyframes>
            </position>
            <panloop pitch="0.01" roll="0.01" time="26"/>
            <lookdirection>
              <reference x="5" y="0" z="15" object="ship"/>
            </lookdirection>
            <zoom>
              <keyframes>
                <keyframe timestamp="0" interpolation="smooth">
                  <value exact="60.0"/>
                </keyframe>
                <keyframe timestamp="2000" interpolation="linear">
                  <value exact="80.0"/>
                </keyframe>
                <keyframe timestamp="3500" interpolation="linear">
                  <value exact="90.0"/>
                </keyframe>
                <keyframe timestamp="8000" interpolation="linear">
                  <value exact="70.0"/>
                </keyframe>
                <keyframe timestamp="9500" interpolation="linear">
                  <value exact="50.0"/>
                </keyframe>
              </keyframes>
            </zoom>
          </camera>
        </shot>
      </sequence>

    </actions>
  </presentation>

</cutscene>
