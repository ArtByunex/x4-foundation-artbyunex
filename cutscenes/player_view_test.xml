<?xml version="1.0" encoding="utf-8"?>

<!--
	staticshot.xml
	Cutscene by Owen
  -->

<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- This is the key name used to load and reference the scene. -->
  <director key="PlayerViewTestCutscene">
    <params>
      <param name="object" object="true" />
    </params>
  </director>

  <!-- The environment is automatically deduced from the reference object. -->
  <environments>
    <environment_implicit name="scenezone" zone="@auto:object" />
  </environments>

  <!-- The scene consists of a single sequence of a single shot. -->
  <presentation>
    <actions>
      <sequence name="PlayerViewTestCutsceneSequence" start="0">
        <!-- Note that we rely on an event to tell us when to stop playing the scene;
					 the actual scene duration is controlled by code logic, not manually. -->
        <shot name="PlayerViewTestCutsceneShot" environment="scenezone" duration="onevent:stopscene">
          <camera>
            <position>
              <reference object="object" z="0"/>
            </position>
            <lookdirection>
              <reference object="object" z="10"/>
            </lookdirection>
            <zoom>
              <value var="zoom"/>
            </zoom>
          </camera>
        </shot>
      </sequence>
    </actions>
  </presentation>

</cutscene>

