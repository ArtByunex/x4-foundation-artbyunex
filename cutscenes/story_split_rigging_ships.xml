<?xml version="1.0" encoding="utf-8"?>

<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- This is the key name used to load and reference the scene. -->
  <director key="story_split_rigging_ships">
    <params>
      <param name="targetship" object="true" />
      <param name="targetobject" object="true" />
      <param name="orbitdist" number="true" />
      <param name="orbitelevation" number="true" />
    </params>
  </director>

  <!-- The environment is automatically deduced from the reference object. -->
  <environments>
    <environment_implicit name="scenezone" zone="@auto:targetobject" />
    <environment_implicit name="shipzone" zone="@auto:targetship"/>
  </environments>

  <!-- The scene consists of a single sequence of two shots. -->
  <presentation>
    <actions>
      <sequence name="OrbitSequence" start="0">
        <!-- Note that we rely on an event to tell us when to stop playing the scene;
					 the actual scene duration is controlled by code logic, not manually. -->
        
        <!-- Show size of fleet in overview-->
        <shot name="FleetAfar" environment="shipzone" duration="6000">
          <camera_orbit reference="targetship" orient_to="ecliptic" cycle="none">
            <begin distance="14000" angle="10" elevation="400"/>
            <end distance="10000" angle="20" elevation="600" time="6000"/>
          </camera_orbit>
        </shot>

        <shot name="OrbitShot" environment="scenezone" duration="14000">
           <!--Do a little pan/zoom effect to zero in on the object, makes it look a bit cooler.--> 
          <camera_orbit reference="targetobject" orient_to="ecliptic" cycle="none" startangle="0" stopangle="360">
            <begin angle="45">
              <distance>
                <value var="orbitdist"/>
              </distance>
              <elevation>
                <value var="orbitelevation"/>
              </elevation>
            </begin>
            <end angle="225" time="36000">
              <distance>
                <value var="orbitdist/2"/>
              </distance>
              <elevation>
                <value var="600"/>
              </elevation>
            </end>
          </camera_orbit>
        </shot>

      </sequence>
    </actions>
  </presentation>

</cutscene>



