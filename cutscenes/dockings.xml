<?xml version="1.0" encoding="utf-8"?>

<!--

	DockingS.xml
	Cutscene by Owen
	   
	Docking cutscene for S sized ships landing on platforms.
  Takes place during the final autopilot maneuver
	   
	Params:
  - ship: the docking ship
  - dockobject: the dockingbay

  -->

<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- This is the key name used to load and reference the scene. -->
  <director key="DockingSCutscene" />

  <!-- The environment is automatically deduced from the reference object. -->
  <environments>
    <environment_implicit name="scenezone" zone="@auto:dockobject" />
  </environments>

  <!-- The scene consists of a single sequence of a single shot. -->
  <presentation>
    <actions>
      <sequence name="DockingSequence" start="0">
        <!--TODO: Use an event instead of time-->
        <shot name="DockingShot" environment="scenezone" duration="3000">
          <camera_lookat position_reference="dockobject" lookat_reference="ship" orient_to="ecliptic">
            <begin pitch="13" yaw="345" distance="25"/>
            <end pitch="13" yaw="345" distance="25"/>
          </camera_lookat>
        </shot>
      </sequence>
    </actions>
  </presentation>

</cutscene>

