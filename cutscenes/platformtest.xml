<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <director key="platformtest" />

  <environments>
    <environment_implicit name="scenezone" zone="@auto:npc" />
    <object_group name="testgroup">
      <reference object="npc" />
    </object_group>
  </environments>

  <presentation>
    <actions>

      <sequence name="DynamicSequence" start="0">
      
        <shot name="ShowFreighter" environment="scenezone" duration="10000">
          <camera_orbit reference="npc" orient_to="object" interpolation="smooth">
            <begin angle="200" distance="50%" elevation="20"   />
            <end angle="300" distance="300%" elevation="70" time="15000"/>
          </camera_orbit>
        </shot>

      </sequence>
    </actions>
  </presentation>

</cutscene>

