<?xml version="1.0" encoding="utf-8"?>

<!--

  Meet the Mentor at HQ Cutscene
  -->

<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- This is the key name used to load and reference the scene. -->
  <director key="Story_Mentor_Intro">
    <params>
      <param name="BosoTa" object="true"/>
    </params>
  </director>

  <!-- The environment is automatically deduced from the reference object. -->
  <environments>
    <environment_implicit name="scene" zone="@auto:BosoTa" />
  </environments>

  <!-- The scene consists of a single sequence of a single shot. -->
  <presentation>
    <actions>
      <!--first sequence starts at 0 - ends on event-->
      <sequence name="BoronTankSequence" start="0">
        <shot name="BoronTankShot" environment="scene" duration="9000">
          <camera_orbit reference="BosoTa" x="0.5" y="-1.0" z="0" orient_to="object" cycle="repeat" startangle="0" stopangle="360">
            <begin angle="340" distance="4.3" elevation="-0.2">
            </begin>
            <end angle="160" distance="4.9" elevation="0.5" time="9000"/>
          </camera_orbit>
        </shot>
      </sequence>

    </actions>
  </presentation>

</cutscene>

