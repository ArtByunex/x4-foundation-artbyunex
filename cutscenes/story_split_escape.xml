<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">

  <!-- Split gate cutscene -->
  <director key="Story_Split_Escape" />

  <!-- Environment in which the scene will take place. -->
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_station" />
    <object_group name="target_group">
      <reference object="target_station" comment="prison-station" />
      <reference object="target_ship" comment="outcast ship" />
    </object_group>
  </environments>

  <presentation>
    <actions>

      <sequence name="PresetDemoSequence" start="0">

        <shot name="OrbitOnStation" environment="scenezone" duration="15000">
          <camera_orbit reference="target_station" orient_to="object">
            <begin angle="25" distance="6000" elevation="70" />
            <end angle="100" distance="2000" elevation="20" />
          </camera_orbit>
        </shot>

        <!--shot name="MoveToShip" environment="scenezone" duration="5000">
          <takeover_position duration="5000" interpolation="smooth"/>
          <camera_flyto orient_to="ecliptic"  distance="200" fillspace="80" reference="@target_ship" time="5000" />
        </shot-->

      </sequence>

    </actions>
  </presentation>

</cutscene>
