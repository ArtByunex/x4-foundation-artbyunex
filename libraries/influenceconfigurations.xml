<?xml version="1.0" encoding="utf-8"?>
<influencelistconfigurations xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="influenceconfigurations.xsd">
  <!--Other influences-->

  <influencelist id="emp_missile" name="{20230,2001}" description="{20230,2002}" icon="heavy_MAM_disruption">
    <influences classes="ship_xs ship_s ship_m">
      <influence type="disableboost">
        <profile type="continuous" duration="30" />
      </influence>
      <influence type="disabletravel">
        <profile type="continuous" duration="30" />
      </influence>
    </influences>
    <influences classes="ship_l ship_xl">
      <influence type="disableboost">
        <profile type="continuous" duration="18" />
      </influence>
      <influence type="disabletravel">
        <profile type="continuous" duration="18" />
      </influence>
    </influences>	
  </influencelist>

  <influencelist id="region_travel_disrupt" name="{20230,2005}" description="{20230,2006}" icon="light_drive_disruption">
    <influences classes="ship">
      <influence type="disabletravel">
        <profile type="continuous" duration="10" />
      </influence>
    </influences>
  </influencelist>

  <influencelist id="recharge_oxygen">
    <influences classes="spacesuit">
      <influence type="chargeoxygen">
        <profile type="continuous" startvalue="25" duration="1" />
      </influence>
    </influences>
  </influencelist>

  <influencelist id="damage_radiation_slow">
    <influences>
      <influence type="hullshielddamage">
        <profile type="continuous" startvalue="0.01" duration="1" />
      </influence>
    </influences>
  </influencelist>

  <influencelist id="test_speed">
    <influences classes="ship">
      <influence type="disableboost">
        <profile type="continuous" duration="5"/>
      </influence>
      <influence type="maxforwardspeed">
        <profile type="envelope" delay="3" sustainvalue="0.0" sustainduration="2"/>
      </influence>
      <influence type="maxreversespeed">
        <profile type="envelope" delay="3" sustainvalue="0.0" sustainduration="2"/>
      </influence>
    </influences>
  </influencelist>

  <influencelist id="test_accel">
    <influences classes="ship">
      <influence type="disableboost">
        <profile type="continuous" duration="8"/>
      </influence>
      <influence type="forwardacceleration">
        <profile type="envelope" sustainvalue="0.0" sustainduration="8"/>
      </influence>
      <influence type="reverseacceleration">
        <profile type="envelope" sustainvalue="0.0" sustainduration="8"/>
      </influence>
    </influences>
  </influencelist>

  <influencelist id="test_steering">
    <influences classes="ship">
      <!--<influence type="steeringacceleration">-->
      <influence type="maxsteeringspeed">
        <profile type="envelope" sustainvalue="0.0" sustainduration="5"/>
      </influence>
    </influences>
  </influencelist>

  <influencelist id="ion_disrupt_s" name="{20230,2017}" description="{20230,2018}" icon="ion_disruption">
    <influences classes="ship_xs ship_s ship_m">
      <influence type="disableboost">
        <profile type="continuous" duration="10"/>
      </influence>
      <influence type="disabletravel">
        <profile type="continuous" duration="10"/>
      </influence>
      <influence type="disableshooting">
        <profile type="continuous" duration="1"/>
      </influence>
      <influence type="steeringacceleration">
        <profile type="continuous" startvalue="0.8" duration="2"/>
      </influence>
    </influences>
  </influencelist>

  <influencelist id="ion_disrupt_m" name="{20230,2017}" description="{20230,2018}" icon="ion_disruption">
    <influences classes="ship_xs ship_s ship_m">
      <influence type="disableboost">
        <profile type="continuous" duration="14"/>
      </influence>
      <influence type="disabletravel">
        <profile type="continuous" duration="14"/>
      </influence>
      <influence type="disableshooting">
        <profile type="continuous" duration="1.5"/>
      </influence>
      <influence type="steeringacceleration">
        <profile type="continuous" startvalue="0.8" duration="4"/>
      </influence>
    </influences>
  </influencelist>

  <influencelist id="ion_disrupt_l" name="{20230,2021}" description="{20230,2022}" icon="heavy_ion_disruption">	
    <influences classes="ship">
      <influence type="disableboost">
        <profile type="continuous" duration="14"/>
      </influence>
      <influence type="disabletravel">
        <profile type="continuous" duration="14"/>
      </influence>
      <influence type="disableshooting">
        <profile type="continuous" duration="2.5"/>
      </influence>
      <influence type="steeringacceleration">
        <profile type="continuous" startvalue="0.7" duration="4"/>
      </influence>
    </influences>
  </influencelist>

  <influencelist id="weapon_disrupt_s" name="{20230,2019}" description="{20230,2020}" icon="light_targeting_disruption">
    <influences classes="ship_xs ship_s">
      <influence type="disableshooting">
        <profile type="continuous" duration="3"/>
      </influence>
    </influences>
    <influences classes="ship_m">
      <influence type="disableshooting">
        <profile type="continuous" duration="1"/>
      </influence>
    </influences>
  </influencelist>

  <influencelist id="engine_glow_fullthrottle">
    <influences>
      <influence type="engineglowfx">
        <profile type="envelope" sustainvalue="1" loop="true" />
      </influence>
    </influences>
  </influencelist>

  <influencelist id="engine_flame_fullthrottle">
    <influences>
      <influence type="engineflamefx">
        <profile type="envelope" sustainvalue="1" loop="true" />
      </influence>
    </influences>
  </influencelist>

